{
    "name": "sapplica/sentrifugo",
    "description": "Sentrifugo Open Source HRMS - Modernized Suite",
    "type": "project",
    "require": {
        "php": ">=7.4 <8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.8"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
