{
    "name": "sapplica/sentrifugo",
    "description": "Sentrifugo Open Source HRMS - Modernized Suite",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "doctrine/dbal": "^4.5"
    },
	"autoload": {
        "classmap": [
            "Zend/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.8"
    },
    "config": {
        "platform": {
            "php": "8.3.36"
        },
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
