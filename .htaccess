RewriteEngine On
RewriteBase /

# If the requested file or folder physically exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]

# Route all other requests cleanly through index.php
RewriteRule ^.*$ index.php [NC,L]

SetEnv APPLICATION_ENV "production"