		}
		$("#" + choosenElement).change(() => {
			if ($("#" + choosenElement).val() != '') {
				$("#" + choosenElement).parent().find('.add-coloum').show();

			} else {
				$("#" + choosenElement).parent().find('.add-coloum').hide();
			}
		})

		$("." + choosenElement).click(() => {
			let chosenData = $("#" + choosenElement).val();
			let cycleShiftData = $('#cycleshiftdata').html();
			
			let desc = $('#description').val();
			let isactive = $("#isactive").val();
			console.log('here')
			$('cycleshiftdata').html('');
			$("#" + choosenElement).parent().parent().find('#errors-' + choosenElement).remove();
			if (chosenData != '') {
			
