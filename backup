					try {
						
						cycleShiftData = JSON.parse(cycleShiftData);
						dayschedule[choosenElement] = chosenData;
						dayschedule['description'] = desc;
						dayschedule['isactive'] = isactive;
						dayschedule['cycleshiftdata'] = cycleShiftData;
						weekshcdule[chosenData] = dayschedule;
						$("textarea[name='cycleshiftdata']").val(JSON.stringify(weekshcdule));
						drawTable(weekshcdule, choosenElement)
						//createLink(weekshcdule)
					} catch (error) {
						
						$("#" + choosenElement).parent().parent().append("<span class='errors' id='errors-" + choosenElement + "'>Shift Cycle not Entered </span>");
