							$("#"+choosenElement).parent().parent().find("#errors-"+choosenElement).remove();
					}, 3000);
					}
				
				} else {
					$("#" + choosenElement).parent().parent().append("<span class='errors' id='errors-" + choosenElement + "'>Shift Cycle not Entered </span>");

				}

			} else {
