	function drawTable(weekschedule, choosenElement) {
		let tableOpen = '<table id="schtable" style="width: 100%; border: 1px black solid"></table>';
		let daysche;
		let daydata;
		let shiftcycle;
		let len = 0;
		$("#schedule").html('');
		$("#schedule").append(tableOpen);
		for (const day in weekschedule) {
			daysche = weekschedule[day];
			daydata = daysche[choosenElement];
			shiftcycle = daysche['cycleshiftdata'];
			
			$('#schtable').append("<tr id='" + daydata + "'></tr>");
			len = shiftcycle.length;
			$('#' + daydata).append("<th  rowspan='" + len + "'>" + daydata + "</th>");
			let clone = JSON.stringify(shiftcycle);
			clone = JSON.parse(clone);
			const shiftid = clone.shift()['shift_id'] ;
			var res = $.ajax({
					url:base_url+'/schedule/timetable/getshiftname',
					dataType:'json',
					data:'id='+shiftid,
					async:false
				}).responseJSON;
			$("#" + daydata).append("<td>" + res['name'] + "</td>")
			
			for (const cycle in clone) {
				var res = $.ajax({
					url:base_url+'/schedule/timetable/getshiftname',
					dataType:'json',
					data:'id='+clone[cycle]['shift_id'],
					async:false
				}).responseJSON;
				console.log(res)
				$("#schtable").ap
				pend("<tr id=" + daydata + "_" + clone[cycle]['shift_id'] + "></tr>");
				$("#" + daydata + "_" + clone[cycle]['shift_id']).append("<td>" +res['name'] + "</td>")
			}
		}
	}

	function createLink(res) {
		console.log(res)
        $("#editlink").html('');
        for (const key in res) {
        //    const element = res[key]
           
            $("#editlink").append("<div id=" + key + "><span class='add-coloum'>" +key + "</span><span><i class='fa fa-pencil'></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
           /*  $("#" + element['schedulecycle_id']).parent().find('.fa-pencil').click((e) => {
                displaydeptform('<?php echo BASE_URL . 'cycleshift/editpopup?id=' ?>' + element['schedulecycle_id'], 'Cycle Shift');
            }) */
        }
    }

	function removeSchedule(event) 
	{
        event.preventDefault();
        let res = localStorage.getItem('schedule');
        res = JSON.parse(res);
        const index = $(event.target).parent().parent().attr('id')

        res.splice(index, 1);

        if (res.length === 0) {
            localStorage.removeItem('schedule');
        } else {
            localStorage.setItem('schedule', JSON.stringify(res));
        }
        $("textarea[name=cycleshiftdata]").val(JSON.stringify(res));
        $(event.target).parent().parent().remove();
    }

</script>