<?php
/**
 * Currency Index View
 * 
 * Displays the grid list of Currencies.
 * Strictly adheres to SSOT v6.1: No manual headers or add buttons. Relies 
 * entirely on Sentrifugo's global grid helper. Protected against PHP 8+ crashes.
 * 
 * @category   Application
 * @package    Default
 * @subpackage Views
 * @author     Hablul Soft Solution < /hablul.in>
 * @license    http://gnu.org GNU General Public License, version 3.0 (GPL-3.0)
 * @version    Sentrifugo v3.2
 */
?>

<!-- SSOT V.5 Standard Flash Messages -->
<div id="message_container">
	<?php if (!empty($this->messages)) : ?>
		<div id="dispmsg" class="settingssuccess">
			<?php foreach ($this->messages as $message) :
				if (is_array($message)): $key = key($message); ?>
					<div class="ml-alert-1-<?php echo $this->escape($key); ?>">
						<div style="display:block;">
							<span class="style-1-icon <?php echo $this->escape($key); ?>"></span>
							<?php echo $this->escape($message[$key]); ?>
						</div>
					</div>
			<?php endif;
			endforeach; ?>
		</div>
	<?php endif; ?>
</div>

<!-- Grid Container -->
<div id="currency_container" class="full-width">
	<!-- Required hidden div for Sentrifugo Global JS logic -->
	<div id="msg" style="display:none; font-style: oblique; font-weight: bold; color: green;"></div>

	<div id="grid_currency" class="all-grid-control">
		<?php
		// SSOT VIII: Safe check to prevent PHP 8+ Array/Null crashes
		if (isset($this->dataArray[0]['tablecontent']) && !empty($this->dataArray[0]['tablecontent'])) {
			echo $this->grid($this->dataArray[0]);
		} else if ($this->call != 'ajaxcall') {
			echo "<div class='no-data' style='text-align: center; color: #7f8c8d; padding: 30px; border: 1px dashed #ccc; background: #f9f9f9; border-radius: 4px;'>";
			echo "<i class='fa fa-folder-open-o' style='font-size: 24px; margin-bottom: 10px;'></i><br>";
			echo "No Currencies found.";
			echo "</div>";
		}
		?>
	</div>
</div>

<script type="text/javascript">
	$(document).ready(function() {
		// Auto-fade flash messages cleanly
		setTimeout(function() {
			$('#dispmsg').fadeOut('slow');
		}, 4000);
	});
</script>