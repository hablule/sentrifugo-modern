/**
 * Helper function defined locally in the view script to check if the 
 * multi-dimensional array actually contains any data across all its keys.
 */
function _isMappedOwnersEmpty($mappedOwners)
{
    foreach ($mappedOwners as $owners) {
        if (!empty($owners)) {
            return false;
        }
    }
    return true;
}
