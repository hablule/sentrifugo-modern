<script type="text/javascript">
    var optionsData = <?php echo $childOptionsJson; ?>;
    var editingIndex = -1;

    $(document).ready(function() {
        $('#description').jqte();
        if ($.isFunction($.fn.select2)) {
            $('select').select2({
                width: '100%'
            });
        }

        // Unbind any global listeners attached to this form to give us full control
        // $('#formid').off('submit');

        // Show/Hide Step Value based on UI Widget selection
        $('#ui_widget').change(function() {
            if ($(this).val() === 'Slider') {
                $('#step_value_container').fadeIn('fast');
            } else {
                $('#step_value_container').hide();
                $('#step_value').val('');
            }
        }).trigger('change');

        // Toggle UI logic
        $('#data_type').change(function() {
            if ($(this).val() === 'Structured') {
                $('#options_section').slideDown();
                renderOptionsTable();
            } else {
                $('#options_section').slideUp();
            }
        });

        $('#ui_widget').change(function() {
            var widget = $(this).val();
            var iconInput = $('#tmp_icon');
            if (iconInput.val() === '' || iconInput.val() === 'fa-star') {
                if (widget === 'Stars') {
                    iconInput.val('fa-star');
                } else {
                    iconInput.val('');
                }
            }
        });

        $('#data_type').trigger('change');
        $('#ui_widget').trigger('change');

        // Explicit AJAX Handler
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            var $form = $('#formid');

            if ($.isFunction($form.valid) && !$form.valid()) {
                return false;
            }
            $('#message_container').empty();
            $form.find('.errors').remove();

            if ($('#data_type').val() === 'Structured') {
                if (optionsData.length === 0) {
                    var errorHtml = '<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>Structured scales require at least one Rating Option.</div></div>';
                    $('#message_container').html(errorHtml);
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                    return false;
                }
                if (editingIndex > -1 || ($('#tmp_value').val() !== '' && $('#tmp_name').val() !== '')) {
                    if (!confirm("You have unsaved changes in the Option input fields. Save anyway?")) {
                        return false;
                    }
                }
                $('#options_payload').val(JSON.stringify(optionsData));
            } else {
                $('#options_payload').val('[]');
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/parating/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                global: false,
                beforeSend: function() {
                    if ($.isFunction($.blockUI)) $.blockUI({
                        width: '50px',
                        message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />'
                    });
                },
                complete: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                },
                success: function(response) {
                    if (response.result === 'saved') {
                        window.location.href = base_url + '/parating';
                    } else {
                        var mainError = response.result === 'exception' ? response.message : 'Please fix the highlighted errors.';
                        $('#message_container').html('<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>' + mainError + '</div></div>');

                        if (typeof response === 'object') {
                            $.each(response, function(fieldId, errorMsg) {
                                var errorSpan = '<span class="errors" id="errors-' + fieldId + '">' + errorMsg + '</span>';
                                var $element = $('#' + fieldId).parent().parent();
                                if ($element.length) $element.append(errorSpan);
                            });
                        }
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    $('#message_container').html('<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>Server communication error.</div></div>');
                }
            });
        });
    });

    // Option Grid helper functions remain the same...
    function renderOptionsTable() {
        var tbody = $('#options_tbody');
        tbody.empty();

        if (optionsData.length === 0) {
            tbody.append('<tr><td colspan="5" style="text-align:center; padding: 15px; color:#999; font-style:italic;">No options added yet.</td></tr>');
            return;
        }

        optionsData.sort(function(a, b) {
            return b.value - a.value;
        });

        $.each(optionsData, function(index, opt) {
            var iconHtml = opt.icon_class ? '<i class="fa ' + opt.icon_class + '" style="color:#f39c12;"></i>' : '-';
            var actionHtml = '<a href="javascript:void(0);" onclick="editOptionRow(' + index + ');" style="color:#3498db; margin-right: 10px;" title="Edit"><i class="fa fa-edit"></i></a>' +
                '<a href="javascript:void(0);" onclick="removeOptionRow(' + index + ');" style="color:#e74c3c;" title="Delete"><i class="fa fa-trash"></i></a>';
            var rowStyle = (index === editingIndex) ? 'background-color: #fffacd;' : '';

            var tr = '<tr style="border-bottom: 1px solid #eee; ' + rowStyle + '">' +
                '<td style="text-align:center; font-weight:bold;">' + opt.value + '</td>' +
                '<td>' + opt.name + '</td>' +
                '<td style="text-align:center;">' + opt.normalized_value + '</td>' +
                '<td style="text-align:center;">' + iconHtml + '</td>' +
                '<td style="text-align:center;">' + actionHtml + '</td>' +
                '</tr>';
            tbody.append(tr);
        });
    }

    function addOptionRow() {
        var val = parseFloat($('#tmp_value').val());
        var name = $.trim($('#tmp_name').val());
        var icon = $.trim($('#tmp_icon').val());
        var existingId = '';

        if (val === '' || name === '') {
            alert("Numeric Value and Text Label are required.");
            return;
        }
        if (isNaN(val)) {
            alert("Value must be a valid number.");
            return;
        }

        // Enforce Slider Limits in the UI
        var uiType = $('#ui_widget').val();
        if (uiType === 'Slider' && optionsData.length >= 2 && editingIndex === -1) {
            alert('Sliders can only have exactly TWO options (A Minimum and a Maximum boundary).');
            return;
        }

        var isDup = false;
        $.each(optionsData, function(index, opt) {
            if (index !== editingIndex && (parseFloat(opt.value) === parseFloat(val) || opt.name.toLowerCase() === name.toLowerCase())) {
                isDup = true;
            }
        });
        if (isDup) {
            alert("This numeric value already exists in the list.");
            return;
        }

        if (editingIndex > -1) {
            existingId = optionsData[editingIndex].id;
            optionsData[editingIndex] = {
                id: existingId,
                value: val,
                name: name,
                icon_class: icon
            };
            editingIndex = -1;
            $('#add_opt_btn').html('<i class="fa fa-plus"></i> Add');
        } else {
            optionsData.push({
                id: '',
                value: val,
                name: name,
                icon_class: icon 
            });
        }

        renderOptionsTable();
        $('#tmp_value, #tmp_name').val('');
        $('#tmp_icon').val('');
        $('#ui_widget').trigger('change');
    }

    function editOptionRow(index) {
        var opt = optionsData[index];        
        editingIndex = index;

        $('#tmp_value').val(opt.value);
        $('#tmp_name').val(opt.name);
        $('#tmp_icon').val(opt.icon_class);
        $('#add_opt_btn').html('<i class="fa fa-save"></i> Update');
        
        renderOptionsTable();
    }

    function removeOptionRow(index) {
        if (confirm("Are you sure you want to remove this option?")) {
            optionsData.splice(index, 1);
            if (editingIndex === index) {
                $('#tmp_value, #tmp_name, #tmp_icon').val('');
                $('#add_opt_btn').html('<i class="fa fa-plus"></i> Add');
                editingIndex = -1;
            } else if (editingIndex > index) {
                editingIndex--;
            }
            renderOptionsTable();
        }
    }
</script>