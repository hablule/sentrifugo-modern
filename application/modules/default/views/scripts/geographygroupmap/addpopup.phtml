        <script type="text/javascript">
            // SSOT VII: Robust AJAX Dropdown Pattern for Popups (Identical to save.phtml)
            function getStatesByCountry(countryId) {
                var $stateSelect = $('#state_id');
                $('#city_id').empty().append('<option value="">Select State First...</option>');
                $('#postalcode_id').empty().append('<option value="">Select City First...</option>');
                $stateSelect.empty().append('<option value="">Select State/Province...</option>');

                if (!countryId) {
                    reInitMaterialize();
                    return;
                }

                $stateSelect.parent().block({
                    message: null,
                    overlayCSS: {
                        background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                        opacity: 0.8
                    }
                });

                $.ajax({
                    url: base_url + '/geographygroupmap/getstates/format/json',
                    type: 'POST',
                    data: {
                        country_id: countryId
                    },
                    dataType: 'json',
                    success: function(res) {
                        if (res) $.each(res, function(k, v) {
                            $stateSelect.append('<option value="' + k + '">' + v + '</option>');
                        });
                    },
                    complete: function() {
                        $stateSelect.parent().unblock();
                        reInitMaterialize();
                    }
                });
            }

            function getCitiesByState(stateId) {
                var $citySelect = $('#city_id');
                $('#postalcode_id').empty().append('<option value="">Select City First...</option>');
                $citySelect.empty().append('<option value="">Select City...</option>');

                if (!stateId) {
                    reInitMaterialize();
                    return;
                }

                $citySelect.parent().block({
                    message: null,
                    overlayCSS: {
                        background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                        opacity: 0.8
                    }
                });

                $.ajax({
                    url: base_url + '/geographygroupmap/getcities/format/json',
                    type: 'POST',
                    data: {
                        state_id: stateId
                    },
                    dataType: 'json',
                    success: function(res) {
                        if (res) $.each(res, function(k, v) {
                            $citySelect.append('<option value="' + k + '">' + v + '</option>');
                        });
                    },
                    complete: function() {
                        $citySelect.parent().unblock();
                        reInitMaterialize();
                    }
                });
            }

            function getPostalCodesByCity(cityId) {
                var $postalSelect = $('#postalcode_id');
                $postalSelect.empty().append('<option value="">Select Postal/ZIP Code...</option>');

                if (!cityId) {
                    reInitMaterialize();
                    return;
                }

                $postalSelect.parent().block({
                    message: null,
                    overlayCSS: {
                        background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                        opacity: 0.8
                    }
                });

                $.ajax({
                    url: base_url + '/geographygroupmap/getpostalcodes/format/json',
                    type: 'POST',
                    data: {
                        city_id: cityId
                    },
                    dataType: 'json',
                    success: function(res) {
                        if (res) $.each(res, function(k, v) {
                            $postalSelect.append('<option value="' + k + '">' + v + '</option>');
                        });
                    },
                    complete: function() {
                        $postalSelect.parent().unblock();
                        reInitMaterialize();
                    }
                });
            }

            function toggleEntityFields(entityType) {
                $('#row_country, #row_state, #row_city, #row_postal').addClass('hidden-cascade');
                if (entityType === 'Country') $('#row_country').removeClass('hidden-cascade');
                else if (entityType === 'State') $('#row_country, #row_state').removeClass('hidden-cascade');
                else if (entityType === 'City') $('#row_country, #row_state, #row_city').removeClass('hidden-cascade');
                else if (entityType === 'PostalCode') $('#row_country, #row_state, #row_city, #row_postal').removeClass('hidden-cascade');
                handleEntitySelection(entityType);
            }

            function handleEntitySelection(triggerLevel, val) {
                var type = $('#entity_type').val();
                var finalId = '';
                if (type === 'Country') finalId = $('#country_id').val();
                else if (type === 'State') finalId = $('#state_id').val();
                else if (type === 'City') finalId = $('#city_id').val();
                else if (type === 'PostalCode') finalId = $('#postalcode_id').val();
                $('#entity_id').val(finalId);
            }

            function reInitMaterialize() {
                if ($.isFunction($.fn.material_select)) $('select').material_select();
                else if ($.isFunction($.fn.select2)) $('select').select2();
            }

            $(document).ready(function() {
                if ($('#description').length) {
                    $('#description').jqte();
                }
                var initType = $('#entity_type').val();
                if (initType) toggleEntityFields(initType);
            });
        </script>
