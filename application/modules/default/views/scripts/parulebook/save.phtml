<script type="text/javascript">
    // State Arrays populated by Controller (if editing)
    var arrTargets = <?php echo $this->existingTargets; ?>;
    var arrEvaluators = <?php echo $this->existingEvaluators; ?>;
    var arrQuestions = <?php echo $this->existingQuestions; ?>;

    $(document).ready(function() {

        // 1. BRUTE FORCE TAB LOGIC
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();

            var targetPanelId = $(this).attr('href');

            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');

            $('.sf-tab-panel').hide();
            $(targetPanelId).fadeIn('fast');
        });

        // 2. Initialize plugins safely
        try {
            $('#description').jqte();
            if ($.isFunction($.fn.select2)) {
                $('.select2').select2({
                    width: '100%'
                });
            }
        } catch (err) {
            console.log("Plugin init warning: ", err);
        }

        // ==============================================================
        // POLYMORPHIC TARGET UI TOGGLE (Wrapper-based)
        // ==============================================================
        $('#ui_target_type').change(function() {
            var selectedType = $(this).val();

            $('.target-wrapper').hide();
            $('.target-select').removeClass('active-target');

            if (selectedType === 'All') {
                $('#ui_target_id_container').hide();
            } else {
                $('#ui_target_id_container').show();
                var $targetWrapper = $('#wrapper_' + selectedType);
                var $targetSelect = $('#target_' + selectedType);

                if ($targetWrapper.length) {
                    $targetWrapper.show();
                    $targetSelect.addClass('active-target');
                }
            }
        }).trigger('change');

        // Initial Render of tables
        renderTargets();
        renderEvaluators();
        renderQuestions();

        // ==============================================================
        // MASTER SUBMIT HANDLER (The "One-Shot" Save)
        // ==============================================================
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            if ($.isFunction($form.valid) && !$form.valid()) {
                return false;
            }

            // Pack Arrays into JSON hidden inputs
            $('#targets_payload').val(JSON.stringify(arrTargets));
            $('#evaluators_payload').val(JSON.stringify(arrEvaluators));
            $('#questions_payload').val(JSON.stringify(arrQuestions));

            if ($.isFunction($.blockUI)) {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
                });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/parulebook/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if ($.isFunction($.unblockUI)) $.unblockUI();

                    if (res.result === 'saved') {
                        window.location.href = base_url + '/parulebook';
                    } else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').html('');

                        $.each(res, function(key, val) {
                            var errMsg = '';
                            if (typeof val === 'object') {
                                for (var prop in val) {
                                    errMsg += val[prop];
                                    break;
                                }
                            } else {
                                errMsg = val;
                            }

                            var errorSpan = $('#errors-' + key);
                            if (errorSpan.length > 0) {
                                errorSpan.html(errMsg).show();
                            } else {
                                $('[name="' + key + '"]').after('<span class="errors" id="errors-' + key + '">' + errMsg + '</span>');
                            }
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error occurred. Check logs.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });

    // ==============================================================
    // TARGETS LOGIC
    // ==============================================================
    function addTargetRow() {
        var type = $('#ui_target_type').val();
        var id = 0;
        var name = 'All Employees';

        if (type !== 'All') {
            var $activeSelect = $('#target_' + type);
            id = $activeSelect.val();
            if (!id || id === '' || parseInt(id) <= 0) {
                alert('Please select a specific unit.');
                return;
            }
            name = $.trim($activeSelect.find('option:selected').text());
        }

        var exists = false;
        $.each(arrTargets, function(i, v) {
            if (v.target_type == type && v.target_id == id) exists = true;
        });
        if (exists) {
            alert('This target has already been added.');
            return;
        }

        arrTargets.push({
            target_type: type,
            target_id: id,
            target_name: name
        });

        if (type !== 'All') {
            $('#target_' + type).val('').trigger('change.select2');
        }
        renderTargets();
    }

    function renderTargets() {
        var html = '';
        $.each(arrTargets, function(idx, val) {
            // FIXED: Target Name is now reliably populated by the DB or the JS
            var displayId = val.target_name ? val.target_name : (val.target_id > 0 ? 'ID: ' + val.target_id : 'All Employees');
            html += '<tr><td>' + val.target_type + '</td><td>' + displayId + '</td>';
            html += '<td><a class="remove-btn" onclick="removeArrItem(arrTargets, ' + idx + '); renderTargets();"><i class="fa fa-trash"></i> Remove</a></td></tr>';
        });
        $('#tbl-targets tbody').html(html);
    }

    // ==============================================================
    // EVALUATORS LOGIC
    // ==============================================================
    function addEvaluatorRow() {
        var type = $('#ui_evaluator_type').val();
        var isMandatory = $('#ui_evaluator_mandatory').val();

        var exists = false;
        $.each(arrEvaluators, function(i, v) {
            if (v.evaluator_type == type) exists = true;
        });
        if (exists) {
            alert('Evaluator type already added.');
            return;
        }

        arrEvaluators.push({
            evaluator_type: type,
            evaluator_id: 0,
            is_mandatory: isMandatory
        });
        renderEvaluators();
    }

    function renderEvaluators() {
        var html = '';
        $.each(arrEvaluators, function(idx, val) {
            var mandText = val.is_mandatory == 1 ? '<span style="color:green;font-weight:bold;">Yes</span>' : '<span style="color:#e67e22;">No</span>';
            html += '<tr><td>' + val.evaluator_type + '</td><td>' + mandText + '</td>';
            html += '<td><a class="remove-btn" onclick="removeArrItem(arrEvaluators, ' + idx + '); renderEvaluators();"><i class="fa fa-trash"></i> Remove</a></td></tr>';
        });
        $('#tbl-evaluators tbody').html(html);
    }

    // ==============================================================
    // QUESTIONS LOGIC
    // ==============================================================
    function addQuestionRow() {
        var $selectedOption = $('#ui_question_id option:selected');
        var id = $selectedOption.val();
        var text = $.trim($selectedOption.text());
        var ratingId = $selectedOption.data('rating');
        var weight = $selectedOption.data('weight');

        if (!id || id === '') {
            alert('Please select a question.');
            return;
        }

        var exists = false;
        $.each(arrQuestions, function(i, v) {
            if (v.question_id == id) exists = true;
        });
        if (exists) {
            alert('This question is already added.');
            return;
        }

        // PUSH RATING AND WEIGHT INTO THE JSON ARRAY
        arrQuestions.push({
            question_id: id,
            question_name: text,
            rating_id: ratingId,
            weight: weight
        });

        $('#ui_question_id').val('').trigger('change.select2');
        renderQuestions();
    }

    function renderQuestions() {
        var html = '';
        $.each(arrQuestions, function(idx, val) {
            html += '<tr><td>#' + val.question_id + '</td><td>' + val.question_name + '</td>';
            html += '<td><a class="remove-btn" onclick="removeArrItem(arrQuestions, ' + idx + '); renderQuestions();"><i class="fa fa-trash"></i> Remove</a></td></tr>';
        });
        $('#tbl-questions tbody').html(html);
    }

    // --- UTILS ---
    function removeArrItem(arr, index) {
        arr.splice(index, 1);
    }
</script>