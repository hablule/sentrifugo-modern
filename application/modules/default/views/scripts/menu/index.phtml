<?php
/**
 * Menu Management Index View
 * 
 * @category   Application
 * @package    Default
 * @subpackage Views
 */
$this->headLink()->appendStylesheet(MEDIA_PATH . 'css/screen.css');
$this->headLink()->appendStylesheet(MEDIA_PATH . 'css/style.css');
?>

<!-- Flash Messages -->
<div id="message_container">
    <?php if (!empty($this->messages)) : ?>
        <div id="dispmsg" class="settingssuccess">
            <?php foreach ($this->messages as $message) : $key = key($message); ?>
                <div class="ml-alert-1-<?php echo $key; ?>">
                    <div style="display:block;">
                        <span class="style-1-icon <?php echo $key; ?>"></span>
                        <?php echo $message[$key]; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<!-- Grid Container -->
<div id="menu_container" class="full-width">
    <div id="msg" style="display:none;font-style: oblique; font-weight: bold; color: green;"></div>
    
    <div id="grid_menu" class="all-grid-control">
        <?php
        if (!empty($this->dataArray[0]['tablecontent'])) {
            echo $this->grid($this->dataArray[0]);
        } else if ($this->call != 'ajaxcall') {
            echo "<p class='no-data'>No menus found.</p>";
        }
        ?>
    </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    // Auto-fade flash messages
    setTimeout(function() {
        $('#dispmsg').fadeOut('slow');
    }, 4000);
});
</script>