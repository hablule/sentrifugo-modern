<script type="text/javascript">
    $(document).ready(function() {
        $('#description, #helpText, #toolTip').jqte();

        $ // --- Custom AJAX Submit for File Uploads ---
        $('#submitbutton').click(function(e) {
            e.preventDefault(); // Stop default HTML submission

            var $form = $('#formid');

            // 1. Run Sentrifugo Client Validations
            if (!$form.valid()) {
                return false; // Stop if form is invalid
            }

            // Block UI
            if (typeof $.blockUI === "function") {
                $.blockUI({
                    width: '50px',
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />'
                });
            }

            // 2. Prepare FormData (Allows file uploads via AJAX)
            var formData = new FormData($form[0]);

            // 3. Send AJAX Request
            $.ajax({
                url: base_url + '/menu/save/format/json',
                type: 'POST',
                data: formData,
                processData: false, // Tell jQuery not to process the data (required for files)
                contentType: false, // Tell jQuery not to set contentType (required for files)
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") {
                        $.unblockUI();
                    }

                    if (response.result === 'saved' || response.msgtype === 'success') {
                        // Success: Redirect to index
                        window.location.href = base_url + '/menu';
                    } else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else if (response.result === 'error') {
                        // Display Zend Form Validation Errors
                        var errHtml = '<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>';
                        $('#message_container').html(errHtml);

                        // Try to attach errors to specific fields
                        $.each(response.message, function(key, val) {
                            var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                            var $field = $('#' + key);
                            $('#errors-' + key).remove(); // Remove old errors
                            $field.parent().append('<span class="errors" id="errors-' + key + '">' + errMsg + '</span>');
                        });

                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        // General Error
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") {
                        $.unblockUI();
                    }
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        });
    });
</script>