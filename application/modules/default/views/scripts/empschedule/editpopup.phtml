<script type='text/javascript'>

      var res
    $("#sch_name").change(()=>{
         res = $.ajax({
            url:base_url+"/schedule/timeschedule/getschedule",
            dataType:'json',
            data:"id="+$("#sch_name").val(),
            async:false
        }).responseJSON;
        $("#start_date,#end_date").datepicker("destroy");
        $('#start_date,#end_date').datepicker({
					showOn: 'both',
					minDate: res['startdate'],
                    maxDate: res['enddate'],
					//yearRange: yearrange,
					dateFormat: 'yy-m-d',
					buttonImage: "<?php echo $this->baseUrl("public/media/images/cal.jpg"); ?>",
					buttonImageOnly: true,
					buttonText: "",
					changeMonth: true,
					changeYear: true,
					showButtonPanel: true,
					onClose: function() {
						$(this).trigger('blur');
						var msg = "";
						if (this.id == 'enddate')
							msg = "End date should be greater than Start date.";
						else
							msg = "Start date should be less than End date.";
						from_to_date_validation('start_date', 'end_date', this, msg);
					}

		});
    })
