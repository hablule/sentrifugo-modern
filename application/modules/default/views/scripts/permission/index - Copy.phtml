<div id="permission_header">
    <div class="page-header-container" style="display: flex; justify-content: space-between; align-items: center; padding: 15px;">
        <h4 class="page-title">Action Permission Mapping</h4>
        
        <div class="actions_div">
            <button id="btn-scan" class="actbtn_btn" style="background-color: #f39c12;">
                <i class="fa fa-search"></i> Run Scanner
            </button>
            <button id="btn-save" class="actbtn_btn">
                <i class="fa fa-save"></i> Save Mappings
            </button>
        </div>
    </div>
</div>

<div id="message_container" style="margin: 10px 15px;"></div>

<div class="wrapperdivrightmain" style="padding: 15px;">
    
    <div id="permission_accordion">
        <?php foreach ($this->matrix as $ctrlId => $group): ?>
            <?php if (!isset($group['details'])) continue; ?>
            
            <h3>
                <?php echo $this->escape($group['details']['module_id'] . ' / ' . $group['details']['controller']); ?>
                <span style="font-size: 12px; color: #666; float:right;">
                    Last Scanned: <?php echo $this->escape($group['details']['last_scanned']); ?>
                </span>
            </h3>
            
            <div>
                <table class="grid" style="width: 100%;">
                    <thead>
                        <tr class="table-header">
                            <th style="width: 30%;">Action Name</th>
                            <th style="width: 10%;">Status</th>
                            <?php foreach ($this->standardPerms as $perm): ?>
                                <th style="text-align: center;"><?php echo ucfirst($perm); ?></th>
                            <?php endforeach; ?>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($group['actions'] as $actionId => $action): ?>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td><?php echo $this->escape($action['name']); ?></td>
                                <td>
                                    <?php if ($action['status'] == 'New'): ?>
                                        <span style="color: red; font-weight: bold;">New</span>
                                    <?php else: ?>
                                        <span style="color: green;">Active</span>
                                    <?php endif; ?>
                                </td>
                                
                                <?php foreach ($this->standardPerms as $perm): ?>
                                    <?php $isChecked = in_array($perm, $action['permissions']) ? 'checked="checked"' : ''; ?>
                                    <td style="text-align: center;">
                                        <input type="checkbox" 
                                               class="perm-checkbox" 
                                               data-action-id="<?php echo $actionId; ?>" 
                                               data-perm="<?php echo $perm; ?>" 
                                               <?php echo $isChecked; ?>>
                                    </td>
                                <?php endforeach; ?>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endforeach; ?>
    </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    
    // Initialize standard jQuery UI Accordion
    $("#permission_accordion").accordion({
        collapsible: true,
        active: false,
        heightStyle: "content"
    });

    // Scanner AJAX
    $('#btn-scan').click(function() {
        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Scanning...');
        
        $.ajax({
            url: base_url + '/permission/scan',
            type: 'POST',
            dataType: 'json',
            success: function(res) {
                if (res.status === 'success') {
                    alert(res.message);
                    window.location.reload(); // Reload to show new actions
                } else {
                    alert('Error: ' + res.message);
                    $btn.prop('disabled', false).html('<i class="fa fa-search"></i> Run Scanner');
                }
            }
        });
    });

    // Save AJAX
    $('#btn-save').click(function() {
        var mappings = {};
        
        // Gather all checkboxes
        $('.perm-checkbox').each(function() {
            var actionId = $(this).data('action-id');
            var perm = $(this).data('perm');
            
            if (!mappings[actionId]) {
                mappings[actionId] = [];
            }
            
            if ($(this).is(':checked')) {
                mappings[actionId].push(perm);
            }
        });

        // Send via AJAX
        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        $.ajax({
            url: base_url + '/permission/savemapping',
            type: 'POST',
            data: { mappings: JSON.stringify(mappings) },
            dataType: 'json',
            success: function(res) {
                if (res.status === 'success') {
                    // Show standard Sentrifugo success msg
                    $('#message_container').html('<div class="ml-alert-1-success"><span class="style-1-icon success"></span>' + res.message + '</div>');
                    setTimeout(function() { $('#message_container').empty(); }, 3000);
                } else {
                    alert('Error: ' + res.message);
                }
                $btn.prop('disabled', false).html('<i class="fa fa-save"></i> Save Mappings');
            }
        });
    });

});
</script>