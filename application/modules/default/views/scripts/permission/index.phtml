<script type="text/javascript">
    $(document).ready(function() {

        // 1. Initialize Accordion
        $("#permission_accordion").accordion({
            collapsible: true,
            active: false,
            heightStyle: "content",
            icons: {
                "header": "ui-icon-plus",
                "activeHeader": "ui-icon-minus"
            }
        });

        // 2. Filters
        function applyFilters() {
            var ctrlQuery = $('#filterController').val().toLowerCase();
            var actionQuery = $('#filterAction').val().toLowerCase();
            var statusFilter = $('#filterStatus').val().toLowerCase();
            var moduleFilter = $('#filterModule').val().toLowerCase();

            $('.controller-header').each(function() {
                var $header = $(this);
                var $body = $header.next('.controller-body');
                var headerModule = $header.data('module');
                var headerCtrl = $header.data('controller');

                var moduleMatch = (moduleFilter === '' || headerModule === moduleFilter);
                var ctrlMatch = (ctrlQuery === '' || headerCtrl.indexOf(ctrlQuery) > -1);

                var hasVisibleRows = false;

                $body.find('.perm-row').each(function() {
                    var $row = $(this);
                    var rowAction = $row.data('action');
                    var rowStatus = $row.data('status');

                    var actionMatch = (actionQuery === '' || rowAction.indexOf(actionQuery) > -1);
                    var statusMatch = (statusFilter === '' || rowStatus === statusFilter);

                    if (moduleMatch && ctrlMatch && actionMatch && statusMatch) {
                        $row.show();
                        hasVisibleRows = true;
                    } else {
                        $row.hide();
                    }
                });

                if (hasVisibleRows && moduleMatch && ctrlMatch) {
                    $header.show();
                } else {
                    $header.hide();
                    if ($header.hasClass('ui-state-active')) {
                        $header.trigger('click');
                    }
                }
            });
        }

        $('#filterController, #filterAction').on('keyup', applyFilters);
        $('#filterStatus, #filterModule').on('change', applyFilters);

        // 3. Toggles
        $('.perm-checkbox').on('change', function(e) {
            e.stopPropagation();
            $(this).closest('tr').addClass('row-modified');
        });

        $('.row-toggle').on('change', function(e) {
            e.stopPropagation();
            var isChecked = $(this).is(':checked');
            var $row = $(this).closest('tr');
            $row.find('.perm-checkbox').prop('checked', isChecked);
            $row.addClass('row-modified');
        });

        $('.col-toggle').on('click', function(e) {
            e.stopPropagation();
            var perm = $(this).data('perm');
            var ctrlId = $(this).data('ctrl');
            var $checkboxes = $('.perm-' + perm + '.ctrl-' + ctrlId);

            var newState = !$checkboxes.first().is(':checked');
            $checkboxes.prop('checked', newState);
            $checkboxes.closest('tr').addClass('row-modified');
        });

        // -------------------------------------------------------------------------
        // 4. THE MAGIC WAND HEURISTIC ENGINE
        // -------------------------------------------------------------------------
        $('#btn-automap').click(function() {
            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Auto-Mapping..." /><br><br>Applying Magic Wand Heuristics...'
                });
            }

            // The Sentrifugo Keyword Dictionary
            var dictionary = {
                'view': ['index', 'view', 'list', 'get', 'fetch', 'display', 'show', 'search', 'report', 'grid'],
                'add': ['add', 'create', 'insert', 'new'],
                'edit': ['edit', 'update', 'change', 'activeinactive', 'modify', 'assign', 'set'],
                'delete': ['delete', 'remove', 'destroy', 'discard', 'erase', 'clear'],
                'upload': ['upload', 'import'],
                'viewupload': ['download', 'export', 'print', 'pdf', 'excel', 'csv']
            };

            var comboSave = ['save', 'submit', 'process']; // Triggers Add + Edit
            var mappedCount = 0;

            // Iterate through all "New" rows currently visible or hidden
            $('.perm-row[data-status="new"]').each(function() {
                var $row = $(this);
                var actionName = $row.data('action'); // e.g., "addcandidateaction"
                var wasMapped = false;

                // Remove 'action' suffix to avoid false positives (like 'activeinactiveAction')
                var baseName = actionName.replace('action', '');

                // 1. Check for Save/Submit combos first
                $.each(comboSave, function(i, keyword) {
                    if (baseName.indexOf(keyword) > -1) {
                        $row.find('.perm-add, .perm-edit').prop('checked', true);
                        wasMapped = true;
                    }
                });

                // 2. Check Standard Dictionary
                $.each(dictionary, function(permission, keywords) {
                    $.each(keywords, function(i, keyword) {
                        if (baseName.indexOf(keyword) > -1) {
                            $row.find('.perm-' + permission).prop('checked', true);
                            wasMapped = true;
                        }
                    });
                });

                // 3. Mark row as modified if we guessed something
                if (wasMapped) {
                    $row.addClass('row-modified');
                    mappedCount++;

                    // Expand accordion so user can review the changes
                    var $header = $row.closest('.controller-body').prev('.controller-header');
                    if (!$header.hasClass('ui-state-active')) {
                        $header.trigger('click');
                    }
                }
            });

            setTimeout(function() {
                if (typeof $.unblockUI === "function") $.unblockUI();
                if (mappedCount > 0) {
                    $('#message_container').html('<div class="ml-alert-1-success"><span class="style-1-icon success"></span>Magic Wand successfully pre-selected permissions for ' + mappedCount + ' unmapped actions. Please review and click "Save Mappings".</div>');
                    // Remove animation class after first use
                    $('#btn-automap').removeClass('btn-magic');
                } else {
                    $('#message_container').html('<div class="ml-alert-1-info"><span class="style-1-icon info"></span>No new actions matched the heuristic dictionary.</div>');
                }
                $('html, body').animate({
                    scrollTop: 0
                }, 'fast');
            }, 500); // 500ms delay to let the UI breathe
        });

        // 5. Scanner AJAX
        $('#btn-scan').click(function() {
            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Scanning..." /><br><br>Scanning System...'
                });
            }

            $.ajax({
                url: base_url + '/permission/scan',
                type: 'POST',
                dataType: 'json',
                success: function(res) {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    if (res.status === 'success') {
                        window.location.reload();
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'fast');
                    }
                }
            });
        });

        // 6. Save AJAX
        $('#btn-save').click(function() {
            var mappings = {};

            $('.perm-checkbox').each(function() {
                var actionId = $(this).data('action-id');
                var perm = $(this).data('perm');
                if (!mappings[actionId]) mappings[actionId] = [];
                if ($(this).is(':checked')) mappings[actionId].push(perm);
            });

            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Saving..." /><br><br>Compiling ACL Cache...'
                });
            }

            $.ajax({
                url: base_url + '/permission/savemapping',
                type: 'POST',
                data: {
                    mappings: JSON.stringify(mappings)
                },
                dataType: 'json',
                success: function(res) {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    if (res.status === 'success') {
                        $('.row-modified').removeClass('row-modified');

                        // Convert New badges to Mapped
                        $('.perm-row[data-status="new"]').each(function() {
                            var hasChecks = $(this).find('.perm-checkbox:checked').length > 0;
                            if (hasChecks) {
                                $(this).attr('data-status', 'mapped');
                                $(this).find('.badge-new').removeClass('badge-new').addClass('badge-active').text('Mapped');
                            }
                        });

                        $('#message_container').html('<div class="ml-alert-1-success"><span class="style-1-icon success"></span>' + res.message + '</div>');
                        setTimeout(function() {
                            $('#message_container').fadeOut('slow', function() {
                                $(this).empty().show();
                            });
                        }, 3000);
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                    }
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'fast');
                }
            });
        });

    });
</script>