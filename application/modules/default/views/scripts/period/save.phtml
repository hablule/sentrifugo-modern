<script type="text/javascript">
    // State Array populated by Controller (if editing)
    var arrControls = <?php echo isset($this->existingControls) ? $this->existingControls : '[]'; ?>;

    $(document).ready(function() {
        $('#description').jqte();

        // --- BRUTE FORCE TAB LOGIC ---
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();
            var targetPanelId = $(this).attr('href');
            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');
            $('.sf-tab-panel').hide();
            $(targetPanelId).fadeIn('fast');
        });

        // --- LINKED DATEPICKERS ---
        $('#start_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#end_date").datepicker("option", "minDate", selectedDate);
            }
        });
        $('#end_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#start_date").datepicker("option", "maxDate", selectedDate);
            }
        });

        if ($('#start_date').val() != '') $("#end_date").datepicker("option", "minDate", $('#start_date').val());
        if ($('#end_date').val() != '') $("#start_date").datepicker("option", "maxDate", $('#end_date').val());

        // Initial Render of the Grid
        renderControls();

        // --- MASTER SUBMIT HANDLER ---
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();

            if ($.isFunction($form.valid) && !$form.valid()) return false;

            var sDate = new Date($('#start_date').val());
            var eDate = new Date($('#end_date').val());
            if (sDate > eDate) {
                $('#errors-start_date').text("Start date cannot be after end date.");
                $('html, body').animate({
                    scrollTop: 0
                }, 'slow');
                return false;
            }

            // Sync grid dropdowns back to the Javascript array before saving
            syncGridInputsToArray();

            // Pack Array into JSON hidden input
            $('#controls_payload').val(JSON.stringify(arrControls));

            if (typeof $.blockUI === "function") $.blockUI({
                message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
            });

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/period/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    if (res.result === 'saved') {
                        var fYearId = $('#fiscalyear_id').val() || $('#fiscalyear_id_hidden').val();
                        var redirectUrl = base_url + '/period';
                        if (fYearId) redirectUrl += '/index/fiscalyear_id/' + fYearId;
                        window.location.href = redirectUrl;

                    } else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $.each(res, function(key, val) {
                            var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                            $('#errors-' + key).text(errMsg);
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred. Check logs.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });

    // ==============================================================
    // PERIOD CONTROL GRID LOGIC
    // ==============================================================

    function addControlRow() {
        var $procSelect = $('#ui_process_id');
        var processId = $procSelect.val();
        var processName = $.trim($procSelect.find('option:selected').text());
        var status = $('#ui_process_status').val();

        if (!processId || processId === '') {
            alert('Please select a Business Process.');
            return;
        }

        // Duplicate Validation Rule
        var exists = false;
        $.each(arrControls, function(i, v) {
            if (v.process_id == processId && v.action !== 'delete') {
                exists = true;
            }
        });

        if (exists) {
            alert('A control entry for "' + processName + '" already exists in the grid. Please update the existing row.');
            return;
        }

        arrControls.push({
            id: 0, // 0 indicates a new, unsaved record
            process_id: processId,
            process_name: processName,
            status: status,
            action: 'new'
        });

        $procSelect.val(''); // Reset dropdown
        renderControls();
    }

    function removeControlRow(index) {
        var p = arrControls[index];
        if (p.id > 0) {
            p.action = 'delete';
        } else {
            arrControls.splice(index, 1);
        }
        renderControls();
    }

    // Colors the status dropdowns dynamically
    function colorizeStatusDropdown(selectObj) {
        var val = $(selectObj).val();
        if (val === 'Open') $(selectObj).css('color', 'green');
        else if (val === 'Locked') $(selectObj).css('color', 'orange');
        else if (val === 'Closed') $(selectObj).css('color', 'red');
    }

    function renderControls() {
        var html = '';
        if (arrControls.length === 0) {
            html = '<tr><td colspan="3" style="text-align:center; color:#999; padding: 20px;">No period controls defined. Use the tools above to add locks.</td></tr>';
        }

        $.each(arrControls, function(idx, val) {
            if (val.action === 'delete') {
                html += '<tr class="deleted-row"><td colspan="3"><input type="hidden" id="c_action_' + idx + '" value="delete"></td></tr>';
                return true;
            }

            var isNew = (val.id == 0);
            var rowClass = isNew ? 'staged-row' : '';

            html += '<tr class="' + rowClass + '">';
            html += '<td>' + val.process_name + '</td>';

            // Status Dropdown
            html += '<td><select id="c_status_' + idx + '" class="browser-default" onchange="colorizeStatusDropdown(this);">';
            html += '<option value="Open" ' + (val.status === 'Open' ? 'selected' : '') + ' style="color:green;">Open</option>';
            html += '<option value="Locked" ' + (val.status === 'Locked' ? 'selected' : '') + ' style="color:orange;">Locked</option>';
            html += '<option value="Closed" ' + (val.status === 'Closed' ? 'selected' : '') + ' style="color:red;">Closed</option>';
            html += '</select></td>';

            html += '<td style="text-align:center;">';
            html += '<input type="hidden" id="c_id_' + idx + '" value="' + val.id + '">';
            html += '<input type="hidden" id="c_action_' + idx + '" value="' + (isNew ? 'new' : 'update') + '">';
            html += '<a class="grid-btn grid-btn-remove" onclick="removeControlRow(' + idx + ');" title="Remove Control"><i class="fa fa-trash"></i></a>';
            html += '</td></tr>';
        });

        $('#tbl-controls tbody').html(html);

        // Apply colors to freshly rendered dropdowns
        $('select[id^="c_status_"]').each(function() {
            colorizeStatusDropdown(this);
        });
    }

    function syncGridInputsToArray() {
        $.each(arrControls, function(idx, val) {
            if (val.action === 'delete') return true;
            val.status = $('#c_status_' + idx).val();
            val.action = $('#c_action_' + idx).val();
        });
    }
</script>