<script type="text/javascript">
    $(document).ready(function() {
        if ($('#description').length) {
            $('#description').jqte();
        }

        // Initialize Select2 if available
        if ($.isFunction($.fn.select2)) {
            $('#base_currency_id, #target_currency_id').select2({
                width: '100%'
            });
        }

        // Linked Datepickers Logic
        $('#start_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                // Proactive: Prevent End Date from being before Start Date
                $("#end_date").datepicker("option", "minDate", selectedDate);
            }
        });

        $('#end_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                // Proactive: Prevent Start Date from being after End Date
                $("#start_date").datepicker("option", "maxDate", selectedDate);
            }
        });

        // Set initial min/max constraints if values exist (for Edit mode)
        if ($('#start_date').val() != '') {
            $("#end_date").datepicker("option", "minDate", $('#start_date').val());
        }
        if ($('#end_date').val() != '') {
            $("#start_date").datepicker("option", "maxDate", $('#end_date').val());
        }
    });
</script>