<script type="text/javascript">
    $(document).ready(function() {
        if ($.isFunction($.fn.select2)) {
            $('select').select2({
                width: '100%'
            });
        }

        // Intercept to handle the JSON redirect_url correctly
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            var $form = $('#formid');
            if ($.isFunction($form.valid) && !$form.valid()) return false;

            if ($.isFunction($.blockUI)) $.blockUI({
                message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
            });
            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/pafeedforward/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    if (res.result === 'saved') window.location.href = res.redirect_url;
                    else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').html('');
                        $.each(res, function(key, val) {
                            $('#errors-' + key).html((typeof val === 'object') ? val[Object.keys(val)[0]] : val);
                        });
                    }
                },
                error: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error.</div>');
                }
            });
        });
    });
</script>