<?php

/**
 * PA Feedforward Index View
 * Strictly adheres to SSOT v6.6.
 * Features JS URL rewriting for grid action icons.
 */
?>
<div id="message_container">
    <?php if (!empty($this->messages)) : ?>
        <div id="dispmsg" class="settingssuccess">
            <?php foreach ($this->messages as $message) :
                if (is_array($message)): $key = key($message); ?>
                    <div class="ml-alert-1-<?php echo $this->escape($key); ?>">
                        <div style="display:block;"><span class="style-1-icon <?php echo $this->escape($key); ?>"></span><?php echo $this->escape($message[$key]); ?></div>
                    </div>
            <?php endif;
            endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<div id="pafeedforward_container" class="full-width">
    <div id="msg" style="display:none;"></div>
    <div id="grid_pafeedforward" class="all-grid-control">
        <?php
        if (isset($this->dataArray[0]['tablecontent']) && !empty($this->dataArray[0]['tablecontent'])) {
            echo $this->grid($this->dataArray[0]);
        } else if ($this->call != 'ajaxcall') {
            echo "<div class='no-data' style='text-align: center; color: #7f8c8d; padding: 30px; border: 1px dashed #ccc; background: #f9f9f9; border-radius: 4px;'><i class='fa fa-comments-o' style='font-size: 24px; margin-bottom: 10px;'></i><br>You haven't given any feedback yet. Click 'Add' to start.</div>";
        }
        ?>
    </div>
</div>

<script type="text/javascript">
    // =========================================================================
    // JQUERY EVENT DELEGATION: ROUTE TO EXECUTION MODULE
    // Captures native clicks and forcefully routes the user to the paassessment 
    // execution module with the 'tasks' context.
    // =========================================================================
    $(document).on('click', '#grid_pafeedforward a', function(e) {
        var href = $(this).attr('href');
        var onclickAttr = $(this).attr('onclick');

        // 1. Intercept Sentrifugo's native inline functions
        if (onclickAttr && (onclickAttr.indexOf('editrecord') !== -1 || onclickAttr.indexOf('viewrecord') !== -1)) {
            e.preventDefault();
            e.stopPropagation(); // SSOT VII.12: Prevent default routing

            var match = onclickAttr.match(/'(\d+)'/);
            if (match && match[1]) {
                var recordId = match[1];
                var action = onclickAttr.indexOf('editrecord') !== -1 ? 'edit' : 'view';

                if ($.isFunction($.blockUI)) {
                    $.blockUI({
                        width: "50px",
                        message: $("#spinner").html()
                    });
                }

                // ROUTE TO PAASSESSMENT WITH CONTEXT = TASKS
                window.location.href = base_url + '/paassessment/' + action + '/id/' + recordId + '/context/tasks';
            }
            return false;
        }
        // 2. Fallback for standard <a href="..."> links
        else if (href && href !== '#' && href.toLowerCase().indexOf('javascript') === -1) {
            if (href.indexOf('/edit/id/') !== -1 || href.indexOf('/view/id/') !== -1) {
                e.preventDefault();
                e.stopPropagation();

                // Swap the controller path
                var newHref = href.replace('/pafeedforward/', '/paassessment/');

                // Append the context
                if (newHref.indexOf('/context/') === -1) {
                    newHref = newHref + '/context/tasks';
                }

                if ($.isFunction($.blockUI)) {
                    $.blockUI({
                        width: "50px",
                        message: $("#spinner").html()
                    });
                }
                window.location.href = newHref;
                return false;
            }
        }
    });

    $(document).ready(function() {
        setTimeout(function() {
            $('#dispmsg').fadeOut('slow');
        }, 4000);
    });
</script>
