<script type="text/javascript">
    $(document).ready(function() {
        // Initialize WYSIWYG
        $('#description').jqte();

        // Initialize DatePicker
        $('#org_start_date').datepicker({
            showOn: 'both',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            changeMonth: true,
            changeYear: true
        });

        // SSOT v6.4 Custom AJAX File Upload Binding
        // Intercepts the default saveDetails click to handle FormData
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault(); 

            var $form = $('#formid');
            if (!$form.valid()) { return false; }

            if (typeof $.blockUI === "function") {
                $.blockUI({ message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />' });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/company/save/format/json',
                type: 'POST',
                data: formData,
                processData: false, 
                contentType: false, 
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    // 1. Check for explicit success
                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/company';
                    } 
                    // 2. Check for explicit exception
                    else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({ scrollTop: 0 }, 'slow');
                    } 
                    // 3. Otherwise, treat the response as a raw Zend_Form validation error array
                    else if (response && typeof response === 'object') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').empty(); // Clear old errors
                        
                        $.each(response, function(fieldId, errorObj) {
                            // Extract the first error message string from the nested object
                            var errMsg = (typeof errorObj === 'object') ? errorObj[Object.keys(errorObj)[0]] : errorObj;
                            
                            // Inject error next to the corresponding field
                            $('#errors-' + fieldId).text(errMsg);
                        });
                        
                        $('html, body').animate({ scrollTop: 0 }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        });
    });
</script>