<script type="text/javascript">
    var arrGroups = <?php echo $this->existingGroups ?? '[]'; ?>;
    var arrRoles = <?php echo $this->existingRoles ?? '[]'; ?>;
    var arrEmployees = <?php echo $this->existingEmployees ?? '[]'; ?>;

    $(document).ready(function() {
        $('#description').jqte();
        $('.jqte_editor').attr('contenteditable', 'false');

        _renderReadonly('view-groups', arrGroups);
        _renderReadonly('view-roles', arrRoles);
        _renderReadonly('view-employees', arrEmployees);
    });

    function _renderReadonly(tableId, arr) {
        var html = '';
        if (arr.length === 0) {
            html = '<tr><td colspan="2" style="text-align:center; color:#999; font-style:italic;">No assignment.</td></tr>';
        } else {
            $.each(arr, function(idx, val) {
                html += '<tr><td>#' + val.target_id + '</td><td>' + val.target_name + '</td></tr>';
            });
        }
        $('#' + tableId + ' tbody').html(html);
    }
</script>