<script type="text/javascript">
    // State Arrays populated by Controller (if editing)
    var arrGroups = <?php echo $this->existingGroups ?? '[]'; ?>;
    var arrRoles = <?php echo $this->existingRoles ?? '[]'; ?>;
    var arrEmployees = <?php echo $this->existingEmployees ?? '[]'; ?>;

    $(document).ready(function() {

        try {
            $('#description').jqte();
            if ($.isFunction($.fn.select2)) {
                $('.select2').select2({
                    width: '100%'
                });
            }
        } catch (e) {
            console.log(e);
        }

        // ==============================================================
        // CUSTOM TAB LOGIC (SSOT VII.17)
        // ==============================================================
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();
            var targetPanelId = $(this).attr('href');

            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');

            $('.sf-tab-panel').removeClass('active').hide();
            $(targetPanelId).addClass('active').fadeIn('fast');
        });

        // Initial render
        renderAllTables();

        // ==============================================================
        // MASTER SUBMIT HANDLER (The "One-Shot" Save)
        // ==============================================================
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            if ($.isFunction($form.valid) && !$form.valid()) return false;

            // Pack JSON Payloads
            $('#groups_payload').val(JSON.stringify(arrGroups));
            $('#roles_payload').val(JSON.stringify(arrRoles));
            $('#employees_payload').val(JSON.stringify(arrEmployees));

            if ($.isFunction($.blockUI)) {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
                });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/reportcatalog/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if ($.isFunction($.unblockUI)) $.unblockUI();

                    if (res.result === 'saved') {
                        window.location.href = base_url + '/reportcatalog';
                    } else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').html('');

                        $.each(res, function(key, val) {
                            var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                            var errorSpan = $('#errors-' + key);
                            if (errorSpan.length > 0) {
                                errorSpan.html(errMsg).show();
                            } else {
                                $('[name="' + key + '"]').after('<span class="errors" id="errors-' + key + '">' + errMsg + '</span>');
                            }
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error occurred. Check logs.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });

    // ==============================================================
    // GENERIC ACL ARRAY MANAGEMENT
    // ==============================================================
    function addAclRow(type, selectId, targetArray) {
        var id = $('#' + selectId).val();
        var name = $.trim($('#' + selectId + ' option:selected').text());

        if (!id || id === '') {
            alert('Please select an option.');
            return;
        }

        var exists = false;
        $.each(targetArray, function(i, v) {
            if (v.target_id == id) exists = true;
        });
        if (exists) {
            alert('This ' + type + ' has already been authorized.');
            return;
        }

        targetArray.push({
            target_id: id,
            target_name: name
        });
        $('#' + selectId).val('').trigger('change.select2');
        renderAllTables();
    }

    function removeAclRow(index, type) {
        if (type === 'Group') arrGroups.splice(index, 1);
        if (type === 'Role') arrRoles.splice(index, 1);
        if (type === 'Employee') arrEmployees.splice(index, 1);
        renderAllTables();
    }

    function renderAllTables() {
        _renderGeneric('tbl-groups', arrGroups, 'Group');
        _renderGeneric('tbl-roles', arrRoles, 'Role');
        _renderGeneric('tbl-employees', arrEmployees, 'Employee');
    }

    function _renderGeneric(tableId, arr, typeStr) {
        var html = '';
        if (arr.length === 0) {
            html = '<tr><td colspan="3" style="text-align:center; color:#999; font-style:italic;">No ' + typeStr + 's assigned</td></tr>';
        } else {
            $.each(arr, function(idx, val) {
                html += '<tr><td>#' + val.target_id + '</td><td>' + val.target_name + '</td>';
                html += '<td><a class="remove-btn" onclick="removeAclRow(' + idx + ', \'' + typeStr + '\');"><i class="fa fa-trash"></i> Remove</a></td></tr>';
            });
        }
        $('#' + tableId + ' tbody').html(html);
    }
</script>