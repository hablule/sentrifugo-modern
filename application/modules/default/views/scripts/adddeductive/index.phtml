<script>
  
  var perks = [];
  $('#submit').click(function(ev) {
    var boxs = $('.check1:checked');
    var boxs2 = $('.check2:checked');
    var emp_ids = [];
    var deductive_ids = [];
    var deductive_autos = [];

    for (let index = 0; index < boxs.length; index++) {
      emp_ids.push(boxs[index].value);
    }
    for (let index2 = 0; index2 < boxs2.length; index2++) {
      deductive_ids.push(boxs2[index2].value);
    }
    for (let index3 = 0; index3 < boxs2.length; index3++) {
      deductive_autos.push(boxs2[index3].name);
    }
    if (emp_ids.length == 0 && deductive_ids.length == 0) {
      jAlert('Please Select Load and Employees');
      return false;
    }
    if (emp_ids.length == 0) {
      jAlert('Please Select Employee');
      return false;
    }
    if (deductive_ids.length == 0) {
      jAlert('Please Select Load');
      return false
    }
    var res = getphpdata('adddeductive/add', {
      emp_ids: emp_ids,
      deductive_ids: deductive_ids,
      deductive_autos: deductive_autos
    }, false, 'POST', 'json')
    res = JSON.parse(res);
    console.log(res);
    for (const key in res) {
      if (key == 'sucess') {
        console.log($('#messageData').html());
        if ($('#messageData').html() == undefined) {
          $('#dispmsgadddeductive').append(
            "<div id='messageData' class='ml-alert-1-success'><div style='display:block;'><span class='style-1-icon success'></span>" + res[key] + "</div>"
          )

        } else {

          $('#dispmsgadddeductive').append(
            "<div id='messageData' class='ml-alert-1-success'><div style='display:block;'><span class='style-1-icon success'></span>" + res[key] + "</div>"
          )
        }
        setTimeout(() => {
          $('#dispmsgadddeductive').fadeOut('slow', () => {

          })

        }, 3000)

      }
    }
    return false;
  });
  $(document).ready(function() {

    
    $("#selectAll").click(function() {
      if (this.checked) {
        $('.check1').each(function() {
          $(".check1").prop('checked', true);
        })
      } else {
        $('.check1').each(function() {
          $(".check1").prop('checked', false);
        })
      }
    });

  });
</script>

