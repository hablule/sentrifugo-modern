<script>
    document.getElementById('type').onchange = function() {
        var selected = document.getElementById('type').value;

        if (selected == 'Percentage') {
            document.getElementById('autoapprove').disabled = false;
            document.getElementById('classfun_div').style.display = 'none';
            document.getElementById('amount_label').innerHTML = 'Percentage (%)';
            document.getElementById('amount_div').style.display = 'block';
        } else if (selected == 'Fixed') {
            document.getElementById('autoapprove').disabled = false;
            document.getElementById('classfun_div').style.display = 'none';
            document.getElementById('amount_label').innerHTML = 'Amount';
            document.getElementById('amount_div').style.display = 'block';
        } else if (selected == 'Calculated') {
            document.getElementById('autoapprove').disabled = false;
            document.getElementById('amount_div').style.display = 'none';
            document.getElementById('amount_label').innerHTML = 'Amount';
            document.getElementById('classfun_div').style.display = 'block';
        } else if (selected == 'Individual' || selected == '0') {
            document.getElementById('autoapprove').selectedIndex = 0;
            document.getElementById('autoapprove').disabled = true;
            document.getElementById('classfun_div').style.display = 'none';
            document.getElementById('amount_label').innerHTML = '';
            document.getElementById('amount_div').style.display = 'none';
        } else if (selected == 'Spot' || selected == '0') {
            document.getElementById('autoapprove').selectedIndex = 0;
            document.getElementById('autoapprove').disabled = true;
            document.getElementById('classfun_div').style.display = 'none';
            document.getElementById('amount_label').innerHTML = '';
            document.getElementById('amount_div').style.display = 'none';
        }
    }



    $("#submit").click(function() {
		if (!isValid() ) {
			return false;
		} else {
            document.getElementById('autoapprove').disabled = false;

			var method = document.getElementById('classfun').value;
			var selectedFun_Name = method.split(".");
			var className = selectedFun_Name[0];
			var methodName = selectedFun_Name[1];
			
			
			if (className != 'empty') {
				var no_parameters = classes[className]['methods'][methodName]['no_args'];
				for (var i = 0; i < no_parameters; i++) {
					document.getElementById('parameters').value += document.getElementById('selected_text_' + i).value + ","
				}
			}

			return true;
		}
	});

    function isValid() {
      var valid=true;
        if (document.getElementById('amount_div').style.display == 'block') {
            if (document.getElementById('amount').value == '') {
                valid = false;
                document.getElementById('errors-amount').innerHTML = 'Field is required!';
            } else {
                var reg = /[0-9]+([.])?[0-9]+/;
                if (!reg.test(document.getElementById('amount').value)) {
                    document.getElementById('errors-amount').innerHTML = 'Use Only Numbers!';
                    valid = false;
                } else {
                    if (document.getElementById('type').value == 'Percentage') {
                        if (Number(document.getElementById('amount').value) <= 0 || Number(document.getElementById('amount').value) > 100) {
                            document.getElementById('errors-amount').innerHTML = 'Percent must be between 0 and 100';
                            valid = false;
                        }
                    }
                    if (document.getElementById('type').value == 'Fixed') {

                    }
                }

            }
        }
        if (document.getElementById('type').value == 'Calculated') {
            var method = document.getElementById('classfun').value;
            if (method == 'empty') {
                document.getElementById('errors-classfun').innerHTML = 'Please select a function!';
                valid = false;
            } else {
                var selectedFun_Name = method.split(".");
                var className = selectedFun_Name[0];
                var methodName = selectedFun_Name[1];
                var no_parameters = classes[className]['methods'][methodName]['no_args'];
                for (var i = 0; i < no_parameters; i++) {
                    if (document.getElementById("selected_text_" + i).value == "") {
                        document.getElementById("error_" + i).innerHTML = "Field is required!";
                        valid = false;
                    } else {
                        document.getElementById("error_" + i).innerHTML = '';
                    }
                }
            }
        }
        

        return valid;

    }
