<script>
    $('#description').jqte();

    <?php if ($this->popup == 'close') { ?>
        $(document).ready(function() {
            setTimeout(function() {
                // Rescue Array logic is standard, though this is likely a single-select in the Employee form
                var $parentSelect = parent.$('#employment_type_id');
                var newId = "<?php echo $this->newInsertedId; ?>";

                // Triggers Sentrifugo standard global helper for single-selects
                parent.closeiframeAddPopup("<?php echo $this->optionsHtml; ?>", "employmenttype", "employment_type_id", "Employment Type");

                if ($parentSelect.length) {
                    $parentSelect.val(newId);
                    if (parent.$.isFunction(parent.$.fn.select2)) {
                        $parentSelect.select2();
                    } else if (parent.$.isFunction(parent.$.fn.material_select)) {
                        $parentSelect.material_select();
                    }
                }
            }, 1500);
        });
    <?php } ?>
</script>