<script type="text/javascript">
	$(document).ready(function() {

		setTimeout(function() {
			$('#dispmsgmenu').fadeOut('slow');
		}, 4000);

		// 1. Data Injection from PHP
		var activeIds = <?php echo json_encode($this->activeIds); ?>;
		var modules = <?php echo json_encode($this->topLevelMenus); ?>;

		// Convert activeIds to strings for easy jQuery .inArray checking
		activeIds = $.map(activeIds, String);

		// 2. SVG Math Configuration
		var size = 600;
		var center = size / 2;
		var outerRadius = 280;
		var innerRadius = 125; // Matches the .center-circle radius

		var numSlices = modules.length;
		var sliceAngle = (Math.PI * 2) / numSlices;

		// Base URL for icons
		var mediaPath = '<?php echo MEDIA_PATH; ?>images/';

		// 3. Create SVG Element
		var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
		svg.setAttribute("width", size);
		svg.setAttribute("height", size);
		svg.setAttribute("viewBox", "0 0 " + size + " " + size);

		// Helper function to calculate X,Y on a circle
		function getCoordinates(radius, angle) {
			return {
				x: center + (radius * Math.cos(angle)),
				y: center + (radius * Math.sin(angle))
			};
		}

		// 4. Generate Slices and Icons
		$.each(modules, function(index, module) {
			var menuId = String(module.id);
			var isActive = $.inArray(menuId, activeIds) !== -1;

			// Calculate angles for this slice
			// Subtract PI/2 to start at the top (12 o'clock)
			var startAngle = (index * sliceAngle) - (Math.PI / 2);
			var endAngle = ((index + 1) * sliceAngle) - (Math.PI / 2);

			// SVG Path coordinates for outer curve
			var p1 = getCoordinates(outerRadius, startAngle);
			var p2 = getCoordinates(outerRadius, endAngle);

			// SVG Path coordinates for inner curve
			var p3 = getCoordinates(innerRadius, endAngle);
			var p4 = getCoordinates(innerRadius, startAngle);

			// Determine if arc is > 180 deg (needed for SVG path flag, rare unless < 3 modules)
			var largeArcFlag = sliceAngle > Math.PI ? 1 : 0;

			// Build the SVG Path String (Draws the slice)
			var pathData = [
				"M", p1.x, p1.y,
				"A", outerRadius, outerRadius, 0, largeArcFlag, 1, p2.x, p2.y,
				"L", p3.x, p3.y,
				"A", innerRadius, innerRadius, 0, largeArcFlag, 0, p4.x, p4.y,
				"Z"
			].join(" ");

			// Create Path Element
			var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
			path.setAttribute("d", pathData);
			path.setAttribute("class", "donut-slice " + (isActive ? "slice-active" : "slice-inactive"));
			path.setAttribute("data-id", menuId);

			// Add click event directly to the SVG slice
			$(path).on('click', function() {
				var $this = $(this);
				var clickedId = $this.attr('data-id');
				var currentlyActive = $this.hasClass('slice-active');

				if (currentlyActive) {
					// Deactivate
					$this.removeClass('slice-active').addClass('slice-inactive');
					$('#icon-' + clickedId).removeClass('icon-active').addClass('icon-inactive');
					activeIds = $.grep(activeIds, function(value) {
						return value != clickedId;
					});
				} else {
					// Activate
					$this.removeClass('slice-inactive').addClass('slice-active');
					$('#icon-' + clickedId).removeClass('icon-inactive').addClass('icon-active');
					if ($.inArray(clickedId, activeIds) === -1) activeIds.push(clickedId);
				}

				// Update hidden form field and show save button
				$('#chk_menu').val(activeIds.join(','));
				$('#savebuttondiv').css('display', 'flex'); // Flex to keep buttons centered
			});

			svg.appendChild(path);

			// --- Calculate Icon Position (Middle of the slice) ---
			var midAngle = startAngle + (sliceAngle / 2);
			// Place icon at exactly the midpoint between inner and outer radius
			var iconRadius = innerRadius + ((outerRadius - innerRadius) / 2);
			var iconPos = getCoordinates(iconRadius, midAngle);

			// Build HTML overlay for Icon and Text
			var iconSrc = module.iconPath ? (mediaPath + module.iconPath) : (mediaPath + 'menuIcons/default.png');
			var iconStateClass = isActive ? "icon-active" : "icon-inactive";

			var overlayHtml = '<div class="module-icon-container" style="left:' + iconPos.x + 'px; top:' + iconPos.y + 'px;">';
			overlayHtml += '<img id="icon-' + menuId + '" class="' + iconStateClass + '" src="' + iconSrc + '" onerror="this.style.display=\'none\'" />';
			overlayHtml += '<div class="module-label">' + module.menuName + '</div>';
			overlayHtml += '</div>';

			$('#svg-container').append(overlayHtml);
		});

		// 5. Append SVG to Container
		// Make sure SVG is the first child so HTML overlays sit on top
		$('#svg-container').prepend(svg);

		// Initialize hidden field
		$('#chk_menu').val(activeIds.join(','));
	});
</script>