<script>
    var leaves = [];
    var leaveData = [];
    var selectedLeaveIndex = -1;
    $(document).ready(function() {
        console.log("kkk");
        leaves = `<?php echo json_encode($this->leaves); ?>`;
        leaves = JSON.parse(leaves);
        <?php if (count($this->messages)) { ?>
            setTimeout(function() {
                $('#dispmsgempleaves').fadeOut('slow');
            }, 3000);

        <?php } ?>
        leaveData = `<?php echo json_encode($this->leaveData); ?>`;
        leaveData = JSON.parse(leaveData);
        console.log(leaveData);
        console.log(leaves);
        leaves.forEach(leaveSelect);
        leaveBasedAction();
    });


    function leaveSelect(item, index) {
        if (item['leave_id'] == document.getElementById('leave').value) {
            selectedLeaveIndex = index;
        }
    }

    function leaveBasedAction() {
        if (selectedLeaveIndex != -1) {
            if (leaves[selectedLeaveIndex]['baseperiod'] == 'Yearly') {
                document.getElementById('year_div').style.display = 'block';
                document.getElementById('period_div').style.display = 'none';

            } else if (leaves[selectedLeaveIndex]['baseperiod'] == 'Periodic') {
                document.getElementById('year_div').style.display = 'block';
                document.getElementById('period_div').style.display = 'block';
                if (leaveData.length > 0) {
                    if (leaveData[0]['leave_id'] == leaves[selectedLeaveIndex]['leave_id']) {
                        displayParticularPeriod_normal(document.getElementById('year'), "", "period", "");
                        document.getElementById('period').value = leaveData[0]['period_id'];

                        console.log(document.getElementById('period').value + "value");
                    }
                }
            }

            if (leaves[selectedLeaveIndex]['durationtype'] == 'Individual') {
                document.getElementById('alloted_days').innerHTML = "";
                document.getElementById('alloted_days_div').style.display = 'block'
                if (leaveData.length > 0) {
                    if (leaveData[0]['leave_id'] == leaves[selectedLeaveIndex]['leave_id']) {
                        document.getElementById('alloted_days').value = leaveData[0]['alloteddays'];
                    }
                }
            } else {
                document.getElementById('alloted_days').innerHTML = "";
                document.getElementById('alloted_days_div').style.display = 'none'
            }
        }
    }
  
</script>