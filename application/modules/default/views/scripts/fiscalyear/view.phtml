<script type="text/javascript">
    // Load existing periods from controller
    var arrPeriods = <?php echo isset($this->existingPeriods) ? $this->existingPeriods : '[]'; ?>;

    $(document).ready(function() {
        $('#description').jqte();
        $('.jqte_editor').attr('contenteditable', 'false'); // Lock WYSIWYG for view mode

        renderReadOnlyPeriods();
    });

    function renderReadOnlyPeriods() {
        var html = '';
        if (arrPeriods.length === 0) {
            html = '<tr><td colspan="6" style="text-align:center; color:#999;">No periods found for this Fiscal Year.</td></tr>';
        } else {
            $.each(arrPeriods, function(idx, val) {
                var statusText = val.isactive == 1 ? '<span style="color:green;">Active</span>' : '<span style="color:red;">Inactive</span>';
                var seqVal = val.sequence !== undefined ? val.sequence : (val.period_sequence || '0');

                html += '<tr>';
                html += '<td>' + seqVal + '</td>'; // Fixed sequence bug here too
                html += '<td>' + val.name + '</td>';
                html += '<td>' + val.start_date + '</td>';
                html += '<td>' + val.end_date + '</td>';
                html += '<td>' + statusText + '</td>';

                // The Goto Action Button
                html += '<td style="text-align:center;">';
                if (val.id > 0) {
                    html += '<a href="' + base_url + '/period/edit/id/' + val.id + '" target="_blank" style="color: #26a69a; text-decoration: none; font-size: 16px;" title="Go to Period Controls"><i class="fa fa-external-link"></i></a>';
                }
                html += '</td>';

                html += '</tr>';
            });
        }
        $('#tbl-periods-view tbody').html(html);
    }
</script>