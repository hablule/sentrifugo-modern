$activeTab = isset($this->activeTab) ? $this->activeTab : 'active_pipelines';
?>
<style>
	.summary-dashboard-tabs {
		display: flex;
		gap: 10px;
		margin-bottom: 20px;
	}

	.summary-tab-card {
		flex: 1;
		padding: 15px 20px;
		border-radius: 4px;
		text-decoration: none;
		border: 1px solid #eee;
		background: #fff;
		transition: 0.2s;
		position: relative;
	}

	.summary-tab-card:hover {
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
