	.summary-tab-card.active {
		border-top: 3px solid #26a69a;
		background: #fdfdfd;
	}

	.summary-tab-card.action-tab.active {
		border-top-color: #e67e22;
	}

	.summary-tab-card.archive-tab.active {
		border-top-color: #7f8c8d;
	}

	.tab-title {
		font-size: 13px;
		font-weight: bold;
		color: #555;
		display: block;
		margin-bottom: 5px;
	}

	.tab-desc {
		font-size: 11px;
		color: #888;
	}
</style>

<!-- Dashboard Summary Tabs -->
<?php if ($this->call !== 'ajaxcall') : ?>
    <div class="summary-dashboard-tabs">
        <a href="<?php echo BASE_URL; ?>requisition/index/status_filter/active_pipelines" class="summary-tab-card <?php echo ($activeTab === 'active_pipelines') ? 'active' : ''; ?>">
            <span class="tab-title" style="color: #26a69a;">
                <i class="fa fa-briefcase"></i> Active Pipelines 
                <span class="badge" style="background:#26a69a; color:#fff; float:right; border-radius:50%; padding:2px 8px;"><?php echo $this->tabCounts['active_pipelines']; ?></span>
            </span>
            <span class="tab-desc">Approved campaigns open for sourcing and interviews.</span>
        </a>
        <a href="<?php echo BASE_URL; ?>requisition/index/status_filter/action_required" class="summary-tab-card action-tab <?php echo ($activeTab === 'action_required') ? 'active' : ''; ?>">
            <span class="tab-title" style="color: #e67e22;">
                <i class="fa fa-clock-o"></i> Action Required
                <span class="badge" style="background:#e67e22; color:#fff; float:right; border-radius:50%; padding:2px 8px;"><?php echo $this->tabCounts['action_required']; ?></span>
            </span>
            <span class="tab-desc">Drafts being constructed and requests awaiting sign-off.</span>
        </a>
        <a href="<?php echo BASE_URL; ?>requisition/index/status_filter/concluded" class="summary-tab-card archive-tab <?php echo ($activeTab === 'concluded') ? 'active' : ''; ?>">
            <span class="tab-title" style="color: #7f8c8d;">
                <i class="fa fa-archive"></i> Concluded Archive
                <span class="badge" style="background:#7f8c8d; color:#fff; float:right; border-radius:50%; padding:2px 8px;"><?php echo $this->tabCounts['concluded']; ?></span>
            </span>
            <span class="tab-desc">Historical record of filled campaigns and rejected requests.</span>
        </a>
    </div>
<?php endif; ?>

<!-- Flash Messages -->
<div id="message_container">
	<?php if (isset($this->messages) && !empty($this->messages)) : ?>
		<div id="dispmsg" class="settingssuccess">
			<?php foreach ($this->messages as $message) : $key = key($message); ?>
				<div class="ml-alert-1-<?php echo $key; ?>">
					<div style="display:block;"><span class="style-1-icon <?php echo $key; ?>"></span><?php echo $this->escape($message[$key]); ?></div>
				</div>
			<?php endforeach; ?>
		</div>
	<?php endif; ?>
</div>

<div id="error_message" style="display:none;"></div>

<?php if (isset($this->call) && $this->call === 'ajaxcall') : ?>
	<?php echo $this->grid($this->dataArray[0]); ?>
<?php else : ?>
	<div id="grid_<?php echo $this->escape($this->dataArray[0]['objectname']); ?>" class="all-grid-control">
		<div id="msg" style="display:none; font-style: oblique; font-weight: bold; color: green;"></div>
		<?php echo $this->grid($this->dataArray[0]); ?>
	</div>
<?php endif; ?>

<script type="text/javascript">
	$(document).ready(function() {
		setTimeout(function() {
			$('#dispmsg').fadeOut('slow');
		}, 4000);
	});
</script>