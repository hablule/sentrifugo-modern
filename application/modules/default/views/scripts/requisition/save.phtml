<script type="text/javascript">
    var arrPositions = <?php echo isset($this->existingPositions) ? $this->existingPositions : '[]'; ?>;
    var activeSeatIdx = null;

    $(document).ready(function() {
        $('#description').jqte();
        renderSeatsGrid();

        // Initialize DatePicker
        $('#seat_target_hire_date').datepicker({
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            changeMonth: true,
            changeYear: true
        });

        // Initialize Status Dialog
        $("#statusModalContainer").dialog({
            autoOpen: false,
            width: 520, // Clean, comfortable width
            modal: true,
            resizable: false,
            title: "Update Seat Pipeline Status"
        });

        // Handle Seat Status Transition Submission via AJAX
        $('#btn_submit_status').click(function(e) {
            e.preventDefault();

            var mapId = $('#map_req_pos_id').val();
            var status = $('#statusModalContainer #status').val();
            var reasonId = $('#status_reason_id').val();
            var empId = $('#filled_by_employee_id').val();
            var notes = $('#notes').val();

            if (!status || !reasonId) {
                alert("Please select a Status and a Transition Reason.");
                return;
            }

            if (status === 'Filled' && !empId) {
                alert("Please select the candidate who was hired for this seat.");
                return;
            }

            $.ajax({
                url: base_url + '/requisition/updatestatus/format/json',
                type: 'POST',
                data: {
                    map_req_pos_id: mapId,
                    status: status,
                    status_reason_id: reasonId,
                    filled_by_employee_id: empId,
                    notes: notes
                },
                dataType: 'json',
                success: function(res) {
                    if (res.result === 'saved') {
                        // Update state in memory & refresh grid
                        arrPositions[activeSeatIdx].status = status;
                        renderSeatsGrid();
                        $("#statusModalContainer").dialog('close');
                    } else {
                        alert(res.message || "Error updating status.");
                    }
                },
                error: function() {
                    alert("Server error during status update.");
                }
            });
        });

        // Master Form AJAX Submission
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();

            if (!$form.valid()) {
                return false;
            }

            $('#positions_payload').val(JSON.stringify(arrPositions));

            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Saving..." />'
                });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/requisition/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/requisition';
                    } else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else if (response && typeof response === 'object') {
                        $.each(response, function(fieldId, errorMsg) {
                            $('#errors-' + fieldId).text(errorMsg);
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        });
    });

    function openStatusModal(idx) {
        activeSeatIdx = idx;
        var item = arrPositions[idx];

        // 1. Populate Header Context Banner
        $('#modal_seat_name').text(item.position_code);

        // 2. Populate form fields
        $('#map_req_pos_id').val(item.id);
        $('#statusModalContainer #status').val(item.status);
        $('#status_reason_id').val('');
        $('#filled_by_employee_id').val('');
        $('#notes').val('');

        toggleFilledEmployeeField();
        $("#statusModalContainer").dialog('open');
    }

    function toggleFilledEmployeeField() {
        var status = $('#statusModalContainer #status').val();
        if (status === 'Filled') {
            $('#wrapper_filled_emp').slideDown();
        } else {
            $('#wrapper_filled_emp').slideUp();
        }
    }

    function addPositionRow() {
        var posId = $('#seat_position_id').val();
        var posText = $('#seat_position_id option:selected').text();
        var fte = $('#seat_target_fte').val();
        var date = $('#seat_target_hire_date').val();
        var status = $('#seat_pipeline_status').val() || 'Targeted';

        if (!posId || !fte || !date) {
            alert("Please select a Position Seat, specify Target FTE, and select a Target Onboard Date.");
            return;
        }

        arrPositions.push({
            id: 0,
            position_id: parseInt(posId),
            position_code: posText,
            target_fte: parseFloat(fte),
            target_hire_date: date,
            status: status,
            action: 'new'
        });

        renderSeatsGrid();
    }

    function removePositionRow(idx) {
        if (arrPositions[idx].id > 0) {
            arrPositions[idx].action = 'delete';
        } else {
            arrPositions.splice(idx, 1);
        }
        renderSeatsGrid();
    }

    function renderSeatsGrid() {
        var html = '';
        var activeCount = 0;

        $.each(arrPositions, function(idx, item) {
            if (item.action === 'delete') return true;

            activeCount++;
            html += '<tr>';
            html += '<td><strong>' + item.position_code + '</strong></td>';
            html += '<td>' + item.target_fte + '</td>';
            html += '<td>' + item.target_hire_date + '</td>';
            html += '<td><span class="badge" style="background:#26a69a; color:#fff; border-radius:3px; padding:3px 8px; font-size:11px;">' + item.status + '</span></td>';

            html += '<td style="text-align:center;">';
            // Only allow status transition modal if the seat has already been persisted to DB (id > 0)
            if (item.id > 0) {
                html += '<a class="btn-table-action status" onclick="openStatusModal(' + idx + ');" title="Update Pipeline Status"><i class="fa fa-pencil-square-o"></i></a>';
            }
            html += '<a class="btn-table-action delete" onclick="removePositionRow(' + idx + ');" title="Remove Seat"><i class="fa fa-trash"></i></a>';
            html += '</td>';

            html += '</tr>';
        });

        if (activeCount === 0) {
            html = '<tr><td colspan="5" style="text-align:center; color:#999; padding:15px;">No position seats attached to this campaign yet. Use the tool above to add seats.</td></tr>';
        }

        $('#tbl-seats tbody').html(html);
    }
</script>