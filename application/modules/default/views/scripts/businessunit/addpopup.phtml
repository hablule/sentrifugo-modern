        <div class="style-1-icon success"></div>
        Business Unit added successfully. Closing...
    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            var optionsHtml = '<?php echo $this->escape(isset($this->optionsHtml) ? $this->optionsHtml : ''); ?>';
            var prevCntrl = '<?php echo $this->escape(isset($this->prev_cntrl) ? $this->prev_cntrl : 'businessunit'); ?>';

            setTimeout(function() {
                // SSOT v6.4 "On-The-Fly" Popup Pattern closure
                if (typeof parent.closeiframeAddPopup === 'function') {
                    // Update dropdown in parent window and close modal
                    parent.closeiframeAddPopup(optionsHtml, prevCntrl, 'businessunit_id', 'Business Unit');
                } else {
                    // Fallback close if parent doesn't have the handler
                    parent.$('#businessunitContainer').dialog('close');
                }
            }, 1500);
        });
    </script>

