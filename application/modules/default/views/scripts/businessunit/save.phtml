<script type="text/javascript">
    $(document).ready(function() {
        // Initialize WYSIWYG
        $('#description').jqte();
        
        // Initialize DatePicker
        $('#startdate').datepicker({
            showOn: 'both',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            changeMonth: true,
            changeYear: true
        });

        // AJAX Cascading Dropdowns for Location
        $('#country').change(function() {
            var countryId = $(this).val();
            $('#state').html('<option value="">Select State / Province</option>');
            $('#city').html('<option value="">Select City</option>');
            
            if (countryId) {
                if (typeof $.blockUI === "function") $('#state').parent().block({ message: null });

                $.ajax({
                    url: base_url + '/states/getstatepairs',
                    type: 'POST',
                    data: { country_id: countryId },
                    dataType: 'json',
                    success: function(response) {
                        var options = '<option value="">Select State / Province</option>';
                        if (response && !$.isEmptyObject(response)) {
                            $.each(response, function(key, value) {
                                // Handle both SSOT flat objects and legacy arrays
                                var optVal = (typeof value === 'object') ? (value.id || key) : key;
                                var optText = (typeof value === 'object') ? (value.state_name || value.name) : value;
                                options += '<option value="' + optVal + '">' + optText + '</option>';
                            });
                        }
                        $('#state').html(options);
                    },
                    complete: function() {
                        if (typeof $.unblockUI === "function") $('#state').parent().unblock();
                    }
                });
            }
        });

        $('#state').change(function() {
            var stateId = $(this).val();
            $('#city').html('<option value="">Select City</option>');
            
            if (stateId) {
                if (typeof $.blockUI === "function") $('#city').parent().block({ message: null });

                $.ajax({
                    url: base_url + '/cities/getcitypairs',
                    type: 'POST',
                    data: { state_id: stateId },
                    dataType: 'json',
                    success: function(response) {
                        var options = '<option value="">Select City</option>';
                        if (response && !$.isEmptyObject(response)) {
                            $.each(response, function(key, value) {
                                var optVal = (typeof value === 'object') ? (value.id || key) : key;
                                var optText = (typeof value === 'object') ? (value.city_name || value.name) : value;
                                options += '<option value="' + optVal + '">' + optText + '</option>';
                            });
                        }
                        $('#city').html(options);
                    },
                    complete: function() {
                        if (typeof $.unblockUI === "function") $('#city').parent().unblock();
                    }
                });
            }
        });

        // --- SSOT v6.5 EXPLICIT AJAX SUBMIT HANDLER ---
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault(); 
            var $form = $('#formid');
            
            // 1. Clear previous errors
            $('.errors').text('');
            $('#message_container').empty();

            // 2. Standard Client Validations
            if (!$form.valid()) { 
                return false; 
            }
            
            // 3. Custom Poly-Hierarchical Validation
            var companyParent = $('#company_id').val();
            var sbuParent = $('#parent_id').val();
            var parentCount = 0;
            if (companyParent && companyParent !== '') parentCount++;
            if (sbuParent && sbuParent !== '') parentCount++;

            if (parentCount === 0 || parentCount > 1) {
                var errorMsg = (parentCount > 1) 
                    ? 'A Business Unit can only have one parent. Please clear one selection.'
                    : 'A Business Unit must have a parent. Please select one.';
                
                $('#errors-company_id').text(errorMsg);
                $('#errors-parent_id').text(errorMsg);
                $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                $('html, body').animate({ scrollTop: 0 }, 'slow');
                return false; 
            }

            // 4. Block UI
            if (typeof $.blockUI === "function") {
                $.blockUI({ message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />' });
            }

            // 5. Build FormData (Handles files natively)
            var formData = new FormData($form[0]);

            // 6. Explicit AJAX Call
            $.ajax({
                url: base_url + '/businessunit/save/format/json',
                type: 'POST',
                data: formData,
                processData: false, 
                contentType: false, 
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    // Success Routing
                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/businessunit';
                    } 
                    // Server Exception Routing
                    else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({ scrollTop: 0 }, 'slow');
                    } 
                    // Zend Form Validation Error Routing
                    else if (response && typeof response === 'object') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        
                        $.each(response, function(fieldId, errorObj) {
                            var errMsg = (typeof errorObj === 'object') ? errorObj[Object.keys(errorObj)[0]] : errorObj;
                            $('#errors-' + fieldId).text(errMsg);
                        });
                        
                        $('html, body').animate({ scrollTop: 0 }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>A critical server error occurred. Check logs.</div>');
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                }
            });
        });
    });
</script>