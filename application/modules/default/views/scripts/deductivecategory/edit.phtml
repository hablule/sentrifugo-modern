<script>
$('#description_cat').jqte();
    function isValid(elements) {
        var valid = true;
        for (var key in elements) {
            for (var key1 in elements[key]) {
                if (key1 == 'isEmpty') {
                    if (document.getElementById(key).value == '') {
                        document.getElementById('errors-' + key).innerHTML = elements[key][key1];
                        valid = false;
                    }
                } else if (key1 == 'onlyNumber') {

                    var reg = /^\d+(\.\d+)?$/;
                    if (!(reg.test(document.getElementById('rate').value))) {
                        valid = false
                        document.getElementById('errors-' + key).innerHTML = elements[key][key1];
                    }

                } else if (key1 == 'other') {
                    for (var key2 in elements[key][key1]) {
                        if (document.getElementById(key).value == key2) {
                            document.getElementById('errors-' + key).innerHTML = elements[key][key1][key2];
                            valid = false;
                        }
                    }
                }
            }
        }
        return valid;
    }

</script>