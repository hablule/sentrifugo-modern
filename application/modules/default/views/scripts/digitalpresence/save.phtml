<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();

        if ($.isFunction($.fn.select2)) {
            $('select').select2({
                width: '100%'
            });
        }

        // UX Enhancement: Auto-clear other owner dropdowns if one is selected
        // This helps users comply with the "Exactly One Owner" integrity rule
        var ownerDropdowns = ['#company_id', '#sbunit_id', '#division_id', '#department_id', '#section_id', '#project_id', '#team_id', '#employee_id'];

        $(ownerDropdowns.join(', ')).on('change', function() {
            var selectedId = $(this).attr('id');
            if ($(this).val() !== '') {
                $.each(ownerDropdowns, function(index, value) {
                    if (value !== '#' + selectedId) {
                        $(value).val('').trigger('change.select2'); // clear others
                    }
                });
            }
        });
    });
</script>