		<script type='text/javascript'>
			$("#description").jqte();
			$("#summaryofcourse").jqte();

			$(document).ready(function() {
				//To get the Calender image...
				hideselectortext('institution_name', 'institution');
				hideselectortext('studyfield_name', 'studyfield');
				//var yearrange = <?php echo "'" . date("Y", strtotime("-30 years")) . ':' . date('Y') . "'"; ?>;
				var yearrange = <?php echo "'" . YEAR . ':' . date('Y') . "'"; ?>;
				$('#from_date,#to_date').datepicker({
					showOn: 'both',
					maxDate: new Date,
					yearRange: yearrange,
					dateFormat: "<?php echo DATEFORMAT_JS; ?>",
					buttonImage: "<?php echo $this->baseUrl("public/media/images/cal.jpg"); ?>",
					buttonImageOnly: true,
					buttonText: "",
					changeMonth: true,
					changeYear: true,
					showButtonPanel: true,
					onClose: function() {
						$(this).trigger('blur');
						var msg = "";
						if (this.id == 'to_date')
							msg = "To date should be greater than from date.";
						else
							msg = "From date should be less than to date.";
						from_to_date_validation('from_date', 'to_date', this, msg);
					}
				});
				var btnUpload = $('#org_image');
				new AjaxUpload(btnUpload, {
					action: base_url + '/educationdetails/uploadpreview',
					name: 'profile_photo', //we can rename it 
					dataType: 'json',
					onSubmit: function(file, ext) {
						if ($("#errors-attestation_image_value").is(":visible"))
							$("#errors-attestation_image_value").hide();
						$("#orgloaderimg").show();
					},
					onComplete: function(file, response) {
						var result = JSON.parse(response);
						if (result.result == 'success') {
							$('#errors-attestation_image_value').html('');
							$('#imgerr').val(result.result);
							$("#imgerrmsg").val(result.msg);
							$("#errors-attestation_image_value").css('display', 'block');
							$("#attestation_image_value").val(result.img);
							$('.org-img').html('<img src="' + domain_data + '/public/uploads/educationpreview/' + result.img + '" /><div id="org_image" class="caption uploadbut-org" style="top: -35px; display: none;">Upload image</div>');
							$("#orgloaderimg").hide();


						} else {
							$('.uploaderror').show();
							$("#errors-attestation_image_value").css('display', 'block');
							$('#errors-attestation_image_value').html(result.msg);
							$('#imgerr').val(result.result);
							$("#imgerrmsg").val(result.msg);
							$("#orgloaderimg").hide();
							setTimeout(function() {
								$('.uploaderror').fadeOut('slow');
							}, 3000);
						}
					}
				}, 'json');
			});
		</script>
	<?php } ?>
