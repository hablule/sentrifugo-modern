<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();

        // Linked Datepickers
        $('#start_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#end_date").datepicker("option", "minDate", selectedDate);
            }
        });

        $('#end_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#start_date").datepicker("option", "maxDate", selectedDate);
            }
        });

        if ($('#start_date').val() !== '') {
            $("#end_date").datepicker("option", "minDate", $('#start_date').val());
        }
        if ($('#end_date').val() !== '') {
            $("#start_date").datepicker("option", "maxDate", $('#end_date').val());
        }

        // Initialize Materialize Timepicker Popup for Shift Hours
        if ($.isFunction($.fn.timepicker)) {
            $('#start_time, #end_time').timepicker({
                twelveHour: false, // 24-Hour Military Format per SSOT
                autoclose: false,
                vibrate: true,
                afterDone: function() {
                    var val = $(this).val();
                    if (val && val.length === 5) {
                        $(this).val(val + ':00'); // Ensure HH:MM:SS format
                    }
                }
            });
        }


        // SSOT v6.7.7 Balanced Explicit AJAX Submit with Conflict Warning Interception
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            submitHolidayDateForm(0); // Initial save attempt (force_save = 0)
        });

        function submitHolidayDateForm(forceSave) {
            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();

            if (!$form.valid()) {
                return false;
            }

            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Saving..." />'
                });
            }

            var formData = new FormData($form[0]);
            formData.append('force_save', forceSave);

            $.ajax({
                url: base_url + '/holidaydate/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    // 1. Success -> Redirect
                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/holidaydate';
                    }
                    // 2. Conflict Warning Interception (Phase 7)
                    else if (response && response.result === 'conflict_warning') {
                        var warningText = "⚠️ Holiday Overlap Detected:\n\n";
                        $.each(response.conflicts, function(i, c) {
                            warningText += "• " + c.message + "\n";
                        });
                        warningText += "\nDo you wish to acknowledge this conflict and save anyway?";

                        if (confirm(warningText)) {
                            // User confirmed -> Resubmit with force_save = 1
                            submitHolidayDateForm(1);
                        }
                    }
                    // 3. Exception
                    else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                    // 4. Form Validation Errors
                    else if (response && typeof response === 'object') {
                        $.each(response, function(fieldId, errorObj) {
                            var errMsg = (typeof errorObj === 'object') ? errorObj[Object.keys(errorObj)[0]] : errorObj;
                            $('#errors-' + fieldId).text(errMsg);
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        }
    });
</script>