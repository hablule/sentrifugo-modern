<?php 
$options_data = "";
  $options_data .= sapp_Global::selectOptionBuilder('', 'Select Period');  
if(!empty($this->periodsmodeldata))
{
	if($this->con == 'period')
	{
		foreach ($this->periodsmodeldata as $period) {
			$options_data .= sapp_Global::selectOptionBuilder($period['period_id'], utf8_encode($period['name']));
		}
		$options_data .= "</optgroup>";
		echo $options_data;
	}
	else
	{
		foreach ($this->periodsmodeldata as $period) {
			$options_data .= sapp_Global::selectOptionBuilder($period['period_id'], utf8_encode($period['name']));
		}
		if($this->con == 'otheroption')
		{
		 $options_data .= sapp_Global::selectOptionBuilder('other','Other');
		}
		echo $options_data;
	}
}
else
{
 echo "noperiods";
}	
