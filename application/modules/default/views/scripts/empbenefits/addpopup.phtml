    function createElement(id, amount) {
		if (document.getElementById(id + '_amount')) {

		} else {
			var container = document.getElementById('amount_div');
			var main_div = document.createElement('div');
			main_div.setAttribute('id', id + '_div')
			var div = document.createElement('div');
			div.setAttribute('class', 'new-form-ui');
			var inner_div = document.createElement('div');
			inner_div.setAttribute('class', 'division');
			var label = document.createElement('label');
			label.innerHTML = perks[id]['code'] + ' Amount';
			label.setAttribute('id', id + '_label');
			var textfield = document.createElement('input');
			textfield.setAttribute('type', 'text');
			textfield.setAttribute('id', id + '_amount');
			textfield.value = amount;
			container.appendChild(main_div);
			main_div.appendChild(div);
			div.appendChild(label);
			div.appendChild(inner_div);
			inner_div.appendChild(textfield);
		
		}

	}
