<div class="row">
    <div class="col s12">
        
        <div id="message_container">
            <?php if (isset($this->nodata)) : ?>
                <div class="ml-alert-1-info">
                    <div style="display:block;">
                        <span class="style-1-icon info"></span>
                        No data found.
                    </div>
                </div>
            <?php endif; ?>
        </div>

        <?php if (!isset($this->nodata)) : ?>
            <div class="total-form-controller">
                <div class="division">
                    
                    <!-- Gender Name -->
                    <div class="new-form-ui clearb">
                        <label><?php echo $this->escape($this->form->name->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->name; ?>
                        </div>
                    </div>

                    <!-- Gender Code -->
                    <div class="new-form-ui clearb">
                        <label><?php echo $this->escape($this->form->code->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->code; ?>
                        </div>
                    </div>

                    <!-- Description -->
                    <?php echo sapp_Helper::sd_form_helper($this->msgarray ?? array(), $this->form, 'description', '', 'fck_editor_height', '', array()); ?>

                    <!-- Active Status -->
                    <div class="new-form-ui clearb">
                        <label><?php echo $this->escape($this->form->isactive->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->isactive; ?>
                        </div>
                    </div>

                    <!-- Navigation & Actions -->
                    <div class="new-form-ui-submit">
                        <div class="division">
                            <input onclick="window.location.href='<?php echo BASE_URL; ?>gender';" value="Back to List" type="button" class="reset" />
                            
                            <?php 
                            // Verify Edit Privilege
                            $menuId = defined('GENDER_MENU_ID') ? GENDER_MENU_ID : 86;
                            if (sapp_Global::_checkprivileges($menuId, $this->loginuserGroup, $this->loginuserRole, 'edit') == 'Yes') : 
                            ?>
                                <input onclick="window.location.href='<?php echo BASE_URL; ?>gender/edit/id/<?php echo $this->id; ?>';" value="Edit" type="button" class="reset" />
                            <?php endif; ?>
                        </div>
                    </div>

                </div>
            </div>
        <?php endif; ?>
        
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        // Initialize Rich Text Editor and lock it down for View Mode
        if ($('#description').length) {
            $('#description').jqte();
            $('.jqte_editor').attr('contenteditable', 'false'); 
        }
    });
</script>