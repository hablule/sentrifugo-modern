function toggleSelect()
{
	var status;
  var isChecked = document.getElementById("isdependent").checked;
  if(isChecked){
	$("#custody").parent().parent().css("display","block");
  }
  if(!isChecked){
	$("#custody").parent().parent().css("display","none");
  }

}
</script>
