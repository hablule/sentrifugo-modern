<script>
$('.check').change(function(ev) {
    var checkedboxes = $('.check:checked');
   
    console.log($('.check').prop('checked'));
    
    if(checkedboxes.length == 0)
    {
        document.getElementById('submitBtn').hidden = true;
    }
    else
    {
        document.getElementById('submitBtn').hidden = false;
    }
});
$('#submitBtn').click(function(ev){
    var boxs = $('.check:checked');
    var req_id = $('#req').val();
    var ids = [];
  for (let index = 0; index < boxs.length; index++) {
      ids.push(boxs[index].value);
      
  }
  console.log(req_id);
  $.ajax({
        url:base_url+'/list/selected',
        type:'POST',
        dataType: 'json',
        data:{'ids':ids,'req_id':req_id}

  });
})
</script>