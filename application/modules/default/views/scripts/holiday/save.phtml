<!-- JavaScript Logic & Timepicker Initialization                                   -->
<!-- ============================================================================== -->

<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();

        // Initialize Materialize Timepicker Popup for Shift Hours
        if ($.isFunction($.fn.timepicker)) {
            $('#start_time, #end_time').timepicker({
                twelveHour: false, // 24-Hour Military Format per SSOT
                autoclose: false,
                vibrate: true,
                afterDone: function() {
                    var val = $(this).val();
                    if (val && val.length === 5) {
                        $(this).val(val + ':00'); // Ensure HH:MM:SS format
                    }
                }
            });
        }

        // Tab Switching Logic
        $('.holiday-tabs .tab-link').on('click', function(e) {
            e.preventDefault();
            switchTab($(this).data('tab'));
        });

        function switchTab(tabId) {
            $('.holiday-tabs .tab-link').removeClass('active');
            $('a[data-tab="' + tabId + '"]').addClass('active');

            $('.tab-content-panel').hide();
            $('#' + tabId).fadeIn(150);
        }

        // SSOT Explicit AJAX Handler with Tab-Aware Error Navigation
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();
            $('.holiday-tabs a').removeClass('has-error');

            // Pack Criteria from Tab 2
            if (typeof arrCriteria !== 'undefined') {
                $('#criteria_payload').val(JSON.stringify(arrCriteria));
            } else {
                $('#criteria_payload').val('[]');
            }

            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Saving..." />'
                });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/holiday/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/holiday';
                    } else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else if (response && typeof response === 'object') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please correct the highlighted errors.</div>');

                        var firstErrorTab = null;

                        $.each(response, function(fieldId, errorMsg) {
                            $('#errors-' + fieldId).text(errorMsg);

                            var $field = $('#' + fieldId);
                            var $tabPanel = $field.closest('.tab-content-panel');
                            if ($tabPanel.length) {
                                var tabId = $tabPanel.attr('id');
                                $('a[data-tab="' + tabId + '"]').addClass('has-error');

                                if (!firstErrorTab) {
                                    firstErrorTab = tabId;
                                }
                            }
                        });

                        if (firstErrorTab) {
                            switchTab(firstErrorTab);
                        }

                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error during save.</div>');
                }
            });
        });
    });

    function setFullDayHours() {
        $('#start_time').val('00:00:00');
        $('#end_time').val('23:59:59');
        $('#duration_days').val('1.00');
    }
</script>