<script type="text/javascript">
    var arrCriteria = <?php echo isset($this->existingCriteria) ? $this->existingCriteria : '[]'; ?>;
    $(document).ready(function() {
        var html = '';
        if (arrCriteria.length === 0) {
            html = '<tr><td colspan="4" style="text-align:center; padding:10px; color:#999;">Applies globally to all employees.</td></tr>';
        } else {
            $.each(arrCriteria, function(i, item) {
                html += '<tr style="border-bottom:1px solid #eee;">';
                html += '<td style="padding:8px;">Group ' + item.group_id + '</td>';
                html += '<td style="padding:8px;">' + item.criteria_type + '</td>';
                html += '<td style="padding:8px;">' + item.criteria_value + '</td>';
                html += '<td style="padding:8px;">' + item.match_type + '</td>';
                html += '</tr>';
            });
        }
        $('#tbl-criteria-view tbody').html(html);
    });
</script>