            var optionsHtml = '<?php echo $this->escape(isset($this->identity_data) ? $this->identity_data : ''); ?>';
            var prevCntrl = '<?php echo $this->escape(isset($this->prev_cntrl) ? $this->prev_cntrl : 'identitycodes'); ?>';

            setTimeout(function() {
                // SSOT v6.2 "On-The-Fly" Popup Pattern closure
                if (typeof parent.closeiframeAddPopup === 'function') {
                    parent.closeiframeAddPopup(optionsHtml, prevCntrl, 'identity_codes', 'Identity Codes Updated');
