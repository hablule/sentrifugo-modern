                    $orgField = '';
                    $orgVal = $this->form->org_type->getValue();
                    if ($orgVal === 'Company') $orgField = $this->form->company_id;
                    elseif ($orgVal === 'BusinessUnit') $orgField = $this->form->businessunit_id;
                    elseif ($orgVal === 'Division') $orgField = $this->form->division_id;
                    elseif ($orgVal === 'Department') $orgField = $this->form->department_id;
                    elseif ($orgVal === 'Section') $orgField = $this->form->section_id;
                    elseif ($orgVal === 'Team') $orgField = $this->form->team_id;
                    ?>
                    <?php if ($orgField) : ?>
                        <div class="new-form-ui clearb"><label>Assigned Unit</label>
                            <div class="division"><?php echo $orgField; ?></div>
