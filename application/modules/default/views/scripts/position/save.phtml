<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();
        toggleOrgOwnerDropdowns(); // Initialize visibility on load
    });

    // SSOT VII.22 Dynamic Wrapper Toggler: Ensures only 1 Org Unit dropdown is visible and clears others
    function toggleOrgOwnerDropdowns() {
        var selectedType = $('#org_type').val();
        $('.dynamic-wrapper').hide();

        if (selectedType) {
            $('#wrapper_' + selectedType).fadeIn(150);
            // Clear all hidden select values so only the active one submits a value
            $('.dynamic-wrapper select').not('#wrapper_' + selectedType + ' select').val('');
        }
    }
</script>