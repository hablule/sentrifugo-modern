<?php
/**
 * Position Add Popup View
 * Modal interface for adding positions on the fly.
 * Complies with SSOT v6.7.7.
 */
?>
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/custompopup.css" />
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/jquery-te.css" />
<script type="text/javascript" src="<?php echo MEDIA_PATH; ?>js/custompopup.js"></script>
<script type="text/javascript" src="<?php echo MEDIA_PATH; ?>js/jquery-te.min.js"></script>

<?php if (isset($this->popup) && $this->popup === 'close') : ?>
    <div class="ml-alert-1-success">
        <div class="style-1-icon success"></div>Position added successfully. Closing...
    </div>
    <script type="text/javascript">
        $(document).ready(function() {
            var optionsHtml = '<?php echo $this->escape(isset($this->optionsHtml) ? $this->optionsHtml : ''); ?>';
            var prevCntrl = '<?php echo $this->escape(isset($this->prev_cntrl) ? $this->prev_cntrl : 'position'); ?>';
            var newId = '<?php echo $this->escape(isset($this->newInsertedId) ? $this->newInsertedId : ''); ?>';
            setTimeout(function() {
                var $parentSelect = parent.$('#position_id');
                if ($parentSelect.length && newId) {
                    if (typeof parent.closeiframeAddPopup === 'function') {
                        parent.closeiframeAddPopup(optionsHtml, prevCntrl, 'position_id', 'Position');
                    } else {
                        parent.$('#positionContainer').dialog('close');
                    }
                    $parentSelect.val(newId);
                } else if (typeof parent.closeiframeAddPopup === 'function') {
                    parent.closeiframeAddPopup(optionsHtml, prevCntrl, 'position_id', 'Position');
                } else {
                    parent.$('#positionContainer').dialog('close');
                }
            }, 1500);
        });
    </script>
<?php else : ?>
    <?php sapp_Global::generateClientValidations($this->form); ?>
    <div id="error_message" style="display:none;"></div>
    <?php if (!empty($this->msgarray)) : ?>
        <div class="ml-alert-1-error" style="margin: 10px;">
            <div style="display:block;"><span class="style-1-icon error"></span>Please correct the errors below.</div>
        </div>
    <?php endif; ?>
    <form name="<?php echo $this->escape($this->form->getName()); ?>" id="<?php echo $this->escape($this->form->getId()); ?>" action="<?php echo $this->escape($this->form->getAction()); ?>" method="post">
        <?php echo $this->form->id; ?>
        <div class="total-form-controller" style="padding: 15px;">
            <div class="division">
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->code->getLabel()); ?></label>
                    <div class="division"><?php echo $this->form->code; ?><span class="errors" id="errors-<?php echo $this->escape($this->form->code->getId()); ?>"><?php echo isset($this->msgarray['code']) ? $this->escape($this->msgarray['code']) : ''; ?></span></div>
                </div>
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->jobtitle_id->getLabel()); ?></label>
                    <div class="division"><?php echo $this->form->jobtitle_id; ?><span class="errors" id="errors-jobtitle_id"></span></div>
                </div>
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->status->getLabel()); ?></label>
                    <div class="division"><?php echo $this->form->status; ?></div>
                </div>
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->max_fte->getLabel()); ?></label>
                    <div class="division"><?php echo $this->form->max_fte; ?></div>
                </div>
                <?php echo sapp_Helper::sd_form_helper($this->msgarray, $this->form, 'description', '', 'fck_editor_height', '', array()); ?>
                <div class="new-form-ui clearb"><label><?php echo $this->escape($this->form->isactive->getLabel()); ?></label>
                    <div class="division"><?php echo $this->form->isactive; ?></div>
                </div>
                <div class="new-form-ui-submit">
                    <div class="division"><?php echo $this->form->submit; ?><input onclick="parent.$('#positionContainer').dialog('close');" value="Cancel" type="button" class="reset" /></div>
                </div>
            </div>
        </div>
    </form>
    <script type="text/javascript">
        $(document).ready(function() {
            $('#description').jqte();
        });
    </script>
<?php endif; ?>