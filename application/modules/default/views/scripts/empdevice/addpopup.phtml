	let fingerCount = 0;
	async function scanFingerPrint(fingerIndex, index) {
		//e.preventDefault();
		let num_of_finger = $('#num_of_fingers').val();
		let deviceId = $('#device_to_scan').val();
		let empId = `<?php echo $this->userId ?>`;
		let scanedSuccess = false;
		device_api_url = `<?php echo DEVICE_API_URL; ?>`;
		$(`#${index}`).find('img').show();
		console.log($(`#${index}`))
		$.ajax({
			url: device_api_url + "ConnectDevice/scanfingerprint?deviceId=" + deviceId + "&num_of_fingers=1" + "&empId=" + empId,
			type: "POST",
			success: function(response) {
				
				if (templateData[fingerIndex] == undefined) {
					templateData[fingerIndex] = {};
				}
				if (index >= 5) {
					templateData[fingerIndex]['left'] = response.data;
				} else {
					templateData[fingerIndex]['right'] = response.data;
				}

				$(`#${index}`).find('.addrecord').hide();
				$(`#${index}`).append('<span class="sprite delete"></span>');
				$(`#${index}`).find('.delete').click((e) => {
					if (index >= 5) {
						delete templateData[fingerIndex]['left'];
					} else {
						delete templateData[fingerIndex]['right'];
					}
					$(`[name='${fingerIndex}']`).val(JSON.stringify(templateData[fingerIndex]));
					//templateData[fingerIndex].splice(index, 1);
					$(`#num_of_fingers`).val(--num_of_finger);
					$(`#${index}`).find('.addrecord').show();
					$(`#${index}`).find('.delete').remove();
				});
				$(`[name='num_of_fingers']`).val(++num_of_finger);
				console.log((templateData[fingerIndex]));
				//$(`[name='${fingerIndex}']`).show();
				$(`#${index}`).find('img').hide();
				console.log(`[name='${fingerIndex}']`);
				$(`[name='${fingerIndex}']`).val(JSON.stringify(templateData[fingerIndex]));
				alert('Fingerprint scanned successfully');
			},
			error: function() {
				scanedSuccess = false;
				alert('Fingerprint scan failed. Please try again');
			}

		});

		return scanedSuccess;

	}
	$(document).ready(function() {
		let prevData = `<?php echo $this->hs ?>`;
		if (prevData) {
			console.log(prevData.split(':'));
			templateData = JSON.parse(prevData);

			console.log(templateData, 'that')
		} else {
			templateData = {};

		}
		$('#fingerprint').parent().hide();
		$('#card').parent().hide();
		$('#face').parent().hide();
		$('#finger_auth_mode').parent().parent().hide();
		$('#card_auth_mode').parent().parent().hide();
		$('#id_auth_mode').parent().parent().hide();
		$('#num_of_fingers').parent().parent().hide();
		$('#num_of_cards').parent().parent().hide();
		$("#pin").parent().parent().hide();
		$('#choose_auth_method').change(function() {
			$('#fingerprint').parent().hide();
			$('#card').parent().hide();
			$('#face').parent().hide();
			$('#finger_auth_mode').parent().parent().hide();
			$('#card_auth_mode').parent().parent().hide();
			$('#id_auth_mode').parent().parent().hide();
			$('#num_of_fingers').parent().parent().hide();
			$('#num_of_cards').parent().parent().hide();
			var value = $(this).val();
			var authType = value.join(",");
			function deleteFingerPrint(fingerIndex, hand) {
				delete templateData[fingerIndex][hand];
				const numoffingers = $("#num_of_fingers").val();
				$("#num_of_fingers").val(--numoffingers);
				$(`[name='${fingers[index-5]}']`).val(JSON.stringify(templateData[fingers[index - 5]]));
				$(`#${index}`).find('.addrecord').show();
				$(`#${index}`).find('.delete').remove();

			}
			value.map((val) => {
				if (val == 1) {
					$("#num_of_fingers").parent().parent().show();
					//$('#fingerprint').parent().show();
					
					$('#finger_auth_mode').parent().parent().show();
				
					$("#num_of_fingers").attr('readonly', true);
					const fingers = {
						0: "Thumb",
						1: "Index",
						2: "Middle",
						3: "Ring",
						4: "Pinky",
					};
					$('.fingerContainers').show();
					for (let index = 0; index < 10; index++) {
					if (index >= 5) {
						if (index == 5) {
							$('.fingerContainers').append(`<div class="lefthand">
								<h3>Left Hand</h3>
							</div>`);
						}


						$('.lefthand').append(`<div class="fingers" id=${index}>
						<span class="sprite addrecord"></span>
						<span>${fingers[index-5]} Finger</span>
						<img src="<?php echo MEDIA_PATH; ?>css/select2-spinner.gif" width="10" height="10"/></div>`);
						$(".fingers").find('img').hide();
						if (templateData[fingers[index - 5]] && templateData[fingers[index - 5]]['left']) {
							$(`#${index}`).find('.addrecord').hide();
							$(`#${index}`).append('<span class="sprite delete"></span>');
							console.log(templateData[fingers[index - 5]]['left'])
							$(`[name='${fingers[index-5]}']`).val(JSON.stringify(templateData[fingers[index - 5]]));
							/* $(`#${index}`).find('.delete').click((e) => {
								deleteFingerPrint(fingers[index - 5], 'left');
							}); */
						}
						$(`#${index}`).find('.addrecord').click(async (e) => {
							
							scanFingerPrint(fingers[index - 5], index);
						})
					} else {
						if (index == 0) {
							$('.fingerContainers').append(`<div class="righthand">
								<h3>Right Hand</h3>
							</div>`);
						}
						$(".total-form-controller").append(`<textarea name="${fingers[index]}"></textarea>`);
						$("[name='" + fingers[index] + "']").hide();
						//$("[name='" + fingers[index] + "']").val(templateData[fingers[index]]);
						$('.righthand').append(`<div class="fingers" id=${index}>
												<span class="sprite addrecord"></span>
												<span>${fingers[index]} Finger</span>
												<img src="<?php echo MEDIA_PATH; ?>css/select2-spinner.gif" width="10" height="10"/>
												</div>`);
							$(".fingers").find('img').hide();
						if (templateData[fingers[index]] && templateData[fingers[index]]['right']) {
							/* console.log(templateData[fingers[index]]) */
							$(`#${index}`).find('.addrecord').hide();
							$(`#${index}`).append('<span class="sprite delete"></span>');
							$(`[name='${fingers[index]}']`).val(JSON.stringify(templateData[fingers[index]]));
							/* $(`#${index}`).find('.delete').click((e) => {
								deleteFingerPrint(fingers[index], 'right');
							}); */
						}

						$(`#${index}`).find('.addrecord').click(async (e) => {
						
							$(`#${index}`).find('.fingers').find('img').show();
							scanFingerPrint(fingers[index], index);
						})
					}

				}

				}
				if (val == 2) {
					$('#face').parent().show();
					$('#id_auth_mode').show();
					$('#num_of_faces').parent().parent().show();
				}
				if (val == 3) {
					$('#card').parent().show();
					$('#card_auth_mode').show();
					$('#num_of_cards').parent().parent().show();
				}
			});
			$.ajax({
				url: base_url + '/empdevice/filterdevice',
				type: 'POST',
				dataType: 'html',
				data: {
					auth_type: authType
				},
				success: function(response) {
					$("#device_id").html('');
					$("#device_id").html('');
					//$("#device_id").html('<option value="*">All Device</option>');
					$("#device_id").parent().find(".select2-search-choice").remove();
					$('#device_id').html('<option value="*">All Device</option>' + response);
					$("#device_to_scan").html(response);
				}
			})
		});
		$("#device_id").change(function() {
			let device_id = $("#device_id").val();
			device_id.map((val) => {
				if (val == '*') {
					//$("#device_id").parent().find(".select2-search-choice").remove();
					//$("#device_id").html('<option value="*">All Device</option>');
				}
			})
		})
		$("#finger_auth_mode").change(function() {
			var value = $(this).val();
			if (value == 1) {
				$('#pin').parent().parent().show();
			} else {
				$('#pin').parent().parent().hide();
			}
		});
		$("#fingerprint").click((e) => {
			e.preventDefault();
			let num_of_finger = $('#num_of_fingers').val();
			let deviceId = $('#device_to_scan').val();
			let empId = `<?php echo $this->userId ?>`;
			device_api_url = `<?php echo DEVICE_API_URL; ?>`;
			$.ajax({
				url: device_api_url + "ConnectDevice/scanfingerprint?deviceId=" + deviceId + "&num_of_fingers=" + num_of_finger + "&empId=" + empId,
				type: "POST",
				success: function(response) {
					$('#hs').val(JSON.stringify(response.data));
					alert('Fingerprint scanned successfully');
				},
				error: function() {
					alert('Fingerprint scan failed. Please try again');
				}

			});
		})




