        function updateDevice() {
            var empID = '<?php echo $this->id; ?>';
            let device_api_url = `<?php echo DEVICE_API_URL; ?>`;
            $.ajax({
                url: device_api_url + "ConnectDevice/updatedeviceuser?employeeID=" + empID,
                type: 'PUT',
                success: function(response, status) {
                    if (!response.data) {
                        alert('something went wrong please check device configuration');
                    } else {
                        alert('Device updated successfully');
                        window.location.reload();
                    }

                },
                error: function() {
                    alert('something went wrong please check device configuration');
                }
            })


        }


        function deleteUser(id) {
            let device_api_url = `<?php echo DEVICE_API_URL; ?>`;
            const response = $.ajax({
                url: device_api_url + "ConnectDevice/deleteuser?empId=" + id,
                type: 'DELETE',
                success: function(response, status) {
                    if (response.data) {
                        alert("e")
                    } else {
                        alert('ed')
                    }
                }
            }).responseText;
        }
