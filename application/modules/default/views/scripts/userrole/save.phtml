<script>
    $(document).ready(function() {
        // Initialize JQTE
        $('#description').jqte();

        // Linked Datepickers Logic
        $('#datefrom').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                // Proactive: Prevent End Date from being before Start Date
                $("#dateto").datepicker("option", "minDate", selectedDate);
                
                if ($('#dateto').val() != '') {
                    from_to_date_validation('datefrom', 'dateto', this, "Start date should be less than End date.");
                }
            }
        });

        $('#dateto').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                // Proactive: Prevent Start Date from being after End Date
                $("#datefrom").datepicker("option", "maxDate", selectedDate);

                if ($('#datefrom').val() != '') {
                    from_to_date_validation('datefrom', 'dateto', this, "End date should be greater than Start date.");
                }
            }
        });

        // Set initial min/max if values exist (for Edit mode)
        if ($('#datefrom').val() != '') {
            $("#dateto").datepicker("option", "minDate", $('#datefrom').val());
        }
        if ($('#dateto').val() != '') {
            $("#datefrom").datepicker("option", "maxDate", $('#dateto').val());
        }
    });

    // Specific Iframe Logic
    function openUserPopup(url) {
        $("#userCont").attr('src', url);
        $("#userContainer").dialog({
            title: "Add User",
            width: 800,
            height: 500,
            modal: true
        });
    }

    function openRolesPopup(url) {
        $("#rolesCont").attr('src', url);
        $("#rolesContainer").dialog({
            title: "Add Role",
            width: 800,
            height: 500,
            modal: true
        });
    }
</script>