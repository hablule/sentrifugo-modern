<script type="text/javascript">
    $(document).ready(function() {
        // 1. Initialize Colorbox for Quick Add (Iframe Popups)
        $(".iframe").colorbox({
            iframe: true,
            width: "80%",
            height: "85%",
            opacity: 0.5,
            transition: "fade",
            onClosed: function() {
                // ESSENCE: Automatically refresh dropdowns when child popup closes
                refreshDropdowns();
            }
        });

        // 2. Datepicker Initialization
        $('.datepicker').datepicker({
            dateFormat: 'mm/dd/yy',
            changeMonth: true,
            changeYear: true,
            yearRange: "-5:+10"
        });

        // 3. Select2 for Employee Search
        if ($.isFunction($.fn.select2)) {
            $('#user_id').select2({
                placeholder: "Search for an employee...",
                allowClear: true
            });
        }

        // 4. Fade out error messages after 5 seconds
        setTimeout(function() {
            $('#message_container .ml-alert-1-success').fadeOut('slow');
        }, 5000);
    });

    /**
     * AJAX function to refresh dropdowns after a Quick Add
     */
    function refreshDropdowns() {
        // Refresh User List
        $.ajax({
            url: '<?php echo BASE_URL; ?>userrole/getlatestusers',
            type: 'GET',
            dataType: 'json',
            success: function(data) {
                var $el = $("#user_id");
                var selectedVal = $el.val();
                $el.empty().append('<option value="">Select User</option>');
                $.each(data, function(idx, obj) {
                    $el.append($("<option></option>").attr("value", obj.id).text(obj.name));
                });
                $el.val(selectedVal).trigger('change');
            }
        });

        // Refresh Roles List
        $.ajax({
            url: '<?php echo BASE_URL; ?>role/getrolesjson', // Assuming this exists or create it
            type: 'GET',
            dataType: 'json',
            success: function(data) {
                var $el = $("#role_id");
                var selectedVal = $el.val();
                $el.empty().append('<option value="">Select Role</option>');
                $.each(data, function(idx, obj) {
                    $el.append($("<option></option>").attr("value", obj.id).text(obj.rolename));
                });
                $el.val(selectedVal);
            }
        });
    }
</script>