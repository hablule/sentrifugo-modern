<script type="text/javascript">
    // Hydrate tables with frozen JSON mappings from the controller
    var arrAudience = <?php echo $this->existingAudience ?? '[]'; ?>;
    var arrQuestions = <?php echo $this->existingQuestions ?? '[]'; ?>;

    $(document).ready(function() {

        // 1. CUSTOM TAB LOGIC
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();
            var targetPanelId = $(this).attr('href');

            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');

            $('.sf-tab-panel').removeClass('active').hide();
            $(targetPanelId).addClass('active').fadeIn('fast');
        });

        // 2. Disable UI Plugins for Read-Only View
        $('#description').jqte();
        $('.jqte_editor').attr('contenteditable', 'false');

        if ($.isFunction($.fn.select2)) {
            $('select').select2({
                width: '100%'
            });
        }

        // 3. Render read-only tables
        var htmlA = '';
        if (arrAudience.length > 0) {
            $.each(arrAudience, function(idx, val) {
                htmlA += '<tr><td>#' + val.employee_id + '</td><td>' + val.employee_name + '</td></tr>';
            });
        } else {
            htmlA = '<tr><td colspan="2" style="text-align:center; color:#999;">No employees targeted.</td></tr>';
        }
        $('#view-audience tbody').html(htmlA);

        var htmlQ = '';
        if (arrQuestions.length > 0) {
            $.each(arrQuestions, function(idx, val) {
                htmlQ += '<tr><td>#' + val.question_id + '</td><td>' + val.question_name + '</td></tr>';
            });
        } else {
            htmlQ = '<tr><td colspan="2" style="text-align:center; color:#999;">No questions assigned.</td></tr>';
        }
        $('#view-questions tbody').html(htmlQ);
    });
</script>