<script type="text/javascript">
    // State Arrays populated by Controller (Only valid in Edit Mode)
    var arrAudience = <?php echo $this->existingAudience ?? '[]'; ?>;
    var arrQuestions = <?php echo $this->existingQuestions ?? '[]'; ?>;

    $(document).ready(function() {

        // 1. BRUTE FORCE TAB LOGIC
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();
            var targetPanelId = $(this).attr('href');
            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');
            $('.sf-tab-panel').hide();
            $(targetPanelId).fadeIn('fast');
        });

        // 2. Initialize plugins safely
        try {
            $('#description').jqte();
            if ($.isFunction($.fn.select2)) {
                $('.select2').select2({
                    width: '100%'
                });
                $('#rulebook_id, #period_id').select2({
                    width: '100%'
                });
            }
        } catch (err) {
            console.log("Plugin init warning: ", err);
        }

        // Datepickers logic
        $('#start_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#end_date").datepicker("option", "minDate", selectedDate);
            }
        });
        $('#end_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                $("#start_date").datepicker("option", "maxDate", selectedDate);
            }
        });
        if ($('#start_date').val() != '') $("#end_date").datepicker("option", "minDate", $('#start_date').val());
        if ($('#end_date').val() != '') $("#start_date").datepicker("option", "maxDate", $('#start_date').val());

        // Initial Render of tables
        renderAudience();
        renderQuestions();

        // ==============================================================
        // MASTER SUBMIT HANDLER (Handles BOTH Save and Launch)
        // ==============================================================
        $('#submitbutton, #launchbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            if ($.isFunction($form.valid) && !$form.valid()) {
                return false;
            }

            var isLaunching = ($(this).attr('id') === 'launchbutton');

            if (isLaunching) {
                if (!confirm('Are you sure you want to launch this campaign? This will generate assessment tasks for all targeted employees and cannot be undone.')) {
                    return;
                }
            }

            // Pack Arrays into JSON hidden inputs
            $('#audience_payload').val(JSON.stringify(arrAudience));
            $('#questions_payload').val(JSON.stringify(arrQuestions));

            if ($.isFunction($.blockUI)) {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
                });
            }

            var formData = new FormData($form[0]);

            if (isLaunching) {
                formData.append('and_launch', '1');
            }

            $.ajax({
                url: base_url + '/paappraisal/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if ($.isFunction($.unblockUI)) $.unblockUI();

                    if (res.result === 'saved') {
                        // Controller provides the correct redirect URL
                        window.location.href = res.redirect_url;
                    } else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').html('');

                        $.each(res, function(key, val) {
                            var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                            var errorSpan = $('#errors-' + key);
                            if (errorSpan.length > 0) {
                                errorSpan.html(errMsg).show();
                            } else {
                                $('[name="' + key + '"]').after('<span class="errors" id="errors-' + key + '">' + errMsg + '</span>');
                            }
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error occurred. Check logs.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });

    // --- AUDIENCE LOGIC ---
    function removeAudienceRow(index) {
        if (confirm("Are you sure you want to exclude this employee from the campaign?")) {
            arrAudience.splice(index, 1);
            renderAudience();
        }
    }

    function renderAudience() {
        var html = '';
        $.each(arrAudience, function(idx, val) {
            html += '<tr><td>#' + val.employee_id + '</td><td>' + val.employee_name + '</td>';
            html += '<td style="text-align: center;"><a class="remove-btn" onclick="removeAudienceRow(' + idx + ');" title="Exclude from Campaign"><i class="fa fa-times-circle fa-lg"></i> Exclude</a></td></tr>';
        });
        $('#tbl-audience tbody').html(html);
    }

    // --- QUESTIONS LOGIC ---
    function addQuestionRow() {
        var $selectedOption = $('#ui_question_id option:selected');
        var id = $selectedOption.val();
        var text = $.trim($selectedOption.text());
        var ratingId = $selectedOption.data('rating');
        var weight = $selectedOption.data('weight');

        if (!id || id === '') {
            alert('Please select a question.');
            return;
        }

        var exists = false;
        $.each(arrQuestions, function(i, v) {
            if (v.question_id == id) exists = true;
        });
        if (exists) {
            alert('This question is already added.');
            return;
        }

        // PUSH RATING AND WEIGHT INTO THE JSON ARRAY
        arrQuestions.push({
            question_id: id,
            question_name: text,
            rating_id: ratingId,
            weight: weight
        });

        $('#ui_question_id').val('').trigger('change.select2');
        renderQuestions();
    }

    function removeQuestionRow(index) {
        arrQuestions.splice(index, 1);
        renderQuestions();
    }

    function renderQuestions() {
        var html = '';
        $.each(arrQuestions, function(idx, val) {
            html += '<tr><td>#' + val.question_id + '</td><td>' + val.question_name + '</td>';
            html += '<td><a class="remove-btn" onclick="removeQuestionRow(' + idx + ');"><i class="fa fa-trash"></i> Remove</a></td></tr>';
        });
        $('#tbl-questions tbody').html(html);
    }
</script>