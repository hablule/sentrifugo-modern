	<script type="text/javascript">
		$(document).ready(function() {
			$('#description').jqte();

			// Exact same AJAX Validation & Submission as save.phtml
			$('#submitbutton').off('click').on('click', function(e) {
				e.preventDefault();
				var $form = $('#formid');
				$('.errors').text('');
				$('#message_container').empty();

				if (!$form.valid()) {
					return false;
				}

				var count = 0;
				if ($('#company_id').val() !== '') count++;
				if ($('#sbunit_id').val() !== '') count++;
				if ($('#division_id').val() !== '') count++;
				if ($('#department_id').val() !== '') count++;
				if ($('#section_id').val() !== '') count++;
				if ($('#project_id').val() !== '') count++;
				if ($('#parent_id').val() !== '') count++;

				if (count === 0 || count > 1) {
					var msg = (count > 1) ? 'Please select only ONE parent level.' : 'A Team must have a parent.';
					$('#errors-company_id').text(msg);
					$('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
					$('html, body').animate({
						scrollTop: 0
					}, 'slow');
					return false;
				}

				if (typeof $.blockUI === "function") $.blockUI({
					message: null
				});
				var formData = new FormData($form[0]);

				$.ajax({
					url: base_url + '/team/savepopup/format/json',
					type: 'POST',
					data: formData,
					processData: false,
					contentType: false,
					dataType: 'json',
					success: function(response) {
						if (typeof $.unblockUI === "function") $.unblockUI();
						if (response && response.result === 'saved') {
							// Modal success - simply reload to trigger the PHP success block
							window.location.reload();
						} else if (response && response.result === 'exception') {
							$('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
						} else if (response && typeof response === 'object') {
							$('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
							$.each(response, function(fieldId, errorObj) {
								var errMsg = (typeof errorObj === 'object') ? errorObj[Object.keys(errorObj)[0]] : errorObj;
								$('#errors-' + fieldId).text(errMsg);
							});
						}
					},
					error: function() {
						if (typeof $.unblockUI === "function") $.unblockUI();
						$('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
					}
				});
			});
		});
	</script>
