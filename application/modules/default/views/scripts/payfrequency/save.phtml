<script type="text/javascript">
var arrAnchors = <?php echo isset($this->existingAnchors) ? $this->existingAnchors : '[]'; ?>;
var isInUse = <?php echo $isInUse ? 'true' : 'false'; ?>;

$(document).ready(function() {
    $('#description').jqte();
    if (isInUse) {
        $('.jqte_editor').attr('contenteditable', 'false');
    }

    // Register custom validator for hidden Calendar Anchors payload
    if ($.validator && $('#formid').data('validator')) {
        $.validator.addMethod('requireAnchorDays', function(value, element) {
            if ($('#frequency_type').val() !== 'CALENDAR_BASED') {
                return true;
            }
            return arrAnchors.length > 0;
        }, 'Please add at least one anchor day (1-31).');

        var validator = $('#formid').data('validator');
        // Allow jQuery Validate to check calendar_anchors_payload even though it is hidden
        validator.settings.ignore = ':hidden:not(#calendar_anchors_payload)';
    }

    toggleCadenceFields();
    renderAnchors();

    $('#interval_unit').change(toggleUnitQualifiers);

    if (!isInUse) {
        $('#global_reference_date').datepicker({ dateFormat: '<?php echo DATEFORMAT_JS; ?>', changeMonth: true, changeYear: true });
    }

    $('#submitbutton').click(function() {
        $('#calendar_anchors_payload').val(JSON.stringify(arrAnchors));
    });
});

function toggleCadenceFields() {
    var mode = $('#frequency_type').val();
    $('.dynamic-cadence-wrapper').hide();
    if (mode) {
        $('#wrapper_' + mode).fadeIn(150);
    }

    if (!isInUse && $('#formid').data('validator')) {
        if (mode === 'FIXED_INTERVAL') {
            $('#interval_count').rules('add', {
                required: true, digits: true, min: 1,
                messages: { required: 'Please enter an interval step count.', digits: 'Interval count must be a positive whole number.', min: 'Interval count must be at least 1.' }
            });
            $('#interval_unit').rules('add', {
                required: true,
                messages: { required: 'Please select an interval unit.' }
            });
            $('#calendar_anchors_payload').rules('remove');
            $('#errors-calendar_anchors_payload').text('');
        } else {
            $('#interval_count').rules('remove');
            $('#interval_unit').rules('remove');
            $('#errors-interval_count, #errors-interval_unit').text('');
            $('#calendar_anchors_payload').rules('add', {
                requireAnchorDays: true
            });
        }
    }

    toggleUnitQualifiers();
}

function toggleUnitQualifiers() {
    var mode = $('#frequency_type').val();
    var unit = $('#interval_unit').val();
    $('#wrapper_unit_WEEK').hide();
    $('#wrapper_unit_MONTH').hide();

    if (!isInUse && $('#formid').data('validator')) {
        $('#weekly_anchor_day').rules('remove');
        $('#monthly_anchor_day').rules('remove');
        $('#errors-weekly_anchor_day, #errors-monthly_anchor_day').text('');
    }

    if (mode === 'FIXED_INTERVAL') {
        if (unit === 'WEEK') {
            $('#wrapper_unit_WEEK').fadeIn(150);
            if (!isInUse && $('#formid').data('validator')) {
                $('#weekly_anchor_day').rules('add', {
                    required: true,
                    messages: { required: 'Please select a week start day.' }
                });
            }
        } else if (unit === 'MONTH') {
            $('#wrapper_unit_MONTH').fadeIn(150);
            if (!isInUse && $('#formid').data('validator')) {
                $('#monthly_anchor_day').rules('add', {
                    required: true, digits: true, range: [1, 31],
                    messages: { required: 'Please enter a month start day (1-31).', range: 'Day must be between 1 and 31.' }
                });
            }
        }
    }
}

function addAnchorDay() {
    var val = parseInt($('#txt_anchor_input').val(), 10);
    if (isNaN(val) || val < 1 || val > 31) {
        $('#errors-calendar_anchors_payload').text('Please enter a valid day of the month between 1 and 31.');
        return;
    }

    if ($.inArray(val, arrAnchors) !== -1) {
        $('#errors-calendar_anchors_payload').text('This anchor day is already added.');
        return;
    }

    $('#errors-calendar_anchors_payload').text('');
    arrAnchors.push(val);
    arrAnchors.sort(function(a, b){ return a - b; });
    $('#txt_anchor_input').val('');
    renderAnchors();
}

function removeAnchorDay(day) {
    arrAnchors = $.grep(arrAnchors, function(value) {
        return value != day;
    });
    renderAnchors();
}

function renderAnchors() {
    var html = '';
    $.each(arrAnchors, function(idx, day) {
        var label = 'Day ' + day + (day === 31 ? ' (EOM)' : '');
        var removeIcon = isInUse ? '' : ' <i class="fa fa-times" onclick="removeAnchorDay(' + day + ');"></i>';
        html += '<span class="anchor-chip">' + label + removeIcon + '</span>';
    });
    $('#anchors_container').html(html);
    $('#calendar_anchors_payload').val(JSON.stringify(arrAnchors));
    if ($('#formid').data('validator') && $('#frequency_type').val() === 'CALENDAR_BASED') {
        $('#calendar_anchors_payload').valid();
    }
}
</script>