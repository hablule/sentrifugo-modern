<script type="text/javascript">
    var arrAnchors = <?php echo isset($this->existingAnchors) ? $this->existingAnchors : '[]'; ?>;

    $(document).ready(function() {
        $('#description').jqte();
        
        $('#interval_unit').change(toggleUnitQualifiers);
        toggleUnitQualifiers();
        toggleCadenceFields();
        renderAnchors();

        $('#global_reference_date').datepicker({
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            changeMonth: true,
            changeYear: true
        });

        // Pack payload before submit
        $('#submitbutton').click(function() {
            $('#calendar_anchors_payload').val(JSON.stringify(arrAnchors));
        });
    });

    function toggleCadenceFields() {
        var mode = $('#frequency_type').val();
        $('.dynamic-cadence-wrapper').hide();
        if (mode) {
            $('#wrapper_' + mode).fadeIn(150);
        }
        toggleUnitQualifiers();
    }

    function toggleUnitQualifiers() {
        var unit = $('#interval_unit').val();
        $('#wrapper_unit_WEEK').hide();
        $('#wrapper_unit_MONTH').hide();

        if (unit === 'WEEK') {
            $('#wrapper_unit_WEEK').fadeIn(150);
        } else if (unit === 'MONTH') {
            $('#wrapper_unit_MONTH').fadeIn(150);
        }
    }

    function addAnchorDay() {
        var val = parseInt($('#txt_anchor_input').val());
        if (isNaN(val) || val < 1 || val > 31) {
            alert("Please enter a valid day of the month between 1 and 31.");
            return;
        }

        if ($.inArray(val, arrAnchors) !== -1) {
            alert("This anchor day is already added.");
            return;
        }

        arrAnchors.push(val);
        arrAnchors.sort(function(a, b) {
            return a - b;
        });
        $('#txt_anchor_input').val('');
        renderAnchors();
    }

    function removeAnchorDay(day) {
        arrAnchors = $.grep(arrAnchors, function(value) {
            return value != day;
        });
        renderAnchors();
    }

    function renderAnchors() {
        var html = '';
        $.each(arrAnchors, function(idx, day) {
            var label = 'Day ' + day + (day === 31 ? ' (EOM)' : '');
            html += '<span class="anchor-chip">' + label + ' <i class="fa fa-times" onclick="removeAnchorDay(' + day + ');"></i></span>';
        });
        $('#anchors_container').html(html);
        $('#calendar_anchors_payload').val(JSON.stringify(arrAnchors));
    }
</script>