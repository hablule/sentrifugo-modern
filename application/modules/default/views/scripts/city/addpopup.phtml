        <script type="text/javascript">
            // SSOT VII: Robust AJAX Dropdown Pattern
            function getStatesByCountry(countryId) {
                var $stateSelect = $('#state_id');
                $stateSelect.empty().append('<option value="">Select State/Province</option>');

                if (!countryId) {
                    if ($.isFunction($.fn.material_select)) $stateSelect.material_select();
                    return;
                }

                $stateSelect.parent().block({
                    message: null,
                    overlayCSS: {
                        background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                        opacity: 0.8
                    }
                });

                $.ajax({
                    url: base_url + '/city/getstates/format/json',
                    type: 'POST',
                    data: {
                        country_id: countryId
                    },
                    dataType: 'json',
                    success: function(response) {
                        if (response && Object.keys(response).length > 0) {
                            var firstOptionSelected = false; // Flag to track the first item

                            $.each(response, function(key, value) {
                                var optId = '',
                                    optName = '';
                                if (typeof value === 'object') {
                                    optId = value.id || key;
                                    optName = value.name || value.state_name;
                                } else {
                                    optId = key;
                                    optName = value;
                                }

                                // Select the first valid option dynamically
                                var selectedAttr = (!firstOptionSelected) ? ' selected="selected"' : '';
                                $stateSelect.append('<option value="' + optId + '"' + selectedAttr + '>' + optName + '</option>');
                                firstOptionSelected = true;
                            });

                            // Trigger change so any child dropdowns (if added later) know the state changed
                            $stateSelect.trigger('change');

                        } else {
                            // No states found for this country
                            $stateSelect.append('<option value="">No States Available</option>');
                        }
                    },
                    complete: function() {
                        $stateSelect.parent().unblock();
                        if ($.isFunction($.fn.material_select)) {
                            $stateSelect.material_select();
                        } else if ($.isFunction($.fn.select2)) {
                            $stateSelect.select2();
                        }
                    }
                });
            }

            $(document).ready(function() {
                if ($('#description').length) {
                    $('#description').jqte();
                }
            });
        </script>
