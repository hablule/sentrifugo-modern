<script type="text/javascript">
    $(document).ready(function() {

        try {
            $('#description').jqte();
            if ($.isFunction($.fn.select2)) {
                $('.select2').select2();
            }
        } catch (err) {
            console.log("Plugin init warning: ", err);
        }

        // Make the Consolidated Score box Read-Only so users can't fake it
        $('#consolidated_score').prop('readonly', true).css('background-color', '#f4f4f4');

        // ==============================================================
        // CATEGORY ACCORDION UI LOGIC
        // ==============================================================
        $('.accordion-header').on('click', function(e) {
            e.preventDefault();
            var targetId = $(this).data('target');
            var $icon = $(this).find('.toggle-icon');

            $('#' + targetId).slideToggle('fast', function() {
                if ($(this).is(':visible')) {
                    $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
                } else {
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
                }
            });
        });

        // ==============================================================
        // THE LIVE MATH & PROGRESS ENGINE
        // ==============================================================
        function calculateLiveScore() {
            var totalWeightedScore = 0;
            var totalWeight = 0;

            // Loop through each Category Wrapper to calculate Section Progress
            $('.category-wrapper').each(function() {
                var $category = $(this);
                var questionsInCategory = $category.find('.question-block').length;
                var answeredInCategory = 0;

                // Loop through questions in THIS category
                $category.find('.question-block').each(function() {
                    var weight = parseFloat($(this).data('weight'));
                    var normVal = null;
                    var isAnswered = false;

                    // 1. Check Dropdown
                    var $select = $(this).find('select.answer-input');
                    if ($select.length > 0) {
                        var selectedOpt = $select.find('option:selected');
                        if (selectedOpt.val() !== '') {
                            normVal = parseFloat(selectedOpt.data('norm-val'));
                            isAnswered = true;
                        }
                    }
                    // 2. Check Radio/Stars
                    else if ($(this).find('input[type="radio"].answer-input').length > 0) {
                        var $checkedRadio = $(this).find('input[type="radio"].answer-input:checked');
                        if ($checkedRadio.length > 0) {
                            normVal = parseFloat($checkedRadio.data('norm-val'));
                            isAnswered = true;
                        }
                    }
                    // 3. Check Slider (Always answered by default since it has a starting position)
                    else if ($(this).find('input[type="range"].answer-input').length > 0) {
                        var $slider = $(this).find('input[type="range"].answer-input');
                        var rawVal = parseFloat($slider.val());
                        var min = parseFloat($slider.data('min'));
                        var range = parseFloat($slider.data('range'));

                        if (range > 0 && !isNaN(rawVal)) {
                            normVal = (((rawVal - min) / range) * 99) + 1;
                            normVal = Math.max(1, Math.min(100, normVal));
                        }
                        isAnswered = true;
                    }
                    // 4. Check Unstructured Text Only (No structured rating available)
                    else {
                        var comments = $.trim($(this).find('textarea').val());
                        if (comments.length > 0) {
                            isAnswered = true;
                        }
                    }

                    if (isAnswered) answeredInCategory++;

                    // Math accumulation (only if it has a numeric weight)
                    if (normVal !== null && !isNaN(normVal) && !isNaN(weight) && weight > 0) {
                        totalWeightedScore += (normVal * weight);
                        totalWeight += weight;
                    }
                });

                // Update the Progress Indicator for this category
                var $progressSpan = $category.find('.category-progress');
                if (answeredInCategory === questionsInCategory) {
                    $progressSpan.html('<i class="fa fa-check-circle" style="color: #27ae60;"></i> Complete (' + answeredInCategory + '/' + questionsInCategory + ')');
                } else {
                    $progressSpan.html('Answered: ' + answeredInCategory + ' / ' + questionsInCategory);
                }
            });

            // Calculate Final Percentage and Convert to 5-Point Scale
            if (totalWeight > 0) {
                var finalPercentage = totalWeightedScore / totalWeight;
                var fivePointScale = (finalPercentage / 100) * 5;
                $('#consolidated_score').val(fivePointScale.toFixed(2));
            } else {
                $('#consolidated_score').val('');
            }
        }

        // Bind the calculator to inputs
        $('.question-block select, .question-block input[type="radio"], .question-block input[type="range"], .question-block textarea').on('change input', function() {
            calculateLiveScore();
        });

        // Run once on load
        calculateLiveScore();

        // ==============================================================
        // MASTER SUBMIT HANDLER (The "One-Shot" Save)
        // ==============================================================
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            if ($.isFunction($form.valid) && !$form.valid()) {
                return false;
            }

            if ($.isFunction($.blockUI)) {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" />'
                });
            }

            // FormData perfectly captures the dynamic 'answers[X]' array format
            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/paassessment/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(res) {
                    if ($.isFunction($.unblockUI)) $.unblockUI();

                    if (res.result === 'saved') {
                        window.location.href = res.redirect_url;
                    } else if (res.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $('.errors').html('');
                        $.each(res, function(key, val) {
                            var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                            var errorSpan = $('#errors-' + key);
                            if (errorSpan.length > 0) {
                                errorSpan.html(errMsg).show();
                            } else {
                                $('[name="' + key + '"]').after('<span class="errors" id="errors-' + key + '">' + errMsg + '</span>');
                            }
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if ($.isFunction($.unblockUI)) $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error occurred. Check logs.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });

    // ==============================================================
    // SENTRIFUGO SIDEBAR FIX (SSOT v6.7 Compliant)
    // Overrides global hrmsheader.phtml logic to force the correct 
    // dual-routed menu open based on context.
    // DEPRECATED: This logic is now handled globally in hrmsheader.phtml to ensure consistency across all modules and actions.
    // ==============================================================
    /*
    setTimeout(function() {
        var actionName = '<?php echo $this->escape($this->actionname ?: "mine"); ?>';
        var targetMenuUrl = base_url + '/paassessment/' + actionName;

        var $selected_obj = $("li[menu-url='" + targetMenuUrl + "']");

        if ($selected_obj.length > 0) {
            var parent_div = $selected_obj.attr("parent-div");

            $('.active_menu_class').removeClass('active_menu_class');
            $('.side-menu-selected').removeClass('side-menu-selected');

            $selected_obj.addClass("active_menu_class");
            $selected_obj.find("a").addClass("side-menu-selected");

            if (parent_div) {
                $('.' + parent_div).addClass("selected_menu_class").show();
            }

            if (typeof parent_menu_selected === 'function') {
                parent_menu_selected($selected_obj);
            }
        }
    }, 100); // 100ms delay ensures this runs AFTER hrmsheader.phtml logic finishes
    */
</script>