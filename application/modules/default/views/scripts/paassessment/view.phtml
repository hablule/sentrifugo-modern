<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();
        $('.jqte_editor').attr('contenteditable', 'false');

        if ($.isFunction($.fn.select2)) {
            // Apply select2 to disabled selects for consistent styling
            $('select').select2({
                width: '100%'
            });
        }

        // ==============================================================
        // CATEGORY ACCORDION UI LOGIC
        // ==============================================================
        $('.accordion-header').on('click', function(e) {
            e.preventDefault();
            var targetId = $(this).data('target');
            var $icon = $(this).find('.toggle-icon');

            $('#' + targetId).slideToggle('fast', function() {
                if ($(this).is(':visible')) {
                    $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
                } else {
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
                }
            });
        });

        // ==============================================================
        // THE LIVE MATH & PROGRESS ENGINE
        // ==============================================================
        function calculateLiveScore() {

            // Loop through each Category Wrapper to calculate Section Progress
            $('.category-wrapper').each(function() {
                var $category = $(this);
                var questionsInCategory = $category.find('.question-block').length;
                var answeredInCategory = 0;

                // Loop through questions in THIS category
                $category.find('.question-block').each(function() {
                    var isAnswered = false;

                    // 1. Check Dropdown
                    var $select = $(this).find('select.answer-input');
                    if ($select.length > 0) {
                        var selectedOpt = $select.find('option:selected');
                        if (selectedOpt.val() !== '') {
                            isAnswered = true;
                        }
                    }
                    // 2. Check Radio/Stars
                    else if ($(this).find('input[type="radio"].answer-input').length > 0) {
                        var $checkedRadio = $(this).find('input[type="radio"].answer-input:checked');
                        if ($checkedRadio.length > 0) {
                            isAnswered = true;
                        }
                    }
                    // 3. Check Slider (Always answered by default since it has a starting position)
                    else if ($(this).find('input[type="range"].answer-input').length > 0) {                        
                        isAnswered = true;
                    }
                    // 4. Check Unstructured Text Only (No structured rating available)
                    else {
                        var comments = $.trim($(this).find('textarea').val());
                        if (comments.length > 0) {
                            isAnswered = true;
                        }
                    }

                    if (isAnswered) answeredInCategory++;                    
                });

                // Update the Progress Indicator for this category
                var $progressSpan = $category.find('.category-progress');
                if (answeredInCategory === questionsInCategory) {
                    $progressSpan.html('<i class="fa fa-check-circle" style="color: #27ae60;"></i> Complete (' + answeredInCategory + '/' + questionsInCategory + ')');
                } else {
                    $progressSpan.html('Answered: ' + answeredInCategory + ' / ' + questionsInCategory);
                }
            });            
        }

        // Run once on load
        calculateLiveScore();

    });

