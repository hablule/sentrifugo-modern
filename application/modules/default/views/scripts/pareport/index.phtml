<script type="text/javascript">
    $(document).ready(function() {
        if ($.isFunction($.fn.select2)) {
            $('.select2').select2({
                width: '100%'
            });
        }

        // CUSTOM TABS
        $('.sf-tabs-nav a').on('click', function(e) {
            e.preventDefault();
            var targetPanelId = $(this).attr('href');
            $('.sf-tabs-nav li').removeClass('active');
            $(this).parent('li').addClass('active');
            $('.sf-tab-panel').removeClass('active').hide();
            $(targetPanelId).addClass('active').fadeIn('fast');
        });

        // Run on initial load
        fetchDashboardData();
    });

    /**
     * Master function to ping all APIs and refresh the canvas based on the Global Filters.
     */
    function fetchDashboardData() {
        // Gather all UI Filters into a JSON object
        var activeFilters = {
            campaign_id: $('#filter_campaign').val()
        };
        var filterJson = JSON.stringify(activeFilters);

        // UI Feedback
        $('#kpi_total, #kpi_completion, #kpi_score').html('<i class="fa fa-spinner fa-spin"></i>');
        $('#chart_status_container').html('<div style="text-align: center; color: #999; padding: 20px;"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');

        // 1. Fetch KPIs
        $.getJSON(base_url + '/pareport/getdashboarddata', {
            filters: filterJson
        }, function(res) {
            if (res.status === 'success' && res.data) {
                var d = res.data;
                $('#kpi_total').text(d.total_assessments || 0);

                var total = parseInt(d.total_assessments) || 0;
                var completed = parseInt(d.completed_assessments) || 0;
                var rate = (total > 0) ? Math.round((completed / total) * 100) : 0;
                $('#kpi_completion').text(rate + '%');

                var avg = parseFloat(d.average_score);
                $('#kpi_score').text(!isNaN(avg) ? avg.toFixed(2) : 'N/A');
            } else {
                $('.kpi-value').text('Error');
            }
        });

        // 2. Fetch Status Chart
        $.getJSON(base_url + '/pareport/getchartdata', {
            type: 'status_breakdown',
            filters: filterJson
        }, function(res) {
            if (res.status === 'success') {
                var maxCount = 0;
                $.each(res.data, function(i, val) {
                    if (parseInt(val) > maxCount) maxCount = parseInt(val);
                });

                if (maxCount === 0) {
                    $('#chart_status_container').html('<div style="text-align:center; color:#999; padding:20px;">No data available for the selected filters.</div>');
                    return;
                }

                var html = '';
                $.each(res.labels, function(i, label) {
                    var count = parseInt(res.data[i]);
                    var widthPct = Math.round((count / maxCount) * 100);

                    var color = '#95a5a6'; // Gray
                    if (label === 'Completed' || label === 'Acknowledged') color = '#27ae60'; // Green
                    if (label === 'Pending') color = '#e74c3c'; // Red
                    if (label === 'In Progress') color = '#f39c12'; // Orange

                    html += '<div class="css-bar-row">';
                    html += '  <div class="css-bar-label">' + label + '</div>';
                    html += '  <div class="css-bar-track"><div class="css-bar-fill" style="width: ' + widthPct + '%; background-color: ' + color + ';"></div></div>';
                    html += '  <div class="css-bar-val">' + count + '</div>';
                    html += '</div>';
                });

                $('#chart_status_container').html(html);
            } else {
                $('#chart_status_container').html('<div style="color:red;">Failed to load chart data.</div>');
            }
        });
    }
</script>