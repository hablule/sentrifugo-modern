            // Use improved variable name roleOptionsHtml
            var options = '<?php echo $this->roleOptionsHtml; ?>';
            var newId = '<?php echo $this->newRoleId; ?>';
            var controller = '<?php echo $this->controllername; ?>';
            
            // Logic to update parent window
