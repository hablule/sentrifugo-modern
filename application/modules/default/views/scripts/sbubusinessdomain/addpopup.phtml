<!-- Asset Inclusions (SSOT v6.4 Standard) -->
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/custompopup.css" />
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/jquery-te.css" />
<script type="text/javascript" src="<?php echo MEDIA_PATH; ?>js/custompopup.js"></script>
<script type="text/javascript" src="<?php echo MEDIA_PATH; ?>js/jquery-te.min.js"></script>

<?php if (isset($this->popup) && $this->popup === 'close') : ?>

    <!-- Success UI -->
    <div class="ml-alert-1-success">
        <div class="style-1-icon success"></div>
        SBU Business Domain mapped successfully. Closing...
    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            var optionsHtml = '<?php echo $this->escape(isset($this->optionsHtml) ? $this->optionsHtml : ''); ?>';
            var prevCntrl = '<?php echo $this->escape(isset($this->prev_cntrl) ? $this->prev_cntrl : 'sbubusinessdomain'); ?>';

            setTimeout(function() {
                // SSOT v6.4 "On-The-Fly" Popup Pattern closure
                if (typeof parent.closeiframeAddPopup === 'function') {
                    // Mappings don't typically populate a single dropdown upon completion
                    // We call the parent close function to let it reload the grid or close gracefully
                    parent.closeiframeAddPopup(optionsHtml, prevCntrl, 'sbubusinessdomain_id', 'SBU Mapping');
                } else {
                    // Fallback close if parent doesn't have the handler
                    parent.$('#sbubusinessdomainContainer').dialog('close');
                }
            }, 1500);
        });
    </script>

<?php else : ?>

    <?php sapp_Global::generateClientValidations($this->form); ?>

    <?php if (!empty($this->msgarray)) : ?>
        <div class="ml-alert-1-error" style="margin: 10px;">
            <div style="display:block;">
                <span class="style-1-icon error"></span>
                Please correct the errors highlighted below.
            </div>
        </div>
    <?php endif; ?>

    <form name="<?php echo $this->escape($this->form->getName()); ?>" id="<?php echo $this->escape($this->form->getId()); ?>" action="<?php echo $this->escape($this->form->getAction()); ?>" method="post">

        <?php echo $this->form->id; ?>

        <?php if ($this->form->getElement('sbunit_id_hidden')): ?>
            <?php echo $this->form->sbunit_id_hidden; ?>
        <?php endif; ?>
        <?php if ($this->form->getElement('businessdomain_id_hidden')): ?>
            <?php echo $this->form->businessdomain_id_hidden; ?>
        <?php endif; ?>

        <div class="total-form-controller" style="padding: 15px;">
            <div class="division">

                <!-- SBU Dropdown -->
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->sbunit_id->getLabel()); ?></label>
                    <div class="division">
                        <?php echo $this->form->sbunit_id; ?>
                        <span class="errors" id="errors-<?php echo $this->escape($this->form->sbunit_id->getId()); ?>">
                            <?php echo isset($this->msgarray['sbunit_id']) ? $this->escape($this->msgarray['sbunit_id']) : ''; ?>
                        </span>
                    </div>
                </div>

                <!-- Domain Dropdown -->
                <div class="new-form-ui clearb">
                    <label class="required"><?php echo $this->escape($this->form->businessdomain_id->getLabel()); ?></label>
                    <div class="division">
                        <?php echo $this->form->businessdomain_id; ?>
                        <span class="errors" id="errors-<?php echo $this->escape($this->form->businessdomain_id->getId()); ?>">
                            <?php echo isset($this->msgarray['businessdomain_id']) ? $this->escape($this->msgarray['businessdomain_id']) : ''; ?>
                        </span>
                    </div>
                </div>

                <!-- Description -->
                <?php echo sapp_Helper::sd_form_helper($this->msgarray, $this->form, 'description', '', 'fck_editor_height', '', array()); ?>

                <!-- Active Status -->
                <div class="new-form-ui clearb">
                    <label><?php echo $this->escape($this->form->isactive->getLabel()); ?></label>
                    <div class="division">
                        <?php echo $this->form->isactive; ?>
                    </div>
                </div>

                <!-- Actions -->
                <div class="new-form-ui-submit">
                    <div class="division">
                        <?php echo $this->form->submit; ?>
                        <!-- Standard Parent Modal Close Hook -->
                        <input onclick="parent.$('#sbubusinessdomainContainer').dialog('close');" value="Cancel" type="button" class="reset" />
                    </div>
                </div>

            </div>
        </div>
    </form>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#description').jqte();

            // Form-level error scrolling
            <?php if (!empty($this->msgarray)) : ?>
                $('html, body').animate({
                    scrollTop: 0
                }, 'slow');
            <?php endif; ?>
        });
    </script>

<?php endif; ?>