<script type="text/javascript">
    $(document).ready(function() {
        $('#name, #description').jqte();


        if ($.isFunction($.fn.select2)) {
            $('#category_id, #rating_id').select2({
                // width: '100%'
            });
            $('#skill_ids').attr('multiple', 'multiple').select2({
                // width: '100%',
                placeholder: "Search and select skills..."
            });
        }


        // --- Custom AJAX Submit for Multiselect ---
        $('#submitbutton').click(function(e) {
            e.preventDefault(); // Stop default HTML submission

            var $form = $('#formid');

            if (!$form.valid()) {
                return false; // Stop if client validation fails
            }

            // SSOT VII.11: Block UI
            $.blockUI({
                message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />'
            });

            // SSOT VII.10: Use FormData
            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/paquestion/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    $.unblockUI();

                    // Check for standard redirect success
                    if (response.result === 'saved') {
                        window.location.href = base_url + '/paquestion';
                        return;
                    }

                    // SSOT V.6: Handle raw Zend Form error object
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                    $('.errors').html(''); // Clear old errors

                    $.each(response, function(key, val) {
                        var errMsg = (typeof val === 'object') ? val[Object.keys(val)[0]] : val;
                        $('#errors-' + key).html(errMsg);
                    });

                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                },
                error: function() {
                    $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        });
    });
</script>