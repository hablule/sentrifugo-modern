<script type="text/javascript">
    // SSOT VII: Robust AJAX Dropdown Pattern
    function getStatesByCountry(countryId) {
        var $stateSelect = $('#state_id');
        var $citySelect = $('#city_id');

        $stateSelect.empty().append('<option value="">Select State/Province...</option>');
        $citySelect.empty().append('<option value="">Select State First...</option>');

        if (!countryId) {
            if ($.isFunction($.fn.material_select)) {
                $stateSelect.material_select();
                $citySelect.material_select();
            }
            return;
        }

        $stateSelect.parent().block({
            message: null,
            overlayCSS: {
                background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                opacity: 0.8
            }
        });

        $.ajax({
            url: base_url + '/postalcode/getstates/format/json',
            type: 'POST',
            data: {
                country_id: countryId
            },
            dataType: 'json',
            success: function(response) {
                if (response) {
                    $.each(response, function(key, value) {
                        $stateSelect.append('<option value="' + key + '">' + value + '</option>');
                    });
                }
            },
            complete: function() {
                $stateSelect.parent().unblock();
                if ($.isFunction($.fn.material_select)) {
                    $stateSelect.material_select();
                    $citySelect.material_select();
                }
            }
        });
    }

    function getCitiesByState(stateId) {
        var $citySelect = $('#city_id');
        $citySelect.empty().append('<option value="">Select City...</option>');

        if (!stateId) {
            if ($.isFunction($.fn.material_select)) $citySelect.material_select();
            return;
        }

        $citySelect.parent().block({
            message: null,
            overlayCSS: {
                background: '#fff url(' + base_url + '/public/media/images/loader2.gif) no-repeat center',
                opacity: 0.8
            }
        });

        $.ajax({
            url: base_url + '/postalcode/getcities/format/json',
            type: 'POST',
            data: {
                state_id: stateId
            },
            dataType: 'json',
            success: function(response) {
                if (response) {
                    $.each(response, function(key, value) {
                        $citySelect.append('<option value="' + key + '">' + value + '</option>');
                    });
                }
            },
            complete: function() {
                $citySelect.parent().unblock();
                if ($.isFunction($.fn.material_select)) {
                    $citySelect.material_select();
                }
            }
        });
    }

    $(document).ready(function() {
        if ($('#description').length) {
            $('#description').jqte();
        }
    });
</script>