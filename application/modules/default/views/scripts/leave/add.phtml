<script>
	$("#submit").click(function() {
		if (!isValid()) {
			return false;
		} else {

			var method = document.getElementById('classfun').value;
			var selectedFun_Name = method.split(".");
			var className = selectedFun_Name[0];
			var methodName = selectedFun_Name[1];
			
			
			if (className != 'empty') {
				var no_parameters = classes[className]['methods'][methodName]['no_args'];
				for (var i = 0; i < no_parameters; i++) {
					document.getElementById('parameters').value += document.getElementById('selected_text_' + i).value + ","
				}
			}

			return true;
		}
	});
	document.getElementById('duarationtype').onchange = function() {
		var selected = document.getElementById('duarationtype').value;
		console.log(selected);

		if (selected == 'Request') {
			document.getElementById('classfun_div').style.display = 'none';
			document.getElementById('allowday_div').style.display = 'none';
			document.getElementById('para').style.display = 'none';

		} else if (selected == 'Individual') {
			document.getElementById('classfun_div').style.display = 'none';
			document.getElementById('allowday_div').style.display = 'none';
		} else if (selected == 'Calculated') {
			document.getElementById('allowday_div').style.display = 'none';
			document.getElementById('classfun_div').style.display = 'block';
		} else if (selected == 'Fixed') {
			document.getElementById('classfun_div').style.display = 'none';
			document.getElementById('allowday_div').style.display = 'block';
		}
	}

	function isValid() {
		var valid = true;
		if (document.getElementById('allowday_div').style.display == 'block') {

			var reg = /[0-9]+([.])?[0-9]+/;
			if (!reg.test(document.getElementById('allowday').value)) {
				document.getElementById('amount_error').innerHTML = 'Use Only Numbers!';
				valid = false;
			} else {

			}
		}
		if (document.getElementById('allowday_div').style.display == 'block') {
            if (document.getElementById('allowday').value == '') {
                valid = false;
                document.getElementById('allowday_error').innerHTML = 'Field is required!';
            } else {
                var reg = /[0-9]+([.])?[0-9]+/;
                if (!reg.test(document.getElementById('allowday').value)) {
                    document.getElementById('allowday_error').innerHTML = 'Use Only Numbers!';
                    valid = false;
                } else {
                   
                }

            }
        }
		if (document.getElementById('duarationtype').value == 'Calculated') {
			var method = document.getElementById('classfun').value;
			if (method == 'empty') {
				document.getElementById('classfun_error').innerHTML = 'Please select a function!';
				valid = false;
			} else {
				var selectedFun_Name = method.split(".");
				var className = selectedFun_Name[0];
				var methodName = selectedFun_Name[1];
				var no_parameters = classes[className]['methods'][methodName]['no_args'];
				for (var i = 0; i < no_parameters; i++) {
					if (document.getElementById("selected_text_" + i).value == "") {
						document.getElementById("error_" + i).innerHTML = "Field is required!";
						valid = false;
					} else {
						document.getElementById("error_" + i).innerHTML = '';
					}
				}
			}
		}

		return valid;

	}
	$('#description').jqte();

</script>
