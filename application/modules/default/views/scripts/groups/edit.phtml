<script type="text/javascript" language="javascript">
    $('#description').jqte();

    $(document).ready(function() {

        // --- 1. PREVENT BUBBLING (Fixes Issue 2) ---
        // Clicking inside the permission box should NOT trigger the parent accordion/menu actions
        $(document).on('click', '.cls_radiobuttons_div', function(e) {
            e.stopPropagation();
        });

        // --- 2. TOGGLE PERMISSION BOX ON NAME CLICK ---
        $('.cls_menuname').css('cursor', 'pointer');
        $(document).on('click', '.cls_menuname', function(e) {
            e.stopPropagation(); // Stop bubbling
            e.preventDefault(); // Stop default label action

            // Toggle the permission div next to this label
            var permDiv = $(this).parent().next('.cls_radiobuttons_div');
            permDiv.slideToggle();
        });

        // --- 3. MAIN CHECKBOX TOGGLE ---
        $(document).on('click', 'input[data-role="menu-checkbox"]', function(e) {
            e.stopPropagation(); // Stop bubbling to accordion

            var menuId = $(this).data('id');
            var isChecked = $(this).is(':checked');

            // Toggle Permission Div
            var permDiv = $('#idcls_checkboxes_' + menuId);
            if (isChecked) {
                permDiv.slideDown();
            } else {
                permDiv.slideUp();
                // Uncheck inner permissions when main menu is disabled
                permDiv.find('input[type="checkbox"]').prop('checked', false);
            }

            // Cascade Down (Children)
            $('.childclass_' + menuId).prop('checked', isChecked);
            if (!isChecked) {
                $('.cls_radiobuttons_div' + menuId).slideUp().find('input').prop('checked', false);
            } else {
                // Optional: Auto-open children permissions? (Usually better to keep them closed until needed)
                // $('.cls_radiobuttons_div' + menuId).slideDown(); 
            }

            // Cascade Up (Parents)
            if (isChecked) {
                var parents = $(this).data('parents');
                if (parents) {
                    var parentArray = parents.toString().split(',');
                    $.each(parentArray, function(i, pid) {
                        var parentBox = $('#idcheckbox' + pid);
                        if (!parentBox.is(':checked')) {
                            parentBox.prop('checked', true);
                            $('#idcls_checkboxes_' + pid).slideDown();
                        }
                    });
                }
            }
        });

        // --- 4. PERMISSION RADIO/CHECKBOX TOGGLE (Fixes Issue 1) ---
        $(document).on('click', 'input[data-role="perm-radio"]', function(e) {
            e.stopPropagation(); // Critical: Stop bubbling to Accordion Header

            var menuId = $(this).data('menu-id');

            // If user checks a permission (e.g. Add), ensure the Menu itself is checked
            if ($(this).is(':checked')) {
                var mainBox = $('#idcheckbox' + menuId);
                if (!mainBox.is(':checked')) {
                    // Trigger click to run the Main Checkbox Logic (SlideDown, Cascade Up)
                    mainBox.trigger('click');
                }
            }
        });

        // --- 5. ACCORDION UI TOGGLE ---
        $(document).on('click', '.ui-accordion-header', function(e) {
            // Safety: These checks are redundant due to stopPropagation above, but kept for robustness
            if ($(e.target).is('input')) return;
            if ($(e.target).hasClass('cls_menuname')) return;
            if ($(e.target).closest('.cls_radiobuttons_div').length > 0) return;

            var contentDiv = $(this).next('.ui-accordion-content');
            var icon = $(this).find('.ui-accordion-header-icon');

            contentDiv.slideToggle();
            $(this).toggleClass('ui-accordion-header-active ui-state-active ui-corner-top ui-corner-all');
            contentDiv.toggleClass('ui-accordion-content-active');

            if (icon.hasClass('ui-icon-plus')) {
                icon.removeClass('ui-icon-plus').addClass('ui-icon-minus');
            } else {
                icon.removeClass('ui-icon-minus').addClass('ui-icon-plus');
            }
        });

        // --- 6. SUBMIT HANDLER ---
        $('#submitbutton').click(function() {
            var checked_checkboxes = parseInt($('.cls_checkboxes:checked').length);

            if (checked_checkboxes > 0) {
                $('#prev_cnt').val('1');
                $('#errors-prev_cnt').html('');

                var permJson = collectPermissions();
                $('#permissions_json').val(permJson);

                return true;
            } else {
                $('#prev_cnt').val('');
                $('#errors-prev_cnt').html('Please select privileges.');

                window.scrollTo({ top: 0, behavior: 'smooth' });

                $.unblockUI();

                return false;
            }

        });
    });

    function collectPermissions() {
        var permissions = {};
        $('input[data-role="menu-checkbox"]:checked').each(function() {
            var menuId = $(this).data('id');
            permissions[menuId] = {
                active: 'Yes'
            };
            $('#idcls_checkboxes_' + menuId).find('input[data-role="perm-radio"]').each(function() {
                var type = $(this).data('perm-type');
                var val = $(this).is(':checked') ? 'Yes' : 'No';
                permissions[menuId][type] = val;
            });
        });
        return JSON.stringify(permissions);
    }
</script>