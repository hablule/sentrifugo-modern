<!-- Header & Actions -->
<?php if ($this->call != 'ajaxcall') : ?>
    <div id="module_header">
        <div class="profile-tabs-right-2" style="width: 100% !important; margin-bottom: 15px;">
            <div class="flt_left">
                <h4 class="page-title" style="margin: 0; padding-top: 5px;">System Modules Registry</h4>
                <p style="font-size: 12px; color: #666; margin: 0;">Read-only view of physical application modules.</p>
            </div>
            
            <div class="flt_right">
                <div class="actions_div">
                    <!-- Scanner Button -->
                    <button id="btn-scan" class="actbtn_btn" style="background-color: #f39c12; border:none; padding: 6px 12px; color: #fff; cursor: pointer;">
                        <i class="fa fa-search"></i> Run System Scan
                    </button>
                </div>
            </div>
        </div>

        <!-- Flash Messages -->
        <div id="message_container">
            <?php if (count($this->messages)) : ?>
                <div id="dispmsg" class="settingssuccess">
                    <?php foreach ($this->messages as $message) : $key = key($message); ?>
                        <div class="ml-alert-1-<?php echo $key; ?>">
                            <div style="display:block;">
                                <span class="style-1-icon <?php echo $key; ?>"></span>
                                <?php echo $message[$key]; ?>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>

<!-- Grid Container -->
<div id="module_container" class="full-width">
    <div id="msg" style="display:none;font-style: oblique; font-weight: bold; color: green;"></div>
    
    <div id="grid_module" class="all-grid-control">
        <?php
        if (!empty($this->dataArray[0]['tablecontent'])) {
            // Override grid actions via JS if necessary, but controller handles header
            echo $this->grid($this->dataArray[0]);
        } else if ($this->call != 'ajaxcall') {
            echo "<p class='no-data'>No modules found. Please run the System Scan.</p>";
        }
        ?>
    </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    setTimeout(function() {
        $('#dispmsg').fadeOut('slow');
    }, 4000);

    // Scanner AJAX Logic
    $('#btn-scan').click(function() {
        var $btn = $(this);
        var originalHtml = $btn.html();
        
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Scanning File System...');
        
        $.ajax({
            url: '<?php echo BASE_URL; ?>module/scan',
            type: 'POST',
            dataType: 'json',
            success: function(res) {
                if (res.status === 'success') {
                    $('#message_container').html('<div class="ml-alert-1-success"><span class="style-1-icon success"></span>' + res.message + '</div>');
                    // Reload grid to show new data
                    setTimeout(function() { window.location.reload(); }, 2000);
                } else {
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + res.message + '</div>');
                }
                $btn.prop('disabled', false).html(originalHtml);
            },
            error: function() {
                $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server Error during scan.</div>');
                $btn.prop('disabled', false).html(originalHtml);
            }
        });
    });
});
</script>