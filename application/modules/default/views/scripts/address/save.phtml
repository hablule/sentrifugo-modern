<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();

        // --- SSOT v6.6 CASCADING DROPDOWNS ---
        $('#country_id').change(function() {
            var countryId = $(this).val();
            $('#state_id, #city_id, #postal_code_id').html('<option value="">Loading...</option>'); // Reset children

            if (countryId) {
                $.ajax({
                    url: base_url + '/address/getstatesbycountry',
                    type: 'POST',
                    data: {
                        country_id: countryId
                    },
                    dataType: 'json',
                    success: function(response) {
                        var options = '<option value="">Select State / Province</option>';
                        if (response && !$.isEmptyObject(response)) {
                            $.each(response, function(key, value) {
                                options += '<option value="' + key + '">' + value + '</option>';
                            });
                        }
                        $('#state_id').html(options);
                        $('#city_id, #postal_code_id').html('<option value="">Select State First</option>');
                    }
                });
            } else {
                $('#state_id, #city_id, #postal_code_id').html('<option value="">Select Country First</option>');
            }
        });

        $('#state_id').change(function() {
            var stateId = $(this).val();
            $('#city_id, #postal_code_id').html('<option value="">Loading...</option>');

            if (stateId) {
                $.ajax({
                    url: base_url + '/address/getcitiesbystate',
                    type: 'POST',
                    data: {
                        state_id: stateId
                    },
                    dataType: 'json',
                    success: function(response) {
                        var options = '<option value="">Select City</option>';
                        if (response && !$.isEmptyObject(response)) {
                            $.each(response, function(key, value) {
                                options += '<option value="' + key + '">' + value + '</option>';
                            });
                        }
                        $('#city_id').html(options);
                        $('#postal_code_id').html('<option value="">Select City First</option>');
                    }
                });
            } else {
                $('#city_id, #postal_code_id').html('<option value="">Select State First</option>');
            }
        });

        $('#city_id').change(function() {
            var cityId = $(this).val();
            $('#postal_code_id').html('<option value="">Loading...</option>');

            if (cityId) {
                $.ajax({
                    url: base_url + '/address/getpostalcodesbycity',
                    type: 'POST',
                    data: {
                        city_id: cityId
                    },
                    dataType: 'json',
                    success: function(response) {
                        var options = '<option value="">Select Postal / ZIP Code</option>';
                        if (response && !$.isEmptyObject(response)) {
                            $.each(response, function(key, value) {
                                options += '<option value="' + key + '">' + value + '</option>';
                            });
                        }
                        $('#postal_code_id').html(options);
                    }
                });
            } else {
                $('#postal_code_id').html('<option value="">Select City First</option>');
            }
        });
        // --- END CASCADING ---

        // SSOT v6.6 Explicit AJAX Submit Handler
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();

            if (!$form.valid()) {
                return false;
            }

            if (typeof $.blockUI === "function") $.blockUI({
                message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />'
            });

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/address/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/address';
                    } else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else if (response && typeof response === 'object') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Please fix the highlighted errors.</div>');
                        $.each(response, function(fieldId, errorObj) {
                            var errMsg = (typeof errorObj === 'object') ? errorObj[Object.keys(errorObj)[0]] : errorObj;
                            $('#errors-' + fieldId).text(errMsg);
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                }
            });
        });
    });
</script>