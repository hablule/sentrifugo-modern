<!-- 4. JavaScript Logic -->
<script type="text/javascript">
	$(document).ready(function() {
		// Initialize Materialize Dropdowns
		$('.dropdown-button').dropdown({
			constrain_width: false,
			belowOrigin: true
		});

		// Auto-fade flash messages
		setTimeout(function() {
			$('#dispmsguser').fadeOut('slow');
		}, 4000);
	});

	// Toggle View Preference
	function toggleView(type) {
		window.location.href = base_url + '/user/index/view_type/' + type;
	}

	// Card View Search
	function userSearch() {
		var s_val = $('#search_val').val();
		var s_str = $('#search_str').val();
		var v_type = '<?php echo $viewType; ?>';

		window.location.href = base_url + '/user/index/view_type/' + v_type + '/search_val/' + s_val + '/search_str/' + s_str;
	}

	// Load More Cards (AJAX)
	function viewMore() {
		var limit = $('#limit').val();
		var offset = $('#offset').val();
		var count_rem = $('#count_remaining').val();
		var s_val = '<?php echo $this->search_val; ?>';
		var s_str = '<?php echo $this->search_str; ?>';

		var $btn = $('#viewmorediv');
		var originalHtml = $btn.html();
		$btn.html('<i class="fa fa-spinner fa-spin"></i> Loading...').attr('onclick', '');

		$.ajax({
			url: base_url + '/user/getmoreusers', // Ensure this action exists in controller
			type: 'POST',
			data: {
				limit: limit,
				offset: offset,
				count_remaining: count_rem,
				search_val: s_val,
				search_str: s_str,
				view_type: 'card',
				call: 'ajaxcall'
			},
			success: function(data) {
				$('#more_users').append(data);

				// Update State
				var newOffset = parseInt(offset) + parseInt(limit);
				var itemsAdded = $(data).filter('.list-item').length; // Approx check
				// Better approach: Controller should return exact count, but logic here assumes full batch
				var newRemaining = count_rem - itemsAdded; // Simple decrement logic

				$('#offset').val(newOffset);
				$('#count_remaining').val(newRemaining);
				$('#remaining_text').text(newRemaining);

				if (newRemaining <= 0) {
					$btn.hide();
				} else {
					$btn.html(originalHtml).attr('onclick', 'viewMore();');
					$('#remaining_text').text(newRemaining);
				}

				// Re-init dropdowns
				$('.dropdown-button').dropdown({
					constrain_width: false,
					belowOrigin: true
				});
			},
			error: function() {
				$btn.html('Error loading. Click to retry.').attr('onclick', 'viewMore();');
			}
		});
	}
</script>

