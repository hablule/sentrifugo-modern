?>

<?php $baseUrl = $this->serverUrl() . $this->baseUrl(); ?>

<?php foreach ($this->users as $user) :
					// Profile Image Logic
					$profileImg = $user['profileimg'] ? $baseUrl . '/public/uploads/profile/' . $user['profileimg'] : MEDIA_PATH . 'images/profile_pic.png';
				?>
					<div class="list-item">
						<div class="li-head">
							<div class="li-avatar">
								<img src="<?php echo $profileImg; ?>" onerror="this.src='<?php echo MEDIA_PATH; ?>images/profile_pic.png'" width="54" height="54" />
							</div>
							<div class="li-emp-details">
								<span class="emp-name"><?php echo $this->escape($user['userfullname'] ? $user['userfullname'] : 'N/A'); ?></span>
								<span class="emp-designation"><?php echo $this->escape($user['username']); ?></span>
							</div>

							<!-- Card Actions -->
							<div class="li-actions">
								<a class='dropdown-button dottedbtn' href='#' data-activates='actdbtn-<?php echo $user['id']; ?>'>
									<i class="fa fa-ellipsis-v"></i>
								</a>
								<ul id='actdbtn-<?php echo $user['id']; ?>' class='dropdown-content'>
									<li><a href="<?php echo BASE_URL . 'user/view/id/' . $user['id']; ?>"><i class="fa fa-eye"></i> View</a></li>
									<?php if (sapp_Global::_checkprivileges(USERMANAGEMENT, $this->loginuserGroup, $this->loginuserRole, 'edit') == 'Yes') : ?>
										<li><a href="<?php echo BASE_URL . 'user/edit/id/' . $user['id']; ?>"><i class="fa fa-edit"></i> Edit</a></li>
									<?php endif; ?>
								</ul>
							</div>
						</div>
						<div class="li-body">
							<ul>
								<li><i class="fa fa-envelope"></i> <?php echo $this->escape($user['emailaddress']); ?></li>
								<li>
									<i class="fa fa-info-circle" aria-hidden="true"></i>
									 <span>Status: <?php echo ($user['isactive'] == '1') ? 'Active' : 'Inactive'; ?></span>
								</li>
							</ul>
						</div>
					</div>
				<?php endforeach; ?>