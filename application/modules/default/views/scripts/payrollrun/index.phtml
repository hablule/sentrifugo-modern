    </div>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#modal_sync_calendar').dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                title: "Sync Payroll Calendar"
            });
            $('#modal_metric_results').dialog({
                autoOpen: false,
                width: 500,
                modal: true,
                title: "Execution Summary"
            });
            $('.datepicker').datepicker({
                dateFormat: '<?php echo DATEFORMAT_JS; ?>',
                changeMonth: true,
                changeYear: true
            });
        });

        function executeSync() {
            var pgId = $('#sync_pay_group_id').val();
            var start = $('#sync_start_date').val();
            var end = $('#sync_end_date').val();

            if (!pgId || !start || !end) {
                alert("Please fill all required fields.");
                return;
            }

            if (typeof $.blockUI === "function") $.blockUI({
                message: 'Synchronizing Calendar...'
            });

            $.ajax({
                url: base_url + '/payrollrun/sync/format/json',
                type: 'POST',
                data: {
                    pay_group_id: pgId,
                    start_date: start,
                    end_date: end
                },
                dataType: 'json',
                success: function(res) {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    if (res.status === 'success') {
                        $('#modal_sync_calendar').dialog('close');
                        $('#metric_created').text(res.metrics.created);
                        $('#metric_updated').text(res.metrics.updated);
                        $('#metric_untouched').text(res.metrics.untouched);
                        $('#metric_locked').text(res.metrics.locked);

                        var logHtml = '';
                        $.each(res.metrics.details, function(i, msg) {
                            logHtml += '<div>• ' + msg + '</div>';
                        });
                        $('#metric_log_details').html(logHtml || 'No changes required. All dates aligned.');

                        $('#modal_metric_results').dialog('open');
                    } else {
                        alert(res.message || "Error running sync.");
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    alert("Server error occurred during sync.");
                }
            });
        }
    </script>
<?php endif; ?>

