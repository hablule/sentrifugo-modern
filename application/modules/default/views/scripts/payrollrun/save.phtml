<script type="text/javascript">
    $(document).ready(function() {
        $('#description').jqte();

        // Linked Datepickers Logic
        $('#cycle_start_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                if (selectedDate !== '') {
                    $("#cycle_end_date").datepicker("option", "minDate", selectedDate);
                }
            }
        });

        $('#cycle_end_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true,
            onClose: function(selectedDate) {
                $(this).trigger('blur');
                if (selectedDate !== '') {
                    $("#cycle_start_date").datepicker("option", "maxDate", selectedDate);
                    $("#pay_date").datepicker("option", "minDate", selectedDate);
                }
            }
        });

        $('#pay_date').datepicker({
            showOn: 'both',
            dateFormat: '<?php echo DATEFORMAT_JS; ?>',
            buttonImage: "<?php echo MEDIA_PATH; ?>images/cal.jpg",
            buttonImageOnly: true,
            changeMonth: true,
            changeYear: true
        });

        // Explicit AJAX Form Submission per SSOT VII.10
        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();

            var $form = $('#formid');
            $('.errors').text('');
            $('#message_container').empty();

            if (!$form.valid()) {
                return false;
            }

            if (typeof $.blockUI === "function") {
                $.blockUI({
                    message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Saving..." />'
                });
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/payrollrun/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (typeof $.unblockUI === "function") $.unblockUI();

                    if (response && response.result === 'saved') {
                        window.location.href = base_url + '/payrollrun';
                    } else if (response && response.result === 'exception') {
                        $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>' + response.message + '</div>');
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    } else if (response && typeof response === 'object') {
                        $.each(response, function(fieldId, errorMsg) {
                            $('#errors-' + fieldId).text(errorMsg);
                        });
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    if (typeof $.unblockUI === "function") $.unblockUI();
                    $('#message_container').html('<div class="ml-alert-1-error"><span class="style-1-icon error"></span>Server error occurred.</div>');
                }
            });
        });
    });
</script>