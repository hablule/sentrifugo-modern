        <script type="text/javascript">
            var popupIndexesData = <?php echo $childIndexesJson; ?>;

            function escapePopupHtml(text) {
                return $('<div>').text(String(text || '')).html();
            }

            function renderPopupIndexes() {
                var tbody = $('#popup_indexes_tbody');
                tbody.empty();
                if (popupIndexesData.length === 0) {
                    tbody.append('<tr><td colspan="3" style="text-align:center; color:#999; padding:8px;">No index values added.</td></tr>');
                } else {
                    $.each(popupIndexesData, function(i, item) {
                        item.sort_order = i + 1;
                        tbody.append(
                            '<tr><td style="text-align:center;">' + (i + 1) + '</td>' +
                            '<td>' + escapePopupHtml(item.value) + '</td>' +
                            '<td style="text-align:center;"><a href="javascript:void(0);" onclick="removePopupIndexRow(' + i + ');" style="color:#e74c3c;"><i class="fa fa-trash"></i></a></td></tr>'
                        );
                    });
                }
                $('#indexes_payload').val(JSON.stringify(popupIndexesData));
            }

            function addPopupIndexRow() {
                var val = $.trim($('#popup_tmp_value').val());
                if (val === '') {
                    alert('Please enter an index value.');
                    return;
                }
                for (var i = 0; i < popupIndexesData.length; i++) {
                    if (popupIndexesData[i].value.toLowerCase() === val.toLowerCase()) {
                        alert('This index value already exists.');
                        return;
                    }
                }
                popupIndexesData.push({
                    id: '',
                    sort_order: popupIndexesData.length + 1,
                    value: val,
                    description: ''
                });
                $('#popup_tmp_value').val('');
                renderPopupIndexes();
            }

            function removePopupIndexRow(index) {
                popupIndexesData.splice(index, 1);
                renderPopupIndexes();
            }

            $(document).ready(function() {
                $('#description').jqte();
                $('#value_type').change(function() {
                    if ($(this).val() === 'LIST') {
                        $('#popup_indexes_section').slideDown();
                        renderPopupIndexes();
                    } else {
                        $('#popup_indexes_section').slideUp();
                        $('#indexes_payload').val('[]');
                    }
                }).trigger('change');

                $('#formid').on('submit', function() {
                    if ($('#value_type').val() === 'LIST') {
                        $('#indexes_payload').val(JSON.stringify(popupIndexesData));
                    } else {
                        $('#indexes_payload').val('[]');
                    }
                });
            });
        </script>
