<script type="text/javascript">
    var indexesData = <?php echo $childIndexesJson; ?>;
    var editingIndex = -1;

    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return $('<div>').text(String(text)).html();
    }

    $(document).ready(function() {
        $('#description').jqte();
        if ($.isFunction($.fn.select2)) {
            $('select').select2({
                width: '100%'
            });
        }

        $('#value_type').change(function() {
            if ($(this).val() === 'LIST') {
                $('#indexes_section').slideDown();
                renderIndexesTable();
            } else {
                $('#indexes_section').slideUp();
            }
        }).trigger('change');

        $('#submitbutton').off('click').on('click', function(e) {
            e.preventDefault();
            var $form = $('#formid');

            if ($.isFunction($form.valid) && !$form.valid()) {
                return false;
            }
            $('#message_container').empty();
            $form.find('.errors').text('');

            if ($('#value_type').val() === 'LIST') {
                if (indexesData.length === 0) {
                    var errorHtml = '<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>List measurements require at least one Index Value.</div></div>';
                    $('#message_container').html(errorHtml);
                    $('html, body').animate({
                        scrollTop: 0
                    }, 'slow');
                    return false;
                }
                if (editingIndex > -1 || ($.trim($('#tmp_value').val()) !== '')) {
                    if (!confirm('You have unsaved changes in the Index input fields. Save anyway?')) {
                        return false;
                    }
                }
                $('#indexes_payload').val(JSON.stringify(indexesData));
            } else {
                $('#indexes_payload').val('[]');
            }

            var formData = new FormData($form[0]);

            $.ajax({
                url: base_url + '/measurement/save/format/json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                global: false,
                beforeSend: function() {
                    if ($.isFunction($.blockUI)) {
                        $.blockUI({
                            width: '50px',
                            message: '<img src="<?php echo MEDIA_PATH; ?>images/loader2.gif" alt="Loading" />'
                        });
                    }
                },
                complete: function() {
                    if ($.isFunction($.unblockUI)) {
                        $.unblockUI();
                    }
                },
                success: function(response) {
                    if (response.result === 'saved') {
                        window.location.href = base_url + '/measurement';
                    } else {
                        var mainError = response.result === 'exception' ? response.message : 'Please fix the highlighted errors.';
                        $('#message_container').html('<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>' + escapeHtml(mainError) + '</div></div>');

                        if (typeof response === 'object' && response.result !== 'exception') {
                            $.each(response, function(fieldId, errorMsg) {
                                var msgText = (typeof errorMsg === 'object' && errorMsg !== null) ?
                                    Object.values(errorMsg)[0] :
                                    errorMsg;
                                var $errTarget = $('#errors-' + fieldId);
                                if ($errTarget.length) {
                                    $errTarget.text(msgText);
                                } else {
                                    var $element = $('#' + fieldId).parent().parent();
                                    if ($element.length) {
                                        $element.append('<span class="errors" id="errors-' + fieldId + '">' + escapeHtml(msgText) + '</span>');
                                    }
                                }
                            });
                        }
                        $('html, body').animate({
                            scrollTop: 0
                        }, 'slow');
                    }
                },
                error: function() {
                    $('#message_container').html('<div class="ml-alert-1-error"><div style="display:block;"><span class="style-1-icon error"></span>Server communication error.</div></div>');
                }
            });
        });
    });

    function renderIndexesTable() {
        var tbody = $('#indexes_tbody');
        tbody.empty();

        if (indexesData.length === 0) {
            tbody.append('<tr><td colspan="4" style="text-align:center; padding: 15px; color:#999; font-style:italic;">No index values added yet.</td></tr>');
            $('#tmp_sort_order').val(1);
            return;
        }

        indexesData.sort(function(a, b) {
            return (parseInt(a.sort_order, 10) || 0) - (parseInt(b.sort_order, 10) || 0);
        });

        $.each(indexesData, function(index, item) {
            var actionHtml = '<a href="javascript:void(0);" onclick="editIndexRow(' + index + ');" style="color:#3498db; margin-right: 10px;" title="Edit"><i class="fa fa-edit"></i></a>' +
                '<a href="javascript:void(0);" onclick="removeIndexRow(' + index + ');" style="color:#e74c3c;" title="Delete"><i class="fa fa-trash"></i></a>';
            var rowStyle = (index === editingIndex) ? 'background-color: #fffacd;' : '';

            var tr = '<tr style="border-bottom: 1px solid #eee; ' + rowStyle + '">' +
                '<td style="text-align:center; font-weight:bold;">' + escapeHtml(item.sort_order) + '</td>' +
                '<td>' + escapeHtml(item.value) + '</td>' +
                '<td>' + (item.description ? escapeHtml(item.description) : '-') + '</td>' +
                '<td style="text-align:center;">' + actionHtml + '</td>' +
                '</tr>';
            tbody.append(tr);
        });

        if (editingIndex === -1) {
            $('#tmp_sort_order').val(indexesData.length + 1);
        }
    }

    function addIndexRow() {
        var sortOrder = parseInt($('#tmp_sort_order').val(), 10);
        var val = $.trim($('#tmp_value').val());
        var desc = $.trim($('#tmp_desc').val());

        if (val === '') {
            alert('Index Value is required.');
            return;
        }
        if (isNaN(sortOrder) || sortOrder < 1) {
            sortOrder = indexesData.length + 1;
        }

        var isDup = false;
        $.each(indexesData, function(index, item) {
            if (index !== editingIndex && String(item.value).toLowerCase() === val.toLowerCase()) {
                isDup = true;
            }
        });
        if (isDup) {
            alert('This Index Value already exists in the list.');
            return;
        }

        if (editingIndex > -1) {
            var existingId = indexesData[editingIndex].id || '';
            indexesData[editingIndex] = {
                id: existingId,
                sort_order: sortOrder,
                value: val,
                description: desc
            };
            editingIndex = -1;
            $('#add_idx_btn').html('<i class="fa fa-plus"></i> Add');
        } else {
            indexesData.push({
                id: '',
                sort_order: sortOrder,
                value: val,
                description: desc
            });
        }

        $('#tmp_value, #tmp_desc').val('');
        renderIndexesTable();
    }

    function editIndexRow(index) {
        var item = indexesData[index];
        editingIndex = index;

        $('#tmp_sort_order').val(item.sort_order);
        $('#tmp_value').val(item.value);
        $('#tmp_desc').val(item.description || '');
        $('#add_idx_btn').html('<i class="fa fa-save"></i> Update');

        renderIndexesTable();
    }

    function removeIndexRow(index) {
        if (confirm('Are you sure you want to remove this index value?')) {
            indexesData.splice(index, 1);
            if (editingIndex === index) {
                $('#tmp_value, #tmp_desc').val('');
                $('#add_idx_btn').html('<i class="fa fa-plus"></i> Add');
                editingIndex = -1;
            } else if (editingIndex > index) {
                editingIndex--;
            }
            renderIndexesTable();
        }
    }
</script>