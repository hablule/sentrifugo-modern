<?php
/**
 * Marital Status Add Popup View
 * 
 * Runs inside an iframe modal. On success, updates parent DOM via global JS.
 * Strictly adheres to SSOT v6.0.2.
 * 
 * @category   Application
 * @package    Default
 * @subpackage Views
 */

// SSOT IX: Safe Initialization for PHP 8+
$this->msgarray = isset($this->msgarray) ? $this->msgarray : array();

// SSOT VII: Client Validation Generation
sapp_Global::generateClientValidations($this->form);
?>
<!-- Essential Popup CSS and Editor JS (No screen.css to protect checkbox styling) -->
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/custompopup.css" />
<link rel="stylesheet" type="text/css" href="<?php echo MEDIA_PATH; ?>css/jquery-te.css" />
<script type="text/javascript" src="<?php echo MEDIA_PATH; ?>js/jquery-te.min.js"></script>

<div style="padding: 15px;">
    <?php if (isset($this->popup) && $this->popup == 'close') : ?>
        <!-- Success State: Render message and trigger parent window refresh -->
        <div class="ml-alert-1-success">
            <div style="display:block;">
                <span class="style-1-icon success"></span>
                Marital Status <?php echo $this->escape($this->eventact); ?> successfully.
            </div>
        </div>
        
        <script type="text/javascript">
            $(document).ready(function() {
                setTimeout(function() {
                    // Update parent dropdown and close iframe modal
                    // Ensure 'maritalstatusid' matches the select element ID in your parent form!
                    parent.closeiframeAddPopup('<?php echo $this->optionsHtml; ?>', 'maritalstatus', 'maritalstatusid', 'Marital Status');
                }, 1500);
            });
        </script>

    <?php else : ?>
        <!-- Form State -->
        <div id="error_message" style="display:none;"></div>
        
        <?php if (!empty($this->msgarray['error'])) : ?>
            <div class="ml-alert-1-error">
                <div style="display:block;">
                    <span class="style-1-icon error"></span>
                    <?php echo $this->escape($this->msgarray['error']); ?>
                </div>
            </div>
        <?php endif; ?>

        <form name="<?php echo $this->escape($this->form->getName()); ?>" id="<?php echo $this->escape($this->form->getId()); ?>" action="<?php echo $this->escape($this->form->getAction()); ?>" method="<?php echo $this->escape($this->form->getMethod()); ?>">
            <?php echo $this->form->id; ?>
            
            <div class="total-form-controller" style="box-shadow: none; border: none; padding: 0;">
                <div class="division">
                    
                    <!-- Marital Status Name -->
                    <div class="new-form-ui clearb">
                        <label class="required"><?php echo $this->escape($this->form->name->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->name; ?>
                        </div>
                        <span class="errors" id="errors-<?php echo $this->escape($this->form->name->getId()); ?>"><?php echo $this->escape($this->msgarray['name'] ?? ''); ?></span>
                    </div>
                    
                    <!-- Marital Status Code -->
                    <div class="new-form-ui clearb">
                        <label class="required"><?php echo $this->escape($this->form->code->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->code; ?>
                        </div>
                        <span class="errors" id="errors-<?php echo $this->escape($this->form->code->getId()); ?>"><?php echo $this->escape($this->msgarray['code'] ?? ''); ?></span>
                    </div>

                    <!-- Description -->
                    <?php echo sapp_Helper::sd_form_helper($this->msgarray, $this->form, 'description', '', 'fck_editor_height', '', array()); ?>

                    <!-- Active Status -->
                    <div class="new-form-ui clearb">
                        <label><?php echo $this->escape($this->form->isactive->getLabel()); ?></label>
                        <div class="division">
                            <?php echo $this->form->isactive; ?>
                        </div>
                        <span class="errors" id="errors-<?php echo $this->escape($this->form->isactive->getId()); ?>"><?php echo $this->escape($this->msgarray['isactive'] ?? ''); ?></span>
                    </div>

                    <!-- Submit & Cancel -->
                    <div class="new-form-ui-submit" style="margin-top: 15px;">
                        <div class="division">
                            <input type="submit" name="submit" id="submitbutton" value="Save" class="actbtn_btn" />
                            <button type="button" class="reset" onclick="parent.closeiframepopup('maritalstatus', 'cancel');">Cancel</button>
                        </div>
                    </div>

                </div>
            </div>
        </form>
        
        <script type="text/javascript">
            $(document).ready(function() {
                if ($('#description').length) {
                    $('#description').jqte();
                }
            });
        </script>
    <?php endif; ?>
</div>