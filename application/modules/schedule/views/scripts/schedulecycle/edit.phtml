	<script>
		$('#description').jqte();
		if('<?php echo $this->id;?>')
		{
		
		var data = JSON.parse('<?php echo json_encode($this->data) ?>');
		var dayof = '';
		var id = $("#schedule_id").val()
		console.log(data[0]['dayofweek'])
		if (data[0]['dayofweek'] != null) {
			$('#dayofweek').parent().parent().show();
			dayof = 'dayofweek';
		} else if (data[0]['dayofmonth'] != null) {
			$('#dayofmonth').parent().parent().show();
			dayof = 'dayofmonth';
		} else {
			$('#dayily').parent().parent().show();
			dayof = 'daily';
		}
		$(document).ready(() => {
			
			var res = $.ajax({
				url: base_url + '/empschedule/getschedules',
				data: 'ids=' + id,
				dataType: "json",
				async: false
			}).responseJSON;
			console.log('<?php echo $this->id; ?>');
			if (res.length != 0) {
				console.log(res);
			}
			
		})
	
	}
	else
	{

	}
		function checkweekday()
		{
			
			let schedule_id = $("#schedule_id").val()
			let dayof = getActiveElement();
			console.log(dayof);
			let cycle = $("#"+dayof).val()
			var res = $.ajax({
				url: base_url + '/schedulecycle/dayofexists',
				data: 'cycleid=' + schedule_id +'&cycle='+cycle+'&dayof='+dayof,
				dataType: "json",
				async: false
			}).responseJSON;
			console.log(res+'res');
			if(!res)
			{
				$("#"+dayof).parent().parent().append("<span class='errors' id='errors-"+dayof+"'>Data already exists</span>");
			}
			else{
				$("#errors-"+dayof).parent().parent().find('span').html('');
			}
		}

		function getActiveElement()
		{
			if($('#dayofweek').val()!='')
				return "dayofweek";
			else if($("#dayofmonth").val()!='')
				return "dayofmonth";
			else
				return "dayily";
		}
	</script>