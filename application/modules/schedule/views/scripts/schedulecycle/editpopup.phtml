    function getCycleId(id) {
        var res = $.ajax({
            url: base_url + '/schedulecycle/getcycledata',
            dataType: 'json',
            data: 'id=' + id,
            async: false
        }).responseJSON;

        return res;
    }

    function getShiftCycle(res, chooseElement) {
        let shift = []
        let shifts = []
        res.forEach(element => {
            shift = [];
            if (shifts[element[chooseElement]] == undefined) {
                shift['shift_id'] = [element['shift_id']];
                shifts[element[chooseElement]] = shift;
            } else {
                shifts[element[chooseElement]]['shift_id'].push(element['shift_id'])
            }
            console.log(shifts[element[chooseElement]]['shift_id'])

        });
        console.log(shifts)
    }

    function removeSchedule(event) {
        event.preventDefault();

        let res = localStorage.getItem('schedule');
        res = JSON.parse(res);
    
        const index = $(event.target).parent().parent().attr('id')
        let removed = res.splice(index, 1);
        localStorage.setItem('schedule', JSON.stringify(res));
        $("textarea[name=cycleshiftdata]").val(JSON.stringify(res));
        console.log(res);
        $(event.target).parent().parent().remove();
        let cutedOption = $("#" + choosenElement).find("option");
        let match = originalOption[removed[0][choosenElement]];
        if (cutedOption.length == 1)
            $("#" + choosenElement).append("<option id=" + match + " value=" + removed[0][choosenElement] + ">" + removed[0][choosenElement] + "</option>");
        for (var i = 1; i < cutedOption.length; i++) {
            console.log($(cutedOption[i]).attr("id"), "me")
            if ($(cutedOption[i]).attr("id") < match) {
                if ($(cutedOption[i + 1]).attr("id") < match)
                    continue;
                $(cutedOption[i]).after("<option id=" + match + " value=" + removed[0][choosenElement] + ">" + removed[0][choosenElement] + "</option>")
                return;
            } else if ($(cutedOption[i]).attr("id") > match) {
                $(cutedOption[i]).before("<option id=" + match + " value=" + removed[0][choosenElement] + ">" + removed[0][choosenElement] + "</option>")
                return;
            }

        }
    }


    function drawTable(weekschedule, choosenElement) {
        let tableOpen = '<table id="schtable" style="width: 100%; border: 1px black solid"></table>';
        let daysche;
        let daydata;
        let shiftcycle;
        let len = 0;
        $("#schedule").html('');
        $("#schedule").append(tableOpen);
        for (const day in weekschedule) {
            daysche = weekschedule[day];
            daydata = daysche[choosenElement];
            shiftcycle = daysche['cycleshiftdata'];
            $('#schtable').append("<tr id='" + daydata + "'></tr>");
            len = shiftcycle.length;
            $('#' + daydata).append("<th  rowspan='" + len + "'>" + daydata + "</th>");
            let clone = JSON.stringify(shiftcycle);
            clone = JSON.parse(clone);
            $("#" + daydata).append("<td>" + clone.shift()['shift_id'] + "</td>")
            for (const cycle in clone) {
                $("#schtable").append("<tr id=" + daydata + "_" + clone[cycle]['shift_id'] + "></tr>");
                $("#" + daydata + "_" + clone[cycle]['shift_id']).append("<td>" + clone[cycle]['shift_id'] + "</td>")
            }
        }

    }

    function createLink(res) {
        $("#editlink").html('');
        let unsortedRes = res;
        unsortedRes = unsortedRes.sort();
        for (const key in unsortedRes) {
            const element = unsortedRes[key]
            console.log(key, 'keys');
            $("#editlink").append("<div id=" + key + "><span class='add-coloum' id=" + element['schedulecycle_id'] + ">" + element['cycle'] + "</span><span><i class='fa fa-pencil'></i></span>" + (element["cycle"] != 'ANYDAY' ? "<span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span>" : "") + "</div>");
            $("#" + element['schedulecycle_id']).parent().find('.fa-pencil').click((e) => {
                if (element['schedulecycle_id'] != undefined)
                    displaydeptform('<?php echo BASE_URL . 'cycleshift/editpopup?id=' ?>' + element['schedulecycle_id'], 'Cycle Shift');
                else
                    displaydeptform('<?php echo BASE_URL . 'cycleshift/addpopup?shift=' ?>' + JSON.stringify(element['cycleshiftdata']), 'Cycle Shift');
            })
        }
    }
</script>