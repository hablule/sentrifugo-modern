<script>
	$('#description').jqte();
	var originalOption = {};
	var choosenElement;
	let weekshcdule = {};
	$('document').ready(() => {
		setTimeout(() => {
			$("#" + choosenElement).parent().parent().find("#errors-" + choosenElement).remove();
			$("#" + choosenElement).parent().parent().remove("#errors-" + choosenElement);
		}, 3000);
		console.log(`<?php echo $this->id; ?>`)
		if (`<?php echo $this->id; ?>` != 0) {
			id = `<?php echo $this->id; ?>`;
			localStorage.setItem('cycle', id);
		} else {
			id = localStorage.getItem('cycle');
		}
		$("#cycleshiftdata").html(' ');
		choosenElement = chooseOne("daily", "dayofweek", "dayofmonth", id);

		<?php if ($this->pop == 'close') { ?>

			closeiframeAddPopup('<?php echo $this->cycledata; ?>', '<?php echo $this->controllername; ?>', 'test2', 'Shift');

		<?php } ?>

		<?php

		?>

		$("#" + choosenElement).prop("required", true);
		if ($("#" + choosenElement).val() == '') {
			$("#" + choosenElement).parent().find('.add-coloum').hide();

		}
		$("#" + choosenElement).change(() => {
			if ($("#" + choosenElement).val() != '') {
				$("#" + choosenElement).parent().find('.add-coloum').show();

			} else {
				$("#" + choosenElement).parent().find('.add-coloum').hide();
			}
		})
		let option = $("#" + choosenElement).find("option")
		console.log(option)
		for (var i = 1; i < option.length; i++) {
			$(option[i]).attr("id", i);
			originalOption[$(option[i]).html()] = i
		}
		$("." + choosenElement).click(() => {
			let chosenData = $("#" + choosenElement).val();
			let cycleShiftData = $('#cycleshiftdata').html();

			//	$('cycleshiftdata').html('x');
			let desc = $('#description').val();
			let isactive = $("#isactive").val();
			console.log('here')
			$("#" + choosenElement).parent().parent().find('#errors-' + choosenElement).remove();
			if (chosenData != '') {
				console.log(chosenData);
				let dayschedule = {};
				if ($('#cycleshiftdata').html() != ' ') {
					try {
						$("option[value=" + chosenData + "]").remove();
						$(".select2-choice").find('span').html(" ");
						$("#" + choosenElement).val(' ');
						let prevSchedule = localStorage.getItem("schedule");
						cycleShiftData = JSON.parse(cycleShiftData);
						if (prevSchedule != null || prevSchedule != "")
							res = JSON.parse(prevSchedule)
						dayschedule[choosenElement] = chosenData;
						dayschedule['description'] = desc;
						dayschedule['isactive'] = isactive;
						dayschedule['cycleshiftdata'] = cycleShiftData;
						weekshcdule[chosenData] = dayschedule;
						//$("textarea[name='cycleshift']").val(JSON.stringify(cycleShiftData));

						localStorage.setItem('schedule', JSON.stringify(weekshcdule))
						$("textarea[name='cycleshiftdata']").val(JSON.stringify(weekshcdule));
						//drawTable(weekshcdule, choosenElement)
						createLink(weekshcdule)
						$('#cycleshiftdata').html(' ')
					} catch (error) {
						console.log(error);
						$("#" + choosenElement).parent().parent().append("<span class='errors' id='errors-" + choosenElement + "'>Shift cycle not entered </span>")
						setTimeout(() => {
							$("#" + choosenElement).parent().parent().find("#errors-" + choosenElement).remove();
							$("#" + choosenElement).parent().parent().remove("#errors-" + choosenElement);
						}, 3000);
					}
				} else {
					$("#" + choosenElement).parent().parent().append("<span class='errors' id='errors-" + choosenElement + "'>Shift cycle not Entered </span>")
				}

			} else {
				$("#" + choosenElement).parent().parent().append("<span class='errors' id='errors-" + choosenElement + "'>You need to select </span>")
			}

		})
		$("#submit").click((e) => {

		})
	})

	function drawTable(weekschedule, choosenElement) {
		let tableOpen = '<table id="schtable" style="width: 100%; border: 1px black solid"></table>';
		let daysche;
		let daydata;
		let shiftcycle;
		let len = 0;
		$("#schedule").html('');
		$("#schedule").append(tableOpen);
		for (const day in weekschedule) {
			daysche = weekschedule[day];
			daydata = daysche[choosenElement];
			shiftcycle = daysche['cycleshiftdata'];

			$('#schtable').append("<tr id='" + daydata + "'></tr>");
			len = shiftcycle.length;
			$('#' + daydata).append("<th  rowspan='" + len + "'>" + daydata + "</th>");
			let clone = JSON.stringify(shiftcycle);
			clone = JSON.parse(clone);
			const shiftid = clone.shift()['shift_id'];
			var res = $.ajax({
				url: base_url + '/schedule/timetable/getshiftname',
				dataType: 'json',
				data: 'id=' + shiftid,
				async: false
			}).responseJSON;
			$("#" + daydata).append("<td>" + res['name'] + "</td>")

			for (const cycle in clone) {
				var res = $.ajax({
					url: base_url + '/schedule/timetable/getshiftname',
					dataType: 'json',
					data: 'id=' + clone[cycle]['shift_id'],
					async: false
				}).responseJSON;
				console.log(res)
				$("#schtable").append("<tr id=" + daydata + "_" + clone[cycle]['shift_id'] + "></tr>");
				$("#" + daydata + "_" + clone[cycle]['shift_id']).append("<td>" + res['name'] + "</td>")
			}
		}
	}

	function createLink(res) {
		console.log(res, 'this res')
		$("#editlink").html('');
		let addedDays = [];
		let newDay = 0;
		for (const key in res) {
			const element = res[key];
			newDay = originalOption[key];
			addedDays = $("#editlink").find('div');
			if(addedDays.length == 0)
			{
				$("#editlink").append("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
			}
			for (let index = 0; index < addedDays.length; index++) {

				const element = addedDays[index];
				const elementIndex = originalOption[$(element).attr('id')];
				if (newDay > elementIndex) {
					if ((index + 1) != addedDays.length) {
						if (newDay > originalOption[$(addedDays[index + 1]).attr('id')]) {
							console.log('append')
							$(addedDays[index]).append("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
							break;
						}
					}
					else{
						console.log('append')
						$(addedDays[index]).append("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
					}

				} else if (newDay > elementIndex) {
					if ((index + 1) != addedDays.length) {
						if (newDay < originalOption[$(addedDays[index + 1]).attr('id')]) {
							console.log('prepend')
							$(addedDays[index + 1]).prepend("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
							break;
						}
					}
					else
					{
						console.log('prepend')
						$(addedDays[index]).prepend("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
					}
					
				}

			}
			//$("#editlink").append("<div id=" + key + "><span class='add-coloum'>" + key + "</span><span><i class='fa fa-pencil' id=span" + key + "></i></span><span onClick='removeSchedule(event)'><i class='fa fa-times-circle'></i></span></div>");
			$("#span" + key).click((e) => {
				console.log('clicked', key)
				displaydeptform('<?php echo BASE_URL . 'cycleshift/addpopup?shift=' ?>' + JSON.stringify(res[key]['cycleshiftdata']), 'Cycle Shift');
			});
		}

	}

	function removeSchedule(event) {
		event.preventDefault();
		let res = weekshcdule;
		//res = JSON.parse(res);
		const index = $(event.target).parent().parent().attr('id')
		console.log(index, 'look at me');
		delete res[index];

		if (res.length === 0) {
			localStorage.removeItem('schedule');
		} else {
			localStorage.setItem('schedule', JSON.stringify(res));
		}
		$("textarea[name=cycleshiftdata]").val(JSON.stringify(res));
		$(event.target).parent().parent().remove();
		let cutedOption = $("#" + choosenElement).find("option");

		let match = originalOption[index];
		console.log(match, 'matched');
		if (cutedOption.length == 1)
			$("#" + choosenElement).append("<option id=" + match + " value=" + index + ">" + index + "</option>");
		for (var i = 1; i < cutedOption.length; i++) {
			console.log($(cutedOption[i]).attr("id"), "me")
			if ($(cutedOption[i]).attr("id") < match) {
				if ($(cutedOption[i + 1]).attr("id") < match)
					continue;
				$(cutedOption[i]).after("<option id=" + match + " value=" + index + ">" + index + "</option>")
				return;
			} else if ($(cutedOption[i]).attr("id") > match) {
				$(cutedOption[i]).before("<option id=" + match + " value=" + index + ">" + index + "</option>")
				return;
			}


		}
	}
</script>