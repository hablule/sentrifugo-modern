	$('.check2').change(function() {
		if ($(this).prop("checked") == true) {

			var boxs2 = $('.check2:checked');
			var OT_ids;
			for (let index2 = 0; index2 < boxs2.length; index2++) {
				// perk_ids.push(boxs2[index2].value);
				OT_ids = boxs2[index2].value;
			}
			/* var res = $.ajax({
				url: base_url + '/overtime',
				type: 'POST',
				dataType: 'json',
				data: {
					OT_ids: OT_ids
				},
				async: false
			}).responseText; */
			var res = getphpdata('overtime',{OT_ids:OT_ids},false,'POST','json')
			res = JSON.parse(res);
			y = res;
			for (var key in res) {
				for (var key1 in res[key]) {
					x = document.getElementById('emp' + res[key][key1]);
					x.checked = true;
				}
			}
			return false;
		} else if ($(this).prop("checked") == false) {
			console.log("Checkbox is unchecked.");
			for (var key in y) {
				for (var key1 in y[key]) {
					console.log(key);
					x = document.getElementById('emp' + y[key][key1]);
					x.checked = false;
				}
			}
		}
	});

	$('#submit').click(function(ev) {
		var boxs = $('.check1:checked');
		var boxs2 = $('.check2:checked');
		var emp_ids = [];
		var OT_ids = [];
		for (let index = 0; index < boxs.length; index++) {
			emp_ids.push(boxs[index].value);
		}
		for (let index2 = 0; index2 < boxs2.length; index2++) {
			OT_ids.push(boxs2[index2].value);
		}
		if (emp_ids.length == 0 && OT_ids.length == 0) {
			alert('Please Select Overtime and Employees');
			return false;
		}
		if (emp_ids.length == 0) {
			alert('Please Select Employee');
			return false;
		}
		if (OT_ids.length == 0) {
			alert('Please Select Overtime');
			return false
		}
		var res = $.ajax({
			url: base_url + '/overtime/add',
			type: 'POST',
			dataType: 'json',
			data: {
				emp_ids: emp_ids,
				OT_ids: OT_ids
			},
			async: false
		}).responseText;
		var res = getphpdata('overtime/add',{emp_ids:emp_ids,OT_ids:OT_ids},false,'POST','json')
		// console.log(res);
		// return false;
		document.location.reload();
		return false;
	});
</script>