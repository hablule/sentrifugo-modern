<script type="text/javascript">
	$(document).ready(function() {
		let ids = '';
		for (let index = 0; index < $('tr').length; index++)
		{
			const element = $('tr')[index];
			const td = $(element).find('td')[0];

			const link = $(td).find('a');

			let id = $(link[0]).attr('name');

			if (id != undefined)
			{
				if ((index + 1) == $("tr").length)
				{
					ids = ids + id;
				}
				else
				{
					ids = id + ','+ids;
				}
			}
		}

		var res = $.ajax({
			url: base_url +'/schedule/timecategory/isavalible',
			dataType:'json',
			data:'category_id='+ ids,
			async: false
		}).responseJSON;
		console.log(res)

		if(ids != undefined)
		{
			if (res != undefined)
			{
				for (const key in res)
				{
					const categoryId = res[key]['timecategory_id'];
					$("#edit"+categoryId).hide();
					$("#del"+categoryId).hide();

				}
			}
		}
	})

</script>