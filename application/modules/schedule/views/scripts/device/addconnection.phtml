		}
		if(ip_address === '' || port === ''){
			alert('Please enter IP Address and Port');
			return false;
		}
		$.ajax({
			url: `<?php echo DEVICE_API_URL; ?>ConnectDevice/connectViaIP?ipAddress=${ip_address}&port=${port}`,
