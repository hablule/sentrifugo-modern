			function createTime(day) {
				let timediv = '';
				for (let index = 0; index < 24; index++) {
					timediv += '<div id="' + day + '0' + index + '"></div>'
				}
				return timediv;
			}

			function packData(cycle, data) {
				packedData = [];
				shiftData = [];
				const check = {
					'DAILY': 'daily',
					'WEEKLY': 'dayofweek',
					'MONTHLY': 'dayofmonth'
				}
				for (const i of data) {
					packedData[i[check[cycle]]] = [];
				}

				for (const i of data) {
					packedData[i[check[cycle]]].push({
						color: i['lablecolor'],
						name: i['shiftname'],
						starttime: i['starttime'],
						endtime: i['endtime']
					})
				}

				return packedData;

			}
