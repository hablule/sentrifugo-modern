<script>

	$(document).ready(function(){
		let ids = '';
		
		for (let index = 0; index < $('tr').length; index++) {
			const element = $('tr')[index];
			const td = $(element).find('td')[0];
			const link = $(td).find('a');
			let id = $(link[1]).attr('id');
			
			if(id!=undefined)
			{
				ids = id.slice(4)+','+ids;
			}
		}
		if(ids != undefined){
		ids = ids.slice(0,ids.length-1);
		var res = $.ajax({
			url:base_url+'/schedule/timeschedule/getschedules',
			data:'ids='+ids,
			dataType:"json",
			async:false
		}).responseJSON;
		if(res!=undefined)
		{
			for (const key in res) {
				const scheduleId = res[key]['schedule_id'];
				$("#edit"+scheduleId).hide();
				$("#del"+scheduleId).hide();
			}
		}}
	})
</script>